+// The global wait lock protects node_ through invalidation and every wake.
+// Keeping the handle alive does not keep the isolate or its futex node alive.
+class AtomicsWaitWakeHandleImpl final : public v8::AtomicsWaitWakeHandle {
+ public:
+  explicit AtomicsWaitWakeHandleImpl(FutexWaitListNode* node) : node_(node) {}
+  void WakeUp() override {
+    NoGarbageCollectionMutexGuard lock_guard(GetWaitList()->mutex());
+    if (node_) node_->cond_.NotifyOne();
+  }
+  void Invalidate() { node_ = nullptr; }  // Under the global wait lock.
+ private:
+  FutexWaitListNode* node_;
+};
+
+base::TimeTicks FutexWaitListNode::WaitNow() const {
+  return observer_ ? base::TimeTicks::FromInternalValue(observer_->NowMicroseconds())
+                   : base::TimeTicks::Now();
+}
+
+// Called under the wait-list lock, before a notification claims this node.
+// A controlled deadline is already expired at its logical instant, even if
+// the waiting thread has not yet acquired the lock to observe that instant.
+// Wake it to finish the timeout without consuming a notification count.
+bool FutexWaitListNode::WakeIfControlledWaitExpired() {
+  if (!observer_ || !observer_has_deadline_ || WaitNow() < observer_deadline_) {
+    return false;
+  }
+  NotifyObserver();
+  cond_.NotifyOne();
+  return true;
+}
+
+void FutexWaitListNode::NotifyObserver() {
+  if (observer_waiting_) {
+    observer_waiting_ = false;
+    observer_->OnWake();
+  }
+}
