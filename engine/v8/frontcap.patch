+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef INCLUDE_V8_ATOMICS_WAIT_H_
+#define INCLUDE_V8_ATOMICS_WAIT_H_
+
+#include <cstdint>
+#include <memory>
+#include "v8config.h"
+
+namespace v8 {
+class Isolate;
+
+// Embedder-controlled synchronous atomic waits. Callbacks run under V8's wait
+// lock, potentially on the notifying thread. They must not re-enter V8 or call
+// WakeUp synchronously. The observer must outlive the isolate's active wait.
+class V8_EXPORT AtomicsWaitWakeHandle {
+ public:
+  virtual ~AtomicsWaitWakeHandle() = default;
+  virtual void WakeUp() = 0;
+};
+
+class V8_EXPORT AtomicsWaitObserver {
+ public:
+  virtual ~AtomicsWaitObserver() = default;
+  // Configure on the isolate thread outside an active synchronous wait.
+  static void SetForIsolate(Isolate* isolate, AtomicsWaitObserver* observer);
+  virtual int64_t NowMicroseconds() = 0;
+  // deadline_us is INT64_MAX for an infinite wait. Repeated after an interrupt
+  // or spurious wake, with the same deadline and handle.
+  virtual void OnWait(std::shared_ptr<AtomicsWaitWakeHandle> handle,
+                      int64_t deadline_us) = 0;
+  // Before notification, interrupt handling, timeout return or termination.
+  // May be repeated; the embedder must make this transition idempotent.
+  virtual void OnWake() = 0;
+};
+
+}  // namespace v8
+
+#endif  // INCLUDE_V8_ATOMICS_WAIT_H_
