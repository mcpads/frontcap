+    // its ExecutionContext. Scope this counter to the document, not that reuse.
+    if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+      const auto document = window->document()->Token();
+      if (sequence->document_ != document) {
+        sequence->document_ = document;
+        sequence->last_ = 0;
+      }
+    }
+    CHECK_NE(sequence->last_, std::numeric_limits<uint64_t>::max());
+    return ++sequence->last_;
+  }
+  void Trace(Visitor* visitor) const override {
+    Supplement<ExecutionContext>::Trace(visitor);
+  }
+ private:
+  uint64_t last_ = 0;
+  std::optional<DocumentToken> document_;
+};
