 ProcessTimeOverrideCoordinator::ProcessTimeOverrideCoordinator() = default;
+
+bool ProcessTimeOverrideCoordinator::FrontcapOthersDue(
+    const ScopedOverride* self,
+    bool include_worker_enrollment) {
+  auto& coordinator = Instance();
+  base::AutoLock auto_lock(coordinator.lock_);
+  // Read enrollment and runnable votes under one lock: a start can hand off
+  // to a worker's own vote while this query runs, without a false idle gap.
+  if (include_worker_enrollment) {
+    for (const auto& entry : coordinator.frontcap_blocks_) {
+      if (entry.enrollments && !entry.suspended) return true;
+    }
+  }
+  const auto now = coordinator.FrontcapVirtualTicks();
+  for (const auto& [client, ticks] : coordinator.requested_ticks_by_client_) {
+    if (client != self && ticks <= now &&
+        (!client->stalled_.load(std::memory_order_acquire) ||
+         client->frontcap_atomic_waiting_)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ProcessTimeOverrideCoordinator::FrontcapOthersReceiving(
+    const ScopedOverride* self) {
+  auto& coordinator = Instance();
+  base::AutoLock auto_lock(coordinator.lock_);
+  for (const auto& [client, ticks] : coordinator.requested_ticks_by_client_) {
+    if (client != self &&
+        client->counted_loads_.load(std::memory_order_acquire) > 0 &&
+        !client->in_synchronous_load_.load(std::memory_order_acquire) &&
+        !client->frontcap_atomic_waiting_) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void ProcessTimeOverrideCoordinator::FrontcapBeginWorkerEnrollment(
+    base::PlatformThreadRef owner) {
+  auto& self = Instance();
+  base::AutoLock lock(self.lock_);
+  self.FrontcapSharedHoldLocked();
+  auto& entry = self.FrontcapBlocksForOwnerLocked(owner);
+  CHECK_LT(entry.enrollments, std::numeric_limits<uint64_t>::max());
+  ++entry.enrollments;
+}
+
+void ProcessTimeOverrideCoordinator::FrontcapEndWorkerEnrollment(
+    base::PlatformThreadRef owner) {
+  auto& self = Instance();
+  base::AutoLock lock(self.lock_);
+  auto it = std::find_if(self.frontcap_blocks_.begin(), self.frontcap_blocks_.end(),
+                         [owner](const auto& entry) { return entry.owner == owner; });
+  CHECK(it != self.frontcap_blocks_.end());
+  CHECK_GT(it->enrollments, 0u);
+  if (--it->enrollments == 0 && it->blocks == 0 && !it->suspended)
+    self.frontcap_blocks_.erase(it);
+  self.FrontcapSharedProposalLocked();
+}
+
+std::optional<base::TimeTicks>
+ProcessTimeOverrideCoordinator::FrontcapNextWakeUp(const ScopedOverride* self) {
+  auto& coordinator = Instance();
+  base::AutoLock auto_lock(coordinator.lock_);
+  std::optional<base::TimeTicks> next;
+  for (const auto& [client, ticks] : coordinator.requested_ticks_by_client_) {
+    if (client == self || ticks == base::TimeTicks::Max() ||
+        (client->stalled_.load(std::memory_order_acquire) &&
+         !client->frontcap_atomic_waiting_)) {
+      continue;
+    }
+    if (!next || ticks < *next) {
+      next = ticks;
+    }
+  }
+  return next;
+}
+
+bool ProcessTimeOverrideCoordinator::FrontcapIsActive() {
+  // Set while an override is in effect (DisableOverride resets it).
+  return !Instance().current_ticks_.load(std::memory_order_acquire).is_null();
+}
 
