+std::optional<base::TimeTicks> ProcessTimeOverrideCoordinator::FrontcapFrameTicks(
+    base::Time instant, const base::UnguessableToken& clock) {
+  auto& self = Instance();
+  base::AutoLock lock(self.lock_);
+  if (!self.clock_override_ || self.frontcap_shared_retired_ || clock.is_empty())
+    return std::nullopt;
+  base::Time now;
+  if (const auto* shared_now = self.frontcap_shared_now_.load(std::memory_order_acquire)) {
+    const auto* state = self.frontcap_shared_state_.load(std::memory_order_acquire);
+    if (!state->activated.load(std::memory_order_acquire) ||
+        state->failed.load(std::memory_order_acquire) ||
+        self.frontcap_shared_time_guid_ != clock ||
+        self.frontcap_shared_slot_ >= frontcap::kCapacity ||
+        state->participants[self.frontcap_shared_slot_].identity.load(
+            std::memory_order_acquire) != self.frontcap_shared_participant_ ||
+        !state->participants[self.frontcap_shared_slot_].armed.load(
+            std::memory_order_acquire)) return std::nullopt;
+    now = base::Time::UnixEpoch() +
+        base::Microseconds(shared_now->load(std::memory_order_acquire));
+  } else {
+    if (!self.frontcap_cookie_region_.IsValid() ||
+        self.frontcap_cookie_region_.GetGUID() != clock) return std::nullopt;
+    now = self.initial_time_ +
+        (self.current_ticks_.load(std::memory_order_acquire) - self.initial_ticks_);
+  }
+  if (instant > now) return std::nullopt;
+  return self.initial_ticks_ + (instant - self.initial_time_);
