+// Serialize replacements across both renderer handoff and pristine-target
+// recovery. A canceled navigation may select the previous frame while its
+// replacement's network-service acknowledgement is still pending.
+void ProcessCookieClockBindings(CookieClockState* clock) {
+  if (clock->binding_pending) return;
+  while (!clock->bindings.empty()) {
+    auto binding = std::move(clock->bindings.front());
+    clock->bindings.pop_front();
+    if (!IsSelectedCookieClockBinding(*clock, binding)) {
+      auto weak_clock = clock->weak_factory.GetWeakPtr();
+      std::move(binding.callback).Run(false);
+      if (!weak_clock) return;
+      continue;
+    }
+    auto* network_context = binding.frame->GetStoragePartition()->GetNetworkContext();
+    auto network_region = binding.region.Duplicate();
+    auto quota_region = binding.region.Duplicate();
+    auto quota_proxy = base::WrapRefCounted(
+        static_cast<StoragePartitionImpl*>(binding.frame->GetStoragePartition())
+            ->GetQuotaManagerProxy());
+    clock->binding_pending = true;
+    auto completed = base::BindOnce(
+        [](base::WeakPtr<CookieClockState> clock,
+           PendingCookieClockBinding binding, bool attached) {
+          if (!clock) {
+            std::move(binding.callback).Run(false);
+            return;
+          }
+          clock->binding_pending = false;
+          if (attached && (!clock->region.IsValid() ||
+              clock->region.GetGUID() != binding.region.GetGUID())) {
+            clock->region = std::move(binding.region);
+          }
+          // Only the currently selected frame may resume. The queued owner
+          // can reclaim the same instant after a canceled navigation.
+          const bool selected = IsSelectedCookieClockBinding(*clock, binding);
+          std::move(binding.callback).Run(attached && selected);
+          if (clock) ProcessCookieClockBindings(clock.get());
+        }, clock->weak_factory.GetWeakPtr(), std::move(binding));
