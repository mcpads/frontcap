+  frontcap::ParticipantClock clock(state, *now);
+  const frontcap::Handle handle{state.scope, frontcap_shared_slot_, frontcap_shared_participant_};
+  const auto result = frontcap::Propose(clock, handle, frontcap_shared_revision_,
+      std::max(proposal, now->load(std::memory_order_acquire)));
+  if (result.status == frontcap::Status::busy) return;  // Notifier retries; old hold/proposal remains.
+  if (result.status == frontcap::Status::stale && FrontcapSharedRetiredLocked()) return;
+  CHECK(result.status == frontcap::Status::ok);
+  frontcap_shared_revision_ = result.revision;
+}
+
+bool ProcessTimeOverrideCoordinator::FrontcapArmSharedClock() {
+  auto& self = Instance();
+  base::AutoLock lock(self.lock_);
+  if (self.frontcap_shared_retired_ || !self.clock_override_ || !self.frontcap_shared_time_mapping_.IsValid()) return false;
+  if (self.frontcap_shared_now_.load(std::memory_order_acquire)) return true;
+  auto* state = static_cast<frontcap::SharedControl*>(self.frontcap_shared_control_mapping_.memory());
+  const auto* now = static_cast<const std::atomic<int64_t>*>(self.frontcap_shared_time_mapping_.memory());
+  if (state->failed.load(std::memory_order_acquire) ||
+      (self.initial_time_ + (self.FrontcapVirtualTicks() - self.initial_ticks_) -
+          base::Time::UnixEpoch()).InMicroseconds() != now->load(std::memory_order_acquire)) return false;
+  self.frontcap_shared_state_.store(state, std::memory_order_release);
+  self.frontcap_shared_now_.store(now, std::memory_order_release);
+  self.FrontcapSharedHoldLocked();
+  self.frontcap_shared_notifier_ = std::make_unique<base::Thread>("FrontcapClockWake");
+  if (!self.frontcap_shared_notifier_->Start()) {
+    state->failed.store(true, std::memory_order_release);
+    return false;
+  }
+  self.frontcap_shared_notifier_->task_runner()->PostTask(FROM_HERE, base::BindOnce([] {
+    UseRealClockOnCurrentThread();
+    auto& coordinator = Instance();
+    coordinator.frontcap_shared_poll_timer_ = std::make_unique<base::RepeatingTimer>();
+    coordinator.frontcap_shared_poll_timer_->Start(FROM_HERE, base::Milliseconds(1),
+        base::BindRepeating(&ProcessTimeOverrideCoordinator::FrontcapPollSharedClock,
+                           base::Unretained(&coordinator)));
+  }));
+  state->participants[self.frontcap_shared_slot_].armed.store(true, std::memory_order_release);
+  return true;
+}
+
+void ProcessTimeOverrideCoordinator::FrontcapPollSharedClock() {
+  base::AutoLock lock(lock_);
+  if (FrontcapSharedRetiredLocked()) {
+    frontcap_shared_poll_timer_->Stop();
+    return;
+  }
+  const auto now = FrontcapVirtualTicks();
+  const auto before = current_ticks_.load(std::memory_order_acquire);
+  if (now != before)
+    current_ticks_.store(now, std::memory_order_release);
+  for (const auto& [client, requested] : requested_ticks_by_client_) {
+    const auto holds = client->holds_.load(std::memory_order_acquire);
+    // A task posted to a disabled/fenced queue holds the shared instant but
+    // need not wake its scheduler. Recheck its vote even if that hold prevents
+    // time from changing. Wake only for new work or a newly committed instant;
+    // never release a hold or enable the task's queue from this thread.
+    if (now != before || holds != client->frontcap_notified_holds_) {
+      client->frontcap_notified_holds_ = holds;
+      client->ScheduleWork();
+    }
+  }
+  FrontcapSharedProposalLocked();
+}
+
+std::optional<base::Time> ProcessTimeOverrideCoordinator::FrontcapMainThreadArrival() {
+  auto& self = Instance();
+  base::AutoLock lock(self.lock_);
+  const auto* state = self.frontcap_shared_state_.load(std::memory_order_acquire);
+  if (!state || !state->activated.load(std::memory_order_acquire) ||
+      state->failed.load(std::memory_order_acquire) || !self.frontcap_main_owner_)
+    return std::nullopt;
+  for (const auto& [client, requested] : self.requested_ticks_by_client_) {
+    if (client->frontcap_owner_ == *self.frontcap_main_owner_ &&
+        client->frontcap_arrival_waiting_ && requested > self.FrontcapVirtualTicks())
+      return self.initial_time_ + (requested - self.initial_ticks_);
+  }
+  return std::nullopt;
+}
+
+void ProcessTimeOverrideCoordinator::FrontcapSharedArrival(base::Time arrival) {
+  const auto owner = base::PlatformThread::CurrentRef();
+  ScopedOverride* waiting = nullptr;
+  bool was_suspended = false;
+  const auto requested = initial_ticks_ + (arrival - initial_time_);
+  {
+    base::AutoLock lock(lock_);
+    if (requested <= FrontcapVirtualTicks()) return;
+    FrontcapSharedHoldLocked();
+    for (const auto& [client, instant] : requested_ticks_by_client_) {
+      if (client->frontcap_owner_ == owner) { waiting = client; break; }
+    }
+    CHECK(waiting);
+    waiting->frontcap_arrival_waiting_ = true;
+    requested_ticks_by_client_[waiting] = requested;
+    auto& block = FrontcapBlocksForOwnerLocked(owner);
+    was_suspended = block.suspended;
+    block.suspended = true;
+    FrontcapSharedProposalLocked();
+  }
+  // The browser authority and notifier remain runnable while this main thread
+  // waits. Other processes/workers must reach their own earlier work first.
+  while (FrontcapVirtualTicks() < requested) {
+    base::PlatformThread::Sleep(base::Milliseconds(1));
+  }
+  {
+    base::AutoLock lock(lock_);
+    FrontcapSharedHoldLocked();
+    CHECK_EQ(FrontcapVirtualTicks(), requested);
+    waiting->frontcap_arrival_waiting_ = false;
+    requested_ticks_by_client_[waiting] = requested;
+    waiting->holds_.fetch_add(1, std::memory_order_acq_rel);
+    FrontcapBlocksForOwnerLocked(owner).suspended = was_suspended;
+  }
+}
+
+bool ProcessTimeOverrideCoordinator::FrontcapSynchronizeUnstartedRenderer(
+    base::Time instant) {
+  auto& self = Instance();
+  base::AutoLock lock(self.lock_);
+  if (self.frontcap_shared_now_.load(std::memory_order_acquire) ||
+      !self.clock_override_ || self.requested_ticks_by_client_.size() != 1)
+    return false;
+  for (const auto& entry : self.frontcap_blocks_) {
+    if (entry.enrollments) return false;
+  }
+  const auto current = self.FrontcapVirtualTicks();
+  const auto now = self.initial_time_ + (current - self.initial_ticks_);
+  if (instant <= now) return instant == now;
+  const auto aligned = current + (instant - now);
+  self.requested_ticks_by_client_.begin()->second = aligned;
+  self.PublishFrontcapCookieTime(aligned);
+  self.current_ticks_.store(aligned, std::memory_order_release);
+  return true;
+}
+
+void ProcessTimeOverrideCoordinator::PublishFrontcapCookieTime(
+    base::TimeTicks ticks) {
+  CHECK(!frontcap_shared_now_.load(std::memory_order_acquire));
+  if (!frontcap_cookie_mapping_.IsValid()) return;
+  auto* value = static_cast<base::subtle::Atomic64*>(
+      frontcap_cookie_mapping_.memory());
+  const base::Time now = initial_time_ + (ticks - initial_ticks_);
+  base::subtle::Release_Store(value,
+      (now - base::Time::UnixEpoch()).InMicroseconds());
+}
