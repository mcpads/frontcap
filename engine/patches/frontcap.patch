+namespace blink {
+
+// frontcap engine patch 54: an answer the page waits for from the bucket manager
+// or a bucket (open, keys, delete, persist, estimate...) is part of the instant's
+// storage work, as an IndexedDB request's is (engine patch 42). It is a counted
+// resource until it is handled, so a zero-length grant and a frame wait for it,
+// and it is delivered on the storage queue, serviced during a grant and held at
+// an explicit stop. Uncounted, its handling could fall after a grant that ended
+// and run page script at the stop, whose next IndexedDB request no stop serves.
+inline TaskType FrontcapStorageAnswerTaskType(TaskType otherwise) {
+  return base::FeatureList::IsEnabled(features::kFrontcapVirtualWorkers)
+             ? TaskType::kDatabaseAccess
+             : otherwise;
+}
+
+template <typename... Args>
+base::OnceCallback<void(Args...)> FrontcapHoldUntilAnswered(
+    ExecutionContext* context,
+    base::OnceCallback<void(Args...)> callback) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapVirtualWorkers) ||
+      !context || context->IsContextDestroyed()) {
+    return callback;
+  }
+  // Released when the answer is handled, or with the callback when the
+  // connection goes without answering.
+  auto wait = std::make_shared<WebScopedVirtualTimePauser>(
+      context->GetScheduler()->CreateWebScopedVirtualTimePauser(
+          "StorageBucket answer",
+          WebScopedVirtualTimePauser::VirtualTaskDuration::kInstant));
+  wait->FrontcapMarkResource();
+  wait->PauseVirtualTime();
