+void StorageAreaImpl::ReadSnapshot(
+    base::OnceCallback<void(StatusOr<ValueMap>)> callback) {
+  if (snapshot_load_error_) {
+    std::move(callback).Run(base::unexpected(*snapshot_load_error_));
