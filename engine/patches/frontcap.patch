+void DocumentLoader::ArmFrontcapParserStop(const String& operation, DocumentParser* parser) {
+  frontcap_parser_stop_owner_ = parser;
+  frontcap_parser_stop_ = std::make_unique<FrontcapParserStop>();
+  frontcap_parser_stop_->operation = operation;
