+
+void RenderFrameDevToolsAgentHost::ReleaseFinishedNavigationWaiters() {
+  auto unfinished = [this](const base::UnguessableToken& token) {
+    return std::ranges::any_of(navigation_requests_, [&](const auto& request) {
+      return request->devtools_navigation_token() == token;
+    });
+  };
+  std::vector<std::pair<base::UnguessableToken, base::OnceClosure>> waiting;
+  for (auto& [token, done] : std::exchange(navigation_finish_waiters_, {})) {
+    if (unfinished(token)) {
+      waiting.emplace_back(token, std::move(done));
+    } else {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                               std::move(done));
+    }
+  }
+  navigation_finish_waiters_ = std::move(waiting);
+}
