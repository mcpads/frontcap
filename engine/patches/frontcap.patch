+namespace {
+std::unique_ptr<Storage::FrontcapStorageScope> BuildFrontcapStorageScope(
+    const blink::StorageKey& key,
+    std::vector<const storage::BucketInfo*> ordered) {
+  std::sort(ordered.begin(), ordered.end(), [](const auto* a, const auto* b) {
+    if (a->is_default() != b->is_default())
+      return a->is_default();
+    return a->name < b->name;
+  });
+  auto buckets = std::make_unique<Array<Storage::FrontcapBucket>>();
+  for (const auto* bucket : ordered) {
+    auto item =
+        Storage::FrontcapBucket::Create()
+            .SetQuota(base::NumberToString(bucket->quota))
+            .SetPersistent(bucket->persistent)
+            .SetDurability(bucket->durability ==
+                                   blink::mojom::BucketDurability::kStrict
+                               ? Storage::StorageBucketsDurabilityEnum::Strict
+                               : Storage::StorageBucketsDurabilityEnum::Relaxed)
+            .Build();
+    if (!bucket->is_default())
+      item->SetName(bucket->name);
+    if (!bucket->expiration.is_null()) {
+      item->SetExpiration(
+          base::NumberToString(bucket->expiration.ToInternalValue()));
+    }
+    buckets->push_back(std::move(item));
+  }
+  return Storage::FrontcapStorageScope::Create()
+      .SetStorageKey(key.Serialize())
+      .SetOrigin(key.origin().Serialize())
+      .SetTopLevelSite(key.top_level_site().Serialize())
+      .SetHasCrossSiteAncestor(key.ancestor_chain_bit() ==
+                               blink::mojom::AncestorChainBit::kCrossSite)
+      .SetNoncePartition(key.nonce().has_value())
+      .SetFirstParty(key == blink::StorageKey::CreateFirstParty(key.origin()))
+      .SetBuckets(std::move(buckets))
+      .Build();
+}
+}  // namespace
