+    // same shared clock. A failed handoff cannot resume with mixed clocks.
+    auto bind_quota = base::BindOnce(
+        [](scoped_refptr<storage::QuotaManagerProxy> quota, std::string owner,
+           base::ReadOnlySharedMemoryRegion region,
+           base::OnceCallback<void(bool)> completed, bool attached) {
+          if (!attached) {
+            std::move(completed).Run(false);
+            return;
+          }
+          quota->FrontcapSetClock(
+              owner, std::move(region),
+              base::SequencedTaskRunner::GetCurrentDefault(),
+              std::move(completed));
+        },
+        std::move(quota_proxy), clock->owner, std::move(quota_region),
+        std::move(completed));
+    network_context->FrontcapSetCookieClock(
+        clock->owner, std::move(network_region),
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(bind_quota),
+                                                    false));
+    return;
+  }
+}
