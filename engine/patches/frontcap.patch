+base::TimeTicks ProcessTimeOverrideCoordinator::FrontcapVirtualTicks() const {
+  const auto* now = frontcap_shared_now_.load(std::memory_order_acquire);
+  if (!now) return current_ticks_.load(std::memory_order_acquire);
+  const auto instant = now->load(std::memory_order_acquire);
+  CHECK(!frontcap_shared_state_.load(std::memory_order_acquire)->failed.load(std::memory_order_acquire));
+  return initial_ticks_ + (base::Time::UnixEpoch() + base::Microseconds(instant) - initial_time_);
+}
+
+bool ProcessTimeOverrideCoordinator::FrontcapSharedRetiredLocked() {
+  if (frontcap_shared_retired_) return true;
+  const auto* now = frontcap_shared_now_.load(std::memory_order_acquire);
+  if (!now) return false;
+  auto& state = *static_cast<frontcap::SharedControl*>(frontcap_shared_control_mapping_.memory());
+  frontcap::ParticipantClock clock(state, *now);
+  CHECK(!state.failed.load(std::memory_order_acquire));
+  if (frontcap::Matches(clock, {state.scope, frontcap_shared_slot_, frontcap_shared_participant_}))
+    return false;
+  // Only the browser can retire this identity, after normal process cleanup
+  // establishes that no application owner can use this renderer again. Keep
+  // mappings alive for concurrent clock readers until the process exits.
+  current_ticks_.store(FrontcapVirtualTicks(), std::memory_order_release);
+  frontcap_shared_now_.store(nullptr, std::memory_order_release);
+  frontcap_shared_retired_ = true;
+  return true;
+}
