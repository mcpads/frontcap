+
+namespace blink {
+
+namespace {
+
+// One document of the renderer's admission order: a navigation in flight
+// (no loader yet) or a committed document whose body is frozen or admitted.
+class Entry final : public GarbageCollected<Entry> {
+ public:
+  Entry(LocalFrame* frame, DocumentLoader* loader)
+      : frame(frame), loader(loader) {}
+  void Trace(Visitor* visitor) const {
+    visitor->Trace(frame);
+    visitor->Trace(loader);
+  }
+
+  WeakMember<LocalFrame> frame;
+  WeakMember<DocumentLoader> loader;
+  bool admitted = false;
+};
+
+using Entries = GCedHeapVector<Member<Entry>>;
+
+Entries& Queue() {
+  DEFINE_STATIC_LOCAL(Persistent<Entries>, entries,
+                      (MakeGarbageCollected<Entries>()));
+  return *entries;
+}
+
+// The main thread's scheduler, which outlives every page of the renderer.
+VirtualTimeController* g_controller = nullptr;
+bool g_pump_posted = false;
+// A page that keeps posting tasks at one instant cannot starve admission.
+int g_deferrals = 0;
+constexpr int kMaxDeferrals = 1000;
+
+VirtualTimeController* ControllerOf(LocalFrame& frame) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen))
+    return nullptr;
+  Page* page = frame.GetPage();
+  if (!page)
+    return nullptr;
+  VirtualTimeController* controller =
+      page->GetPageScheduler()->GetVirtualTimeController();
+  return controller && controller->FrontcapIsVirtualTimeEnabled() ? controller
+                                                                   : nullptr;
+}
+
+bool Held(const Entry& entry) {
+  return !entry.admitted && entry.loader && entry.loader->FrontcapBodyHeld();
+}
+
+// Whether an entry still stands for work: its frame is attached, its
+// navigation has not been cancelled and its document is current, and an
+// admitted body has not finished arriving.
+bool Live(const Entry& entry) {
+  LocalFrame* frame = entry.frame.Get();
+  if (!frame || frame->IsDetached() || !frame->GetPage())
+    return false;
+  DocumentLoader* loader = entry.loader.Get();
+  if (!loader)
+    return frame->Loader().HasProvisionalNavigation() &&
+           !frame->Loader().FrontcapNavigationIsDelegated();
+  if (loader->GetFrame() != frame ||
+      frame->Loader().GetDocumentLoader() != loader) {
+    return false;
+  }
+  return !entry.admitted || loader->GetFrontcapLoadingState().has_body_loader;
+}
+
+void Prune() {
+  Entries& queue = Queue();
+  HeapVector<Member<Entry>> live;
+  for (Entry* entry : queue) {
+    if (Live(*entry))
+      live.push_back(entry);
+  }
+  queue.swap(live);
+}
+
+bool Pending() {
+  Prune();
+  for (const Entry* entry : Queue()) {
+    if (!Held(*entry))
+      return true;
+  }
+  return false;
+}
+
+void Pump();
+
+void PostPump() {
+  if (!g_controller || g_pump_posted)
+    return;
+  g_pump_posted = true;
+  g_controller->FrontcapPostAfterReadyTasks(BindOnce(&Pump));
+}
+
+void Pump() {
+  g_pump_posted = false;
+  if (!Pending()) {
+    g_deferrals = 0;
+    g_controller->FrontcapDocumentAdmissionChanged();
+    return;
+  }
+  // Retried when progress is granted again or the nested loop ends.
+  if (g_controller->FrontcapDocumentAdmissionBlocked())
+    return;
+  // Only when this instant can do nothing else: a counted load in transit or
+  // a ready task could otherwise interleave with the body by host timing.
+  if (g_controller->FrontcapHasPendingResources()) {
+    g_pump_posted = true;
+    g_controller->FrontcapPostAfterResources(BindOnce(&Pump));
+    return;
+  }
+  // Tasks posted at this instant behind the loading pause's fences (an
+  // admitted parser's script continuation, a posted message) are this
+  // instant's work too, as for a frame (engine patch 12): they run first.
+  g_controller->FrontcapAdmitTasksOfThisInstant();
+  if (g_controller->FrontcapOtherThreadsDue()) {
+    PostPump();
+    return;
+  }
+  if (g_controller->FrontcapTaskCanRunNow() && g_deferrals < kMaxDeferrals) {
+    ++g_deferrals;
+    PostPump();
+    return;
+  }
+  g_deferrals = 0;
+  Entry* next = nullptr;
+  for (Entry* entry : Queue()) {
+    // An admitted body still arriving, or the earliest navigation still to
+    // commit: later documents wait for it (Changed() retries).
+    if (entry->admitted || !entry->loader)
+      return;
+    if (Held(*entry))
+      continue;
+    next = entry;
+    break;
+  }
+  if (!next) {
+    g_controller->FrontcapDocumentAdmissionChanged();
+    return;
+  }
+  next->admitted = true;
+  DocumentLoader* loader = next->loader.Get();
+  // Parsing can run author script synchronously and re-enter this queue.
+  loader->SetDefersLoading(LoaderFreezeMode::kNone);
+  PostPump();
+}
+
+// A policy change or the end of a nested loop: only a waiting document needs
+// another look.
+void Retry() {
+  if (!Queue().empty())
+    PostPump();
+}
+
+void Register(VirtualTimeController* controller) {
+  if (g_controller == controller)
+    return;
+  g_controller = controller;
+  controller->FrontcapSetDocumentAdmission(BindRepeating(&Pending),
+                                           BindRepeating(&Retry));
+}
+
+}  // namespace
+
+void FrontcapDocumentAdmission::NavigationStarted(LocalFrame& frame) {
+  VirtualTimeController* controller = ControllerOf(frame);
+  if (!controller)
+    return;
+  Register(controller);
+  Entries& queue = Queue();
+  // A new navigation of this frame replaces one that has not committed.
+  HeapVector<Member<Entry>> kept;
+  for (Entry* entry : queue) {
+    if (entry->frame != &frame || entry->loader)
+      kept.push_back(entry);
+  }
+  queue.swap(kept);
+  queue.push_back(MakeGarbageCollected<Entry>(&frame, nullptr));
+}
+
+bool FrontcapDocumentAdmission::WillCommit(LocalFrame& frame,
+                                           DocumentLoader& loader) {
+  VirtualTimeController* controller = ControllerOf(frame);
+  if (!controller)
+    return false;
+  Register(controller);
+  Entry* target = nullptr;
+  for (Entry* entry : Queue()) {
+    if (entry->frame == &frame && !entry->loader) {
+      target = entry;
+      break;
+    }
+  }
+  if (!target) {
+    target = MakeGarbageCollected<Entry>(&frame, nullptr);
+    Queue().push_back(target);
+  }
+  target->loader = &loader;
+  loader.SetDefersLoading(LoaderFreezeMode::kStrict);
+  PostPump();
+  return true;
+}
+
+bool FrontcapDocumentAdmission::Awaits(const DocumentLoader& loader) {
+  for (const Entry* entry : Queue()) {
+    if (entry->loader.Get() == &loader)
+      return !entry->admitted;
+  }
+  return false;
+}
+
+void FrontcapDocumentAdmission::Changed() {
+  Retry();
+}
+
+}  // namespace blink
