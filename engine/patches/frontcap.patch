+std::optional<base::TimeDelta>
+MainThreadSchedulerImpl::FrontcapDelayToNextWakeUp() {
+  // A task ready in an enabled queue: one held behind the virtual-time fence (posted at a budget's end)
+  // runs at this instant in the next budget.
+  for (const auto& pair : task_runners_) {
+    if (pair.first != frontcap_after_ready_task_queue_ &&
+        pair.first->HasTaskToRunImmediatelyOrReadyDelayedTask() &&
+        pair.first->IsQueueEnabled()) {
+      return base::TimeDelta();
+    }
+  }
+  return ThreadSchedulerBase::FrontcapDelayToNextWakeUp();
+}
+
+bool MainThreadSchedulerImpl::FrontcapTaskCanRunNow() {
+  for (const auto& pair : task_runners_) {
+    if (pair.first != frontcap_after_ready_task_queue_ &&
+        pair.first->HasTaskToRunImmediatelyOrReadyDelayedTask() &&
+        pair.first->IsQueueEnabled() &&
+        !pair.first->GetTaskQueue()->BlockedByFence()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The fences put up when virtual time paused (OnVirtualTimePaused) move to now: a message another thread
+// posted at this instant (a dedicated worker's) runs before this instant's frame.
+void MainThreadSchedulerImpl::FrontcapAdmitTasksOfThisInstant() {
+  if (VirtualTimeAllowedToAdvance()) {
+    return;
+  }
+  for (const auto& pair : task_runners_) {
+    if (pair.first->CanRunWhenVirtualTimePaused() ||
+        pair.first->IsThrottled() ||
+        !pair.first->GetTaskQueue()->BlockedByFence()) {
+      continue;
+    }
+    pair.first->GetTaskQueue()->InsertFence(
+        TaskQueue::InsertFencePosition::kNow);
+  }
+}
+
+bool MainThreadSchedulerImpl::FrontcapHasTasksOfThisInstant() {
+  if (VirtualTimeAllowedToAdvance()) {
+    return false;
+  }
+  for (const auto& pair : task_runners_) {
+    // A queue with no task ready (none, or a later timer's) counts as blocked by its fence too.
+    if (!pair.first->CanRunWhenVirtualTimePaused() &&
+        !pair.first->IsThrottled() && pair.first->IsQueueEnabled() &&
+        pair.first->HasTaskToRunImmediatelyOrReadyDelayedTask() &&
+        pair.first->GetTaskQueue()->BlockedByFence()) {
+      return true;
+    }
+  }
+  return false;
+}
