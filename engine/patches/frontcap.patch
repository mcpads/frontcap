+protocol::Response InspectorPageAgent::frontcapArmDocumentParserStop(
+    const String& frame_id, const String& loader_id, const String& operation) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen))
+    return protocol::Response::ServerError("frontcap parser stop is disabled");
+  LocalFrame* frame = IdentifiersFactory::FrameById(inspected_frames_, frame_id);
+  DocumentLoader* loader = frame ? frame->Loader().GetDocumentLoader() : nullptr;
+  if (!loader || IdentifiersFactory::LoaderId(loader) != loader_id)
+    return protocol::Response::ServerError("parser stop owner is no longer current");
+  if (operation.empty() || operation.length() > 128)
+    return protocol::Response::InvalidParams("parser stop operation must have 1 to 128 characters");
+  if (const auto* previous = loader->GetFrontcapParserStop()) {
+    if (previous->operation == operation) {
+      if (!previous->reached &&
+          (!loader->FrontcapParserStopOwner() ||
+           loader->FrontcapParserStopOwner() != frame->GetDocument()->Parser() ||
+           loader->FrontcapParserStopOwner()->IsStopped()))
+        return protocol::Response::ServerError("parser stop owner was lost");
+      return protocol::Response::Success();
+    }
+    return protocol::Response::ServerError("forget the previous parser stop receipt first");
+  }
+  if (!frame->GetPage() || !frame->GetPage()->GetPageScheduler()
+          ->GetVirtualTimeController()->FrontcapIsVirtualTimeEnabled())
+    return protocol::Response::ServerError("parser stop requires virtual time");
+  auto* parser = frame->GetDocument()->Parser();
+  auto* scriptable = parser ? parser->AsScriptableDocumentParser() : nullptr;
+  if (!scriptable || !scriptable->GetFrontcapParserState().supported || parser->IsStopped())
+    return protocol::Response::ServerError("document has no active HTML parser");
+  loader->ArmFrontcapParserStop(operation, parser);
+  return protocol::Response::Success();
+}
+
+protocol::Response InspectorPageAgent::frontcapForgetDocumentParserStop(
+    const String& frame_id, const String& loader_id, const String& operation) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen))
+    return protocol::Response::ServerError("frontcap parser stop is disabled");
+  LocalFrame* frame = IdentifiersFactory::FrameById(inspected_frames_, frame_id);
+  DocumentLoader* loader = frame ? frame->Loader().GetDocumentLoader() : nullptr;
+  if (!loader || IdentifiersFactory::LoaderId(loader) != loader_id)
+    return protocol::Response::ServerError("parser stop owner is no longer current");
+  const auto* receipt = loader->GetFrontcapParserStop();
+  const bool owner_lost = !loader->FrontcapParserStopOwner() ||
+      loader->FrontcapParserStopOwner() != frame->GetDocument()->Parser() ||
+      loader->FrontcapParserStopOwner()->IsStopped();
+  if (!receipt || receipt->operation != operation || (!receipt->reached && !owner_lost))
+    return protocol::Response::ServerError("no terminal parser stop for this operation");
+  loader->ForgetFrontcapParserStop();
+  return protocol::Response::Success();
+}
+
+protocol::Response InspectorPageAgent::frontcapSetDocumentBodyHold(
+    const String& frame_id, const String& loader_id, bool hold) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen))
+    return protocol::Response::ServerError("frontcap document body admission is disabled");
+  LocalFrame* frame = IdentifiersFactory::FrameById(inspected_frames_, frame_id);
+  DocumentLoader* loader = frame ? frame->Loader().GetDocumentLoader() : nullptr;
+  if (!loader || IdentifiersFactory::LoaderId(loader) != loader_id)
+    return protocol::Response::ServerError("document body owner is no longer current");
+  const auto state = loader->GetFrontcapLoadingState();
+  if (state.phase != DocumentLoader::kCommitted ||
+      state.freeze_mode != LoaderFreezeMode::kStrict ||
+      !state.has_body_loader || state.parser_received_data || state.committing_data)
+    return protocol::Response::ServerError("document body is not frozen before first input");
+  loader->SetFrontcapBodyHeld(hold);
+  // frontcap engine patch 51: a released hold rejoins ordered admission.
+  FrontcapDocumentAdmission::Changed();
+  return protocol::Response::Success();
+}
+
+protocol::Response InspectorPageAgent::frontcapGetDocumentLoadingStates(
+    std::unique_ptr<protocol::Array<protocol::Page::FrontcapDocumentLoadingState>>* states) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen))
+    return protocol::Response::ServerError("frontcap document loading inspection is disabled");
+  auto result = std::make_unique<protocol::Array<protocol::Page::FrontcapDocumentLoadingState>>();
+  for (LocalFrame* frame : *inspected_frames_) {
+    DocumentLoader* loader = frame->Loader().GetDocumentLoader();
+    Document* document = frame->GetDocument();
+    if (!loader || !document)
+      continue;
+    const auto state = loader->GetFrontcapLoadingState();
+    String phase;
+    switch (state.phase) {
+      case DocumentLoader::kNotStarted: phase = "not_started"; break;
+      case DocumentLoader::kProvisional: phase = "provisional"; break;
+      case DocumentLoader::kCommitted: phase = "committed"; break;
+      case DocumentLoader::kSentDidFinishLoad: phase = "load_sent"; break;
+    }
+    String freeze;
+    switch (state.freeze_mode) {
+      case LoaderFreezeMode::kNone: freeze = "none"; break;
+      case LoaderFreezeMode::kStrict: freeze = "strict"; break;
+      case LoaderFreezeMode::kBufferIncoming: freeze = "buffer_incoming"; break;
+    }
+    DocumentParser* parser = document->Parser();
+    auto* scriptable = parser ? parser->AsScriptableDocumentParser() : nullptr;
+    const auto parser_state = scriptable ? scriptable->GetFrontcapParserState()
+        : ScriptableDocumentParser::FrontcapParserState{};
+    String parser_phase;
+    if (document->HasFinishedParsing()) parser_phase = "finished";
+    else if (!parser) parser_phase = "absent";
+    else if (!parser_state.supported) parser_phase = "unsupported";
+    else if (parser->IsStopped()) parser_phase = "stopped";
+    else if (parser_state.executing_script) parser_phase = "executing_script";
+    else if (parser_state.waiting_for_user_timing) parser_phase = "waiting_user_timing";
+    else if (parser_state.waiting_for_stylesheets) parser_phase = "waiting_stylesheet";
+    else if (parser_state.waiting_for_scripts) parser_phase = "waiting_script";
+    else if (parser_state.work_scheduled) parser_phase = "scheduled";
+    else if (parser_state.buffered_characters) parser_phase = "buffered";
+    else if (state.has_body_loader) parser_phase = "awaiting_input";
+    else parser_phase = "idle";
+    const auto* stop = loader->GetFrontcapParserStop();
+    const bool owner_lost = stop && !stop->reached &&
+        (!loader->FrontcapParserStopOwner() ||
+         loader->FrontcapParserStopOwner() != parser ||
+         loader->FrontcapParserStopOwner()->IsStopped());
+    result->emplace_back(protocol::Page::FrontcapDocumentLoadingState::create()
+        .setFrameId(IdentifiersFactory::FrameId(frame))
+        .setLoaderId(IdentifiersFactory::LoaderId(loader))
+        .setUrl(document->Url().GetString())
+        .setPhase(phase)
+        .setFreezeMode(freeze)
+        .setParserPhase(parser_phase)
+        .setParserWaitingForScripts(parser_state.waiting_for_scripts)
+        .setParserWaitingForStylesheets(parser_state.waiting_for_stylesheets)
+        .setParserWaitingForUserTiming(parser_state.waiting_for_user_timing)
+        .setParserWorkScheduled(parser_state.work_scheduled)
+        .setParserExecutingScript(parser_state.executing_script)
+        .setParserNestedPump(parser_state.nested_pump)
+        .setParserBufferedCharacters(String::Number(parser_state.buffered_characters))
+        .setParserStopOperation(loader->GetFrontcapParserStop()
+            ? loader->GetFrontcapParserStop()->operation : String())
+        .setParserStopState(loader->GetFrontcapParserStop()
+            ? (loader->GetFrontcapParserStop()->reached ? "pump_returned" :
+               (owner_lost ? "owner_lost" : "armed"))
+            : "none")
+        .setBodyHeld(loader->FrontcapBodyHeld())
+        .setHasBodyLoader(state.has_body_loader)
+        .setParserReceivedData(state.parser_received_data)
+        .setParserBlockCount(state.parser_block_count)
+        .setCommittingData(state.committing_data)
+        .setFinishDeferred(state.finish_deferred)
+        .setBufferedEncodedBytes(String::Number(state.buffered_encoded_bytes))
+        .setBufferedDecodedData(state.buffered_decoded_data)
+        .setDocumentParsing(document->Parsing())
+        .setDocumentFinishedParsing(document->HasFinishedParsing())
+        .setLoadEventFinished(document->LoadEventFinished())
+        .setHasProvisionalNavigation(frame->Loader().HasProvisionalNavigation())
+        .setCommittingNavigation(frame->Loader().IsCommittingNavigation())
+        .build());
+  }
+  *states = std::move(result);
+  return protocol::Response::Success();
+}
