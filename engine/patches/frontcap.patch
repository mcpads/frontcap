+// frontcap engine patch 1: a request the automation holds stops counting toward
+// `pauseIfNetworkFetchesPending` while it holds it, and counts again before it answers.
+protocol::Response InspectorNetworkAgent::setRequestPausesVirtualTime(
+    const String& request_id,
+    bool pauses) {
+  // A subresource's request id is its inspector id with the process prefix.
+  std::string id = request_id.Utf8();
+  size_t dot = id.find('.');
+  uint64_t inspector_id = 0;
+  if (dot == std::string::npos ||
+      !base::StringToUint64(std::string_view(id).substr(dot + 1),
+                            &inspector_id) ||
+      !inspector_id) {
+    return protocol::Response::InvalidParams("Not a subresource request id");
+  }
+  // frontcap engine patch 9: a worker's own loads, by its global scope's fetcher.
+  HeapVector<Member<ResourceFetcher>> fetchers;
+  if (worker_or_worklet_global_scope_) {
+    for (ResourceFetcher* fetcher :
+         worker_or_worklet_global_scope_->FrontcapResourceFetchers()) {
+      fetchers.push_back(fetcher);
+    }
+  } else if (inspected_frames_) {
+    for (LocalFrame* frame : *inspected_frames_) {
+      Document* document = frame->GetDocument();
+      if (document) {
+        fetchers.push_back(document->Fetcher());
+      }
+    }
+  }
+  for (ResourceFetcher* fetcher : fetchers) {
+    if (!fetcher) {
+      continue;
+    }
+    Resource* resource = fetcher->LoadingResourceByInspectorId(inspector_id);
+    if (!resource ||
+        IdentifiersFactory::SubresourceRequestId(resource->InspectorId()) !=
+            request_id) {
+      continue;
+    }
+    if (pauses) {
+      resource->VirtualTimePauser().ReengageForAutomation();
+    } else {
+      resource->VirtualTimePauser().ReleaseForAutomation();
+    }
+    return protocol::Response::Success();
+  }
+  // frontcap engine patch 9: a load of a worker blocked in a synchronous load.
+  if (scheduler::FrontcapReleaseSynchronousWait(inspector_id, pauses)) {
+    return protocol::Response::Success();
+  }
+  return protocol::Response::ServerError("No loading request " +
+                                         request_id.Utf8());
+}
