+
+void DocumentLoader::FrontcapDidPumpParser(DocumentParser* parser) {
+  if (!frontcap_parser_stop_ || frontcap_parser_stop_->reached ||
+      frontcap_parser_stop_owner_ != parser ||
+      !frame_ || !frame_->GetPage())
+    return;
+  auto* controller = frame_->GetPage()->GetPageScheduler()->GetVirtualTimeController();
+  if (!controller->FrontcapIsVirtualTimeEnabled())
+    return;
+  // Finish the current native task, including its microtask checkpoint, but
+  // admit no further page task before the controller explicitly grants progress.
+  controller->SetVirtualTimePolicy(VirtualTimeController::VirtualTimePolicy::kPause);
+  frontcap_parser_stop_->reached = true;
+}
