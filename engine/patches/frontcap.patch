+void InspectorIndexedDBAgent::frontcapInitializeDatabase(
+    std::unique_ptr<protocol::Storage::StorageBucket> storage_bucket,
+    const String& database_name,
+    double version,
+    std::unique_ptr<protocol::Array<protocol::IndexedDB::FrontcapObjectStore>>
+        stores,
+    std::unique_ptr<FrontcapInitializeDatabaseCallback> callback) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen) ||
+      worker_global_scope_) {
+    callback->sendFailure(protocol::Response::ServerError(
+        "Native IndexedDB initialization requires a frontcap frame."));
+    return;
+  }
+  if (!std::isfinite(version) || version < 1 || version > 9007199254740991.0 ||
+      std::floor(version) != version || database_name.length() > 1024) {
+    callback->sendFailure(
+        protocol::Response::InvalidParams("Invalid database name or version."));
+    return;
+  }
+  FrontcapStorageScope* scope = nullptr;
+  if (storage_bucket && inspected_frames_->Root()) {
+    std::optional<String> bucket_name;
+    if (storage_bucket->hasName()) bucket_name = storage_bucket->getName("");
+    scope = FrontcapStorageScopes::From(*inspected_frames_->Root()->DomWindow())
+                .Find(storage_bucket->getStorageKey(), bucket_name);
+  }
+  auto resolved =
+      ResolveExecutionContext(inspected_frames_.Get(), nullptr, std::nullopt,
+                              std::nullopt, storage_bucket);
+  if (scope) resolved = inspected_frames_->Root()->DomWindow();
+  if (!resolved.has_value()) {
+    callback->sendFailure(resolved.error());
+    return;
+  }
+  ExecutionContext* context = resolved.value();
+  if (!context->GetSecurityOrigin()->IsPotentiallyTrustworthy()) {
+    callback->sendFailure(protocol::Response::InvalidParams(
+        "A trustworthy storage origin is required."));
+    return;
+  }
+  auto* request = MakeGarbageCollected<IDBInitialization>(
+      context, database_name, static_cast<int64_t>(version),
+      std::move(callback));
+  initializations_.insert(request);
+  request->SetCompletion(BindOnce(
+      [](InspectorIndexedDBAgent* agent, IDBInitialization* request) {
+        agent->initializations_.erase(request);
+      },
+      WrapWeakPersistent(this), WrapWeakPersistent(request)));
+  if (!request->Prepare(context->GetIsolate(), stores.get())) {
+    request->RejectInput();
+    return;
+  }
+  if (scope) {
+    request->StartWithInspectorFactory(scope->indexed_db.is_bound() ? scope->indexed_db.get() : nullptr);
+    return;
+  }
+  ExecutableWithIdbFactory::Start(
+      context, std::move(storage_bucket),
+      BindOnce(&IDBInitialization::Start, WrapWeakPersistent(request)));
+}
