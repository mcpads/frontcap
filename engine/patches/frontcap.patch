+void StorageHandler::FrontcapRestoreDOMStorageArea(
+    const std::string& serialized_storage_key, bool is_local_storage,
+    std::unique_ptr<Array<Storage::FrontcapDOMStorageEntry>> entries,
+    std::unique_ptr<FrontcapRestoreDOMStorageAreaCallback> callback) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) ||
+      !frame_host_ || !storage_partition_) {
+    callback->sendFailure(Response::ServerError("Expected a controlled document target"));
+    return;
+  }
+  auto* contents = WebContents::FromRenderFrameHost(frame_host_);
+  if (!contents || frame_host_->GetParentOrOuterDocument()) {
+    callback->sendFailure(Response::ServerError("Expected a top-level document target"));
+    return;
+  }
+  auto key = blink::StorageKey::Deserialize(serialized_storage_key);
+  if (!key || key->Serialize() != serialized_storage_key ||
+      key->origin().opaque() || key->nonce()) {
+    callback->sendFailure(Response::InvalidParams("Expected a canonical reproducible storage key"));
+    return;
+  }
+  auto* context = static_cast<DOMStorageContextWrapper*>(
+      storage_partition_->GetDOMStorageContext());
+  if (!context || !context->HasStorageControls()) {
+    callback->sendFailure(Response::ServerError("DOM storage service is unavailable"));
+    return;
+  }
+  std::optional<std::string> namespace_id;
+  if (!is_local_storage) {
+    const auto& namespaces = contents->GetController().GetSessionStorageNamespaceMap();
+    auto ns = namespaces.find(storage_partition_->GetConfig());
+    if (ns == namespaces.end()) {
+      callback->sendFailure(Response::ServerError("Target has no session storage namespace"));
+      return;
+    }
+    namespace_id = ns->second->id();
+  }
+  std::vector<blink::mojom::KeyValuePtr> values;
+  for (const auto& entry : *entries) {
+    const auto raw_key = entry->GetKey();
+    const auto raw_value = entry->GetValue();
+    values.push_back(blink::mojom::KeyValue::New(
+        std::vector<uint8_t>(raw_key.begin(), raw_key.end()),
+        std::vector<uint8_t>(raw_value.begin(), raw_value.end())));
+  }
+  auto done = mojo::WrapCallbackWithDefaultInvokeIfNotRun(base::BindOnce(
+      [](base::WeakPtr<StorageHandler> owner, GlobalRenderFrameHostId frame_id,
+         std::string document, std::optional<std::string> namespace_id,
+         std::unique_ptr<FrontcapRestoreDOMStorageAreaCallback> callback,
+         const std::optional<std::string>& error) {
+        if (!owner || !owner->frame_host_ || !owner->storage_partition_ ||
+            owner->frame_host_->GetGlobalId() != frame_id ||
+            owner->frame_host_->GetDocumentToken().ToString() != document) {
+          callback->sendFailure(Response::ServerError("Storage restore target changed"));
+          return;
+        }
+        if (namespace_id) {
+          auto* contents = WebContents::FromRenderFrameHost(owner->frame_host_);
+          if (!contents) {
+            callback->sendFailure(Response::ServerError("Storage restore target disappeared"));
+            return;
+          }
+          const auto& namespaces = contents->GetController().GetSessionStorageNamespaceMap();
+          auto ns = namespaces.find(owner->storage_partition_->GetConfig());
+          if (ns == namespaces.end() || ns->second->id() != *namespace_id) {
+            callback->sendFailure(Response::ServerError("Session storage namespace changed"));
+            return;
+          }
+        }
+        if (error) {
+          callback->sendFailure(Response::ServerError(*error));
+          return;
+        }
+        callback->sendSuccess();
+      }, weak_ptr_factory_.GetWeakPtr(), frame_host_->GetGlobalId(),
+      frame_host_->GetDocumentToken().ToString(), namespace_id, std::move(callback)),
+      std::optional<std::string>("DOM storage restore was interrupted"));
+  if (is_local_storage)
+    context->GetLocalStorageControl()->RestoreEmptyArea(*key, std::move(values), std::move(done));
+  else
+    context->GetSessionStorageControl()->RestoreEmptyArea(*key, *namespace_id,
+                                                        std::move(values), std::move(done));
+}
