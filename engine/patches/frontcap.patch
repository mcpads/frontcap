+  void DidCount(wtf_size_t store_index, bool success, uint32_t count) {
+    if (!callback_) {
+      return;
+    }
+    if (!success || count != stores_[store_index].records.size()) {
+      ReadbackFailed();
+      return;
+    }
+    ReadFinished();
+  }
+  void DidRead(wtf_size_t store_index,
+               wtf_size_t record_index,
+               mojom::blink::IDBDatabaseGetResultPtr result) {
+    if (!callback_) {
+      return;
+    }
+    if (!result->is_value()) {
+      ReadbackFailed();
+      return;
+    }
+    const auto& store = stores_[store_index];
+    const auto& expected = store.records[record_index];
+    const auto& observed = result->get_value();
+    if (observed->value->Data() != base::span(expected.expected_data) ||
+        !observed->value->BlobInfo().empty() ||
+        !observed->value->FileSystemAccessTokens().empty()) {
+      ReadbackFailed();
+      return;
+    }
+    if (store.metadata->auto_increment && !store.metadata->key_path.IsNull() &&
+        (!observed->primary_key->IsEqual(expected.key.get()) ||
+         !(observed->key_path == store.metadata->key_path))) {
+      ReadbackFailed();
+      return;
+    }
+    ReadFinished();
+  }
+  void ReadFinished() {
+    if (--pending_reads_ == 0) {
+      read_commit_sent_ = true;
+      transaction_->Commit(0);
+    }
+  }
+  void Finish(protocol::Response response) {
+    if (!callback_) {
+      return;
+    }
+    auto callback = std::move(callback_);
+    factory_client_.reset();
+    database_callbacks_.reset();
+    transaction_.reset();
+    database_.reset();
+    if (response.IsSuccess()) {
+      callback->sendSuccess();
+    } else {
+      callback->sendFailure(response);
