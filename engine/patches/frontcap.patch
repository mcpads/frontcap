+    // An unconfirmed one stays uncertified: its unbinding records the loss.
+    if (*confirmed) {
+      storage_partition_impl_->FrontcapCertifyDomStorageWrites(
+          dom_storage_receiver_ids_);
+    }
+    return false;
+  }
+  frontcap_dom_storage_confirming_ = true;
+  storage_partition_impl_->FrontcapConfirmDomStorageWrites(
+      dom_storage_receiver_ids_,
+      base::BindPostTaskToCurrentDefault(base::BindOnce(
+          &RenderProcessHostImpl::FrontcapDomStorageWritesConfirmed,
+          instance_weak_factory_.GetWeakPtr())));
+  return true;
+}
+
+void RenderProcessHostImpl::FrontcapDomStorageWritesConfirmed(bool confirmed) {
+  frontcap_dom_storage_confirming_ = false;
+  frontcap_dom_storage_confirmed_ = confirmed;
+  Cleanup();
+}
