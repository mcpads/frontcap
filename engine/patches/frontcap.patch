+    found->second->PopulateFromMetadata(database_.get(), metadata);
+  found->second->RestoreEmptyArea(storage_key, std::move(entries), base::BindOnce(
+      [](base::WeakPtr<SessionStorageImpl> owner,
+         RestoreEmptyAreaCallback callback, DbStatus status) {
+        if (!owner || owner->snapshot_inventory_error_)
+          std::move(callback).Run("Session storage restore interrupted");
+        else if (!status.ok())
+          std::move(callback).Run(status.ToString());
+        else
