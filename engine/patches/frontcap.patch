+std::optional<std::string> BucketManager::GrantFrontcapScope(
+    FrontcapScope scope, base::PassKey<protocol::StorageHandler>) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) ||
+      scope.lifetime.expired() || !scope.client.document_token) {
+    return std::nullopt;
+  }
+  std::erase_if(frontcap_scopes_, [](const auto& item) {
+    return item.second.lifetime.expired();
+  });
+  if (frontcap_scopes_.size() >= 1024) {
+    return std::nullopt;
+  }
+  const std::string token = base::UnguessableToken::Create().ToString();
+  frontcap_scopes_.emplace(token, std::move(scope));
+  return token;
+}
+
+std::optional<BucketManager::FrontcapScope> BucketManager::TakeFrontcapScope(
+    const std::string& token, const storage::BucketClientInfo& client,
+    base::PassKey<BucketManagerHost>) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen)) {
+    return std::nullopt;
+  }
+  auto it = frontcap_scopes_.find(token);
+  if (it == frontcap_scopes_.end() || it->second.lifetime.expired() ||
+      it->second.client != client) {
+    return std::nullopt;
+  }
+  auto scope = std::move(it->second);
+  frontcap_scopes_.erase(it);
+  return scope;
+}
