+namespace {
+SharedClockRegistration* FindSharedProcess(CookieClockState* clock,
+                                         const std::string& renderer) {
+  for (const auto& [key, registration] : clock->shared_participants) {
+    if (key.second == renderer && registration->alive && !registration->retired && registration->confirmed &&
+        registration->process_control.is_bound()) return registration.get();
+  }
+  return nullptr;
+}
+bool SharedProcessHeld(CookieClockState* clock, const std::string& identity,
+                       const std::string& suspension) {
+  return clock && clock->shared_time.IsValid() &&
+      clock->shared_time.region.GetGUID().ToString() == identity &&
+      !suspension.empty() && clock->shared_suspension == suspension &&
+      !static_cast<blink::frontcap::SharedControl*>(clock->shared_control_mapping.memory())
+          ->failed.load(std::memory_order_acquire);
+}
+}  // namespace
+
+namespace {
+using OwnedFrameDocuments = std::vector<std::pair<int, std::string>>;
+OwnedFrameDocuments CaptureOwnedFrameDocuments(RenderFrameHostImpl* frame) {
+  OwnedFrameDocuments result;
+  if (!frame || frame->frame_tree_node()->current_frame_host() != frame)
+    return result;
+  std::vector<FrameTreeNode*> pending{frame->frame_tree_node()};
+  while (!pending.empty()) {
+    auto* node = pending.back();
+    pending.pop_back();
+    auto* current = node->current_frame_host();
+    if (!current || !current->GetProcess()->IsInitializedAndNotDead()) return {};
+    result.emplace_back(current->GetProcess()->GetDeprecatedID(),
+                        current->GetDocumentToken().ToString());
+    for (size_t i = 0; i < node->child_count(); ++i)
+      pending.push_back(node->child_at(i));
+  }
+  return result;
+}
+
+// The receiver lives on the browser UI sequence. Application callbacks execute
+// elsewhere; no shared_process_commands barrier or native clock guard spans them.
+class OwnedWorkerFrameCall : public std::enable_shared_from_this<OwnedWorkerFrameCall> {
+ public:
+  struct Route {
+    int process;
+    std::string renderer;
+    base::UnguessableToken binding;
+    std::vector<std::string> documents;
+  };
+  base::WeakPtr<CookieClockState> clock;
+  base::WeakPtr<RenderFrameHostImpl> owner;
+  OwnedFrameDocuments documents;
+  std::vector<Route> routes;
+  base::OnceCallback<void(bool, bool)> callback;
+  bool dispatch = false;
+  bool resume = false;
+  std::string receiver;
+  bool matched = false;
+  std::optional<bool> paused;
+  bool shared_active = false;
+  std::string shared_scope;
+  base::WeakPtr<PageHandler> shared_controller;
+  uint64_t opportunity = 0;
+  int64_t instant = 0;
+  size_t remaining = 0;
+  bool accepted = true;
+  bool pending = false;
+
+  bool Valid(bool beginning) const {
+    if (!clock || !owner || documents.empty() ||
+        CaptureOwnedFrameDocuments(owner.get()) != documents) return false;
+    const blink::frontcap::SharedControl* shared =
+        clock->shared_control_mapping.IsValid()
+            ? static_cast<const blink::frontcap::SharedControl*>(
+                  clock->shared_control_mapping.memory()) : nullptr;
+    const bool activated = shared && shared->activated.load(std::memory_order_acquire);
+    if (activated != shared_active) return false;
+    if (activated) {
+      // A frozen demand snapshot remains readable after its controller leaves.
+      // Only dispatch and pause/resume change callback permission and require
+      // the same live controller; document, clock, hold and route checks apply
+      // to observations too.
+      if (clock->shared_time.region.GetGUID().ToString() != shared_scope ||
+          ((dispatch || paused.has_value()) &&
+           (!shared_controller ||
+            clock->shared_controller.get() != shared_controller.get()))) return false;
+      if (shared->failed.load(std::memory_order_acquire)) return false;
+      const int64_t now = static_cast<const std::atomic<int64_t>*>(
+          clock->shared_time.mapping.memory())->load(std::memory_order_acquire);
+      if (now < instant || (beginning && now != instant)) return false;
+      // Reaching a finite publication bound also holds the shared instant.
+      if (beginning && clock->shared_suspension.empty() &&
+          clock->shared_bound != instant) return false;
+    }
+    for (const auto& route : routes) {
+      const auto found = clock->worker_frame_processes.find(route.process);
+      if (found == clock->worker_frame_processes.end()) return false;
+      const auto& process = *found->second;
+      if (process.renderer != route.renderer || process.binding != route.binding ||
+          !process.control.is_bound() || !process.control.is_connected()) return false;
+      if (activated) {
+        const auto member = clock->shared_participants.find({route.process, route.renderer});
+        if (member == clock->shared_participants.end() || !member->second->alive ||
+            !member->second->confirmed || member->second->retired ||
+            !shared->participants[member->second->handle.slot].armed.load(
+                std::memory_order_acquire)) return false;
+      } else {
+        const int64_t now = base::subtle::Acquire_Load(
+            static_cast<const base::subtle::Atomic64*>(process.mapping.memory()));
+        if (now < instant || (beginning && now != instant)) return false;
+      }
+    }
+    return true;
+  }
+
+  void Start() {
+    if (!Valid(true)) { std::move(callback).Run(false, false); return; }
+    remaining = routes.size();
+    CHECK(remaining);
+    for (const auto& route : routes) {
+      auto& process = *clock->worker_frame_processes.at(route.process);
+      process.control->WorkerFrames(route.renderer,
+          shared_active ? shared_scope : process.clock.GetGUID().ToString(),
+          route.documents, dispatch, resume,
+          opportunity, instant, paused, receiver, mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+              base::BindOnce(&OwnedWorkerFrameCall::Replied, shared_from_this()),
+              false, false, false));
+    }
+  }
+
+  void Replied(bool valid, bool wanted, bool found) {
+    // A callback may synchronously service a future answer. Preserve that
+    // progress while refusing document, process or authority replacement.
+    accepted &= valid && Valid(false);
+    pending |= wanted;
+    matched |= found;
+    --remaining;
+    if (callback && (!accepted || !remaining))
+      std::move(callback).Run(accepted && (!resume || matched), pending);
+  }
+};
+}  // namespace
+
+bool PageHandler::RegisterFrontcapWorkerFrameControl(RenderFrameHostImpl* frame,
+    const std::string& renderer_identity, base::ReadOnlySharedMemoryRegion region,
+    mojo::PendingRemote<blink::mojom::FrontcapProcessControl> process_control) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) ||
+      !base::FeatureList::IsEnabled(blink::features::kFrontcapVirtualWorkers) ||
+      !frame || renderer_identity.empty() || !region.IsValid() ||
+      !process_control.is_valid() || !frame->GetProcess()->IsInitializedAndNotDead())
+    return false;
+  auto mapping = region.Map();
+  if (!mapping.IsValid() || mapping.size() != sizeof(base::subtle::Atomic64)) return false;
+  auto* clock = CookieClockForFrame(frame);
+  const int process = frame->GetProcess()->GetDeprecatedID();
+  auto& existing = clock->worker_frame_processes[process];
+  if (existing && existing->renderer == renderer_identity &&
+      existing->clock.GetGUID() == region.GetGUID() &&
+      existing->control.is_bound() && existing->control.is_connected()) return true;
+  auto binding = std::make_unique<WorkerFrameProcess>();
+  binding->renderer = renderer_identity;
+  binding->clock = std::move(region);
+  binding->mapping = std::move(mapping);
+  binding->control.Bind(std::move(process_control));
+  existing = std::move(binding);
+  return true;
+}
+
+void PageHandler::RunFrontcapOwnedWorkerFrames(RenderFrameHostImpl* frame,
+    bool dispatch, int64_t unix_time_us, uint64_t control_opportunity,
+    std::optional<bool> paused, const std::string& receiver,
+    base::OnceCallback<void(bool, bool)> callback) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) ||
+      !base::FeatureList::IsEnabled(blink::features::kFrontcapVirtualWorkers) || !frame) {
+    std::move(callback).Run(false, false); return;
+  }
+  auto* clock = CookieClockForFrame(frame);
+  auto call = std::make_shared<OwnedWorkerFrameCall>();
+  call->clock = clock->weak_factory.GetWeakPtr();
+  call->owner = frame->GetWeakPtr();
+  call->documents = CaptureOwnedFrameDocuments(frame);
+  call->dispatch = dispatch;
+  call->paused = paused;
+  if (clock->shared_control_mapping.IsValid()) {
+    const auto* shared = static_cast<const blink::frontcap::SharedControl*>(
+        clock->shared_control_mapping.memory());
+    call->shared_active = shared->activated.load(std::memory_order_acquire);
+    if (call->shared_active) {
+      call->shared_scope = clock->shared_time.region.GetGUID().ToString();
+      call->shared_controller = clock->shared_controller;
+    }
+  }
+  call->instant = unix_time_us;
+  call->callback = std::move(callback);
+  // UI-sequence monotonicity plus worker lifetime identity rejects replay.
+  static uint64_t next_opportunity = 0;
+  CHECK_NE(next_opportunity, std::numeric_limits<uint64_t>::max());
+  if (paused && (dispatch || !control_opportunity)) {
+    std::move(call->callback).Run(false, false); return;
+  }
+  call->resume = dispatch && control_opportunity != 0;
+  if (call->resume != !receiver.empty() || receiver.size() > 128) {
+    std::move(call->callback).Run(false, false); return;
+  }
+  call->receiver = receiver;
+  call->opportunity = paused || call->resume ? control_opportunity
+                                           : (dispatch ? ++next_opportunity : 0);
+  std::map<int, std::vector<std::string>> by_process;
+  for (const auto& [process, document] : call->documents)
+    by_process[process].push_back(document);
+  for (auto& [process, documents] : by_process) {
+    const auto found = clock->worker_frame_processes.find(process);
+    if (found == clock->worker_frame_processes.end()) {
+      std::move(call->callback).Run(false, false); return;
+    }
+    call->routes.push_back({process, found->second->renderer,
+                           found->second->binding, std::move(documents)});
+  }
+  call->Start();
+}
+
+void PageHandler::FrontcapGetSharedProcess(const std::string& clock_id,
+    const std::string& renderer_id,
+    std::unique_ptr<FrontcapGetSharedProcessCallback> callback) {
+  if (!host_ || !base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen)) {
+    callback->sendFailure(Response::ServerError("controlled renderer target required")); return;
+  }
+  auto* clock = CookieClockForFrame(host_);
+  const auto suspension = clock->shared_suspension;
+  auto* process = FindSharedProcess(clock, renderer_id);
+  if (!SharedProcessHeld(clock, clock_id, suspension) || !process) {
+    callback->sendFailure(Response::InvalidParams("held clock and live process identity required")); return;
+  }
+  ++clock->shared_process_commands;
+  process->process_control->Snapshot(mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      base::BindOnce([](base::WeakPtr<CookieClockState> clock, std::string identity,
+          std::string renderer, std::string suspension,
+          std::unique_ptr<FrontcapGetSharedProcessCallback> callback,
+          std::optional<int64_t> arrival, bool pending,
+          std::vector<blink::mojom::FrontcapProcessWorkerPtr> workers) {
+        if (clock) --clock->shared_process_commands;
+        if (!SharedProcessHeld(clock.get(), identity, suspension) ||
+            !FindSharedProcess(clock.get(), renderer)) {
+          callback->sendFailure(Response::ServerError("shared process changed during snapshot")); return;
+        }
+        auto result = std::make_unique<protocol::Array<Page::FrontcapProcessWorker>>();
+        for (const auto& worker : workers) {
+          auto entry = Page::FrontcapProcessWorker::Create()
+              .SetTargetId(worker->target_id).SetCreatorId(worker->creator_id)
+              .SetCreatorIsWorker(worker->creator_is_worker)
+              .SetSequence(base::NumberToString(worker->sequence))
+              .SetScriptUrl(worker->script_url).SetThreadStarted(worker->thread_started).Build();
+          if (worker->synchronous_wait)
+            entry->SetSynchronousWaitId(base::NumberToString(worker->synchronous_wait));
+          if (worker->frame_opportunity)
+            entry->SetFrameOpportunity(base::NumberToString(worker->frame_opportunity));
+          result->push_back(std::move(entry));
+        }
+        std::optional<std::string> deadline;
+        if (arrival) deadline = base::NumberToString(*arrival);
+        callback->sendSuccess(std::move(deadline), pending, std::move(result));
+      }, clock->weak_factory.GetWeakPtr(), clock_id, renderer_id, suspension, std::move(callback)),
+      std::optional<int64_t>(), true, std::vector<blink::mojom::FrontcapProcessWorkerPtr>()));
+}
+
+void PageHandler::FrontcapSetSharedWorkerRequestPaused(const std::string& clock_id,
+    const std::string& suspension_id, const std::string& renderer_id,
+    const std::string& request_id, bool pauses,
+    std::unique_ptr<FrontcapSetSharedWorkerRequestPausedCallback> callback) {
+  if (!host_ || !base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen)) {
+    callback->sendFailure(Response::ServerError("controlled renderer target required")); return;
+  }
+  auto* clock = CookieClockForFrame(host_);
+  auto* process = FindSharedProcess(clock, renderer_id);
+  const auto dot = request_id.find('.');
+  uint64_t inspector = 0;
+  if (!SharedProcessHeld(clock, clock_id, suspension_id) || !process ||
+      clock->shared_controller.get() != this || dot == std::string::npos ||
+      !base::StringToUint64(std::string_view(request_id).substr(dot + 1), &inspector) || !inspector ||
+      request_id != process->request_prefix + base::NumberToString(inspector)) {
+    callback->sendFailure(Response::InvalidParams("current controller, hold, process and request required")); return;
+  }
+  ++clock->shared_process_commands;
+  process->process_control->SetLoadPaused(inspector, pauses, mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      base::BindOnce([](base::WeakPtr<CookieClockState> clock, std::string identity,
+          std::string renderer, std::string suspension,
+          std::unique_ptr<FrontcapSetSharedWorkerRequestPausedCallback> callback, bool found) {
+        if (clock) --clock->shared_process_commands;
+        if (!SharedProcessHeld(clock.get(), identity, suspension) ||
+            !FindSharedProcess(clock.get(), renderer) || !found) {
+          callback->sendFailure(Response::ServerError("registered synchronous worker load unavailable")); return;
+        }
+        callback->sendSuccess();
+      }, clock->weak_factory.GetWeakPtr(), clock_id, renderer_id, suspension_id, std::move(callback)), false));
+}
+
+// A renderer reports a document's commit to DevTools while the browser may
+// still be processing that commit. Until it finishes, this target's browser
+// commands address a frame that is not yet current. A client that saw
+// `frameNavigated` waits here for the browser alone.
+void PageHandler::FrontcapAwaitCommit(
+    const std::string& loader_id,
+    std::unique_ptr<FrontcapAwaitCommitCallback> callback) {
+  const std::optional<base::UnguessableToken> navigation =
+      base::UnguessableToken::DeserializeFromString(loader_id);
+  if (!navigation) {
+    callback->sendFailure(Response::InvalidParams("loaderId required"));
+    return;
+  }
+  auto* agent_host = host_ ? static_cast<RenderFrameDevToolsAgentHost*>(
+                                 RenderFrameDevToolsAgentHost::GetFor(host_))
+                           : nullptr;
+  if (!agent_host) {
+    callback->sendFailure(Response::ServerError(kErrorNotAttached));
+    return;
+  }
+  agent_host->AfterNavigationFinished(
+      *navigation,
+      base::BindOnce(
+          [](std::unique_ptr<FrontcapAwaitCommitCallback> callback) {
+            callback->sendSuccess();
+          },
+          std::move(callback)));
+}
+
+Response PageHandler::FrontcapGetDocumentPlaces(
+    std::unique_ptr<protocol::Array<Page::FrontcapDocumentPlace>>* documents) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) || !host_)
+    return Response::ServerError("document inventory requires a controlled renderer target");
+  *documents = std::make_unique<protocol::Array<Page::FrontcapDocumentPlace>>();
+  std::vector<std::pair<FrameTreeNode*, std::vector<int>>> pending;
+  pending.emplace_back(host_->frame_tree_node(), std::vector<int>{});
+  while (!pending.empty()) {
+    auto [node, path] = std::move(pending.back());
+    pending.pop_back();
+    auto indices = std::make_unique<protocol::Array<int>>();
+    for (int index : path) indices->emplace_back(index);
+    (*documents)->emplace_back(Page::FrontcapDocumentPlace::Create()
+        .SetDocumentId(node->current_frame_host()->GetDocumentToken().ToString())
+        .SetFramePath(std::move(indices)).Build());
+    for (size_t index = 0; index < node->child_count(); ++index) {
+      auto child_path = path;
+      child_path.push_back(base::checked_cast<int>(index));
+      pending.emplace_back(node->child_at(index), std::move(child_path));
+    }
+  }
+  return Response::Success();
+}
+
+Response PageHandler::FrontcapGetStorageClock(std::string* unix_time_us) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen))
+    return Response::ServerError("storage clock requires controlled engine");
+  auto target = FrontcapDialogContents(host_);
+  if (std::holds_alternative<Response>(target)) return std::get<Response>(target);
+  auto* clock = CookieClockForFrame(host_);
+  if (clock->binding_pending || !clock->region.IsValid())
+    return Response::ServerError("storage clock binding is not ready");
+  auto mapping = clock->region.Map();
+  if (!mapping.IsValid() || mapping.size() != sizeof(base::subtle::Atomic64))
+    return Response::ServerError("storage clock is not readable");
+  const auto* value = static_cast<const base::subtle::Atomic64*>(mapping.memory());
+  *unix_time_us = base::NumberToString(base::subtle::Acquire_Load(value));
+  return Response::Success();
+}
+
+Response PageHandler::FrontcapGetStreamReports(
+    std::unique_ptr<protocol::Array<Page::FrontcapStreamReport>>* receipts) {
+  auto result = FrontcapDialogContents(host_);
+  if (std::holds_alternative<Response>(result))
+    return std::get<Response>(result);
+  *receipts = std::make_unique<protocol::Array<Page::FrontcapStreamReport>>();
+  if (auto* state = DialogState(std::get<WebContentsImpl*>(result))) {
+    for (const auto& receipt : state->stream_reports) {
+      (*receipts)->emplace_back(Page::FrontcapStreamReport::Create()
+          .SetReceiptId(receipt.id).SetFrameId(receipt.frame)
+          .SetDocumentId(receipt.document).SetUnixTimeUs(receipt.unix_time_us)
+          .SetPayload(receipt.payload).Build());
+    }
+  }
+  return Response::Success();
+}
+
+Response PageHandler::FrontcapForgetStreamReports(
+    std::unique_ptr<protocol::Array<std::string>> receipt_ids) {
+  auto result = FrontcapDialogContents(host_);
+  if (std::holds_alternative<Response>(result))
+    return std::get<Response>(result);
+  if (auto* state = DialogState(std::get<WebContentsImpl*>(result))) {
+    std::erase_if(state->stream_reports, [&](const NativeStreamReport& receipt) {
+      return std::ranges::find(*receipt_ids, receipt.id) != receipt_ids->end();
+    });
+  }
+  return Response::Success();
+}
+
+void PageHandler::RetainFrontcapException(RenderFrameHostImpl* frame,
+                                         int64_t unix_time_us,
+                                         const std::u16string& text) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen))
+    return;
+  auto* contents = static_cast<WebContentsImpl*>(WebContents::FromRenderFrameHost(frame));
+  if (auto* state = DialogState(contents, true)) {
+    state->exceptions.push_back({base::UnguessableToken::Create().ToString(),
+                                 frame->devtools_frame_token().ToString(),
+                                 base::NumberToString(unix_time_us),
+                                 base::UTF16ToUTF8(text)});
+  }
+}
+
+Response PageHandler::FrontcapGetExceptions(
+    std::unique_ptr<protocol::Array<Page::FrontcapException>>* receipts) {
+  auto result = FrontcapDialogContents(host_);
+  if (std::holds_alternative<Response>(result))
+    return std::get<Response>(result);
+  *receipts = std::make_unique<protocol::Array<Page::FrontcapException>>();
+  if (auto* state = DialogState(std::get<WebContentsImpl*>(result))) {
+    for (const auto& receipt : state->exceptions) {
+      (*receipts)->emplace_back(Page::FrontcapException::Create()
+          .SetExceptionId(receipt.id).SetFrameId(receipt.frame)
+          .SetUnixTimeUs(receipt.unix_time_us).SetText(receipt.text).Build());
+    }
+  }
+  return Response::Success();
+}
+
+Response PageHandler::FrontcapForgetExceptions(
+    std::unique_ptr<protocol::Array<std::string>> exception_ids) {
+  auto result = FrontcapDialogContents(host_);
+  if (std::holds_alternative<Response>(result))
+    return std::get<Response>(result);
+  if (auto* state = DialogState(std::get<WebContentsImpl*>(result))) {
+    std::erase_if(state->exceptions, [&](const NativeExceptionReceipt& receipt) {
+      return std::ranges::find(*exception_ids, receipt.id) != exception_ids->end();
+    });
+  }
+  return Response::Success();
+}
