+void InspectorCacheStorageAgent::frontcapEnsureBucket(
+    const String& storage_key,
+    const String& bucket_name,
+    std::unique_ptr<FrontcapEnsureBucketCallback> callback) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen)) {
+    callback->sendFailure(ProtocolResponse::ServerError("frontcap storage control is disabled"));
+    return;
+  }
+  LocalFrame* frame = frames_->FrameWithStorageKey(storage_key);
+  if (!frame || !frame->DomWindow()->GetSecurityOrigin()->CanAccessStorageBuckets()) {
+    callback->sendFailure(ProtocolResponse::InvalidParams("Expected an enrolled storage-bucket context"));
+    return;
+  }
+  bool valid = !bucket_name.empty() && bucket_name.length() < 64;
+  for (wtf_size_t i = 0; i < bucket_name.length(); ++i) {
+    const auto c = bucket_name[i];
+    valid &= (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
+             (i > 0 && (c == '-' || c == '_'));
+  }
+  if (!valid) {
+    callback->sendFailure(ProtocolResponse::InvalidParams("Invalid storage bucket name"));
+    return;
+  }
+  auto it = bucket_managers_.find(storage_key);
+  HeapMojoRemote<mojom::blink::BucketManagerHost>* manager;
+  if (it == bucket_managers_.end() || !it->value->Value().is_bound()) {
+    HeapMojoRemote<mojom::blink::BucketManagerHost> remote(frame->DomWindow());
+    frame->DomWindow()->GetBrowserInterfaceBroker().GetInterface(
+        remote.BindNewPipeAndPassReceiver(frame->GetTaskRunner(TaskType::kInternalInspector)));
+    auto inserted = bucket_managers_.Set(storage_key, WrapDisallowNew(std::move(remote)));
+    manager = &inserted.stored_value->value->Value();
+  } else {
+    manager = &it->value->Value();
+  }
+  manager->get()->OpenBucket(bucket_name, mojom::blink::BucketPolicies::New(),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(blink::BindOnce(
+          [](std::unique_ptr<FrontcapEnsureBucketCallback> callback,
+             mojo::PendingRemote<mojom::blink::BucketHost> remote,
+             mojom::blink::BucketError) {
+            if (!remote.is_valid()) {
+              callback->sendFailure(ProtocolResponse::ServerError("Storage bucket creation failed"));
+              return;
+            }
+            callback->sendSuccess();
+          }, std::move(callback)),
+          mojo::PendingRemote<mojom::blink::BucketHost>(), mojom::blink::BucketError::kUnknown));
+}
