+    if (!IsValidHTTPToken(name) || !IsValidHTTPHeaderValue(header->getValue()) ||
+        name.length() > 1024 || header->getValue().length() > 8192 ||
+        !names.insert(name).is_new_entry) return nullptr;
+    request->headers.Set(name, header->getValue());
+  }
+  return request;
+}
+bool CacheEntryAbsent(mojom::blink::CacheStorageError error) {
+  return error == mojom::blink::CacheStorageError::kErrorNotFound ||
+         error == mojom::blink::CacheStorageError::kErrorCacheNameNotFound;
+}
