+bool ProcessTimeOverrideCoordinator::FrontcapSharedHoldLocked() {
+  if (FrontcapSharedRetiredLocked()) return false;
+  const auto* now = frontcap_shared_now_.load(std::memory_order_acquire);
+  if (!now) return false;
+  auto& state = *static_cast<frontcap::SharedControl*>(frontcap_shared_control_mapping_.memory());
+  frontcap::ParticipantClock clock(state, *now);
+  const frontcap::Handle handle{state.scope, frontcap_shared_slot_, frontcap_shared_participant_};
+  const auto deadline = base::subtle::TimeTicksNowIgnoringOverride() + base::Seconds(5);
+  for (;;) {
+    const auto held = frontcap::Hold(clock, handle);
+    if (held.status == frontcap::Status::ok) {
+      frontcap_shared_revision_ = held.revision;
+      return true;
+    }
+    if (held.status == frontcap::Status::stale && FrontcapSharedRetiredLocked()) return false;
+    // A task must not be timestamped/enqueued unless its hold has been acquired.
+    // Confirmed death poisons the region without needing this guard. An authority
+    // that stays unresponsive also fails this execution instead of allowing work.
+    CHECK(held.status == frontcap::Status::busy);
+    CHECK_LT(base::subtle::TimeTicksNowIgnoringOverride(), deadline);
+    base::PlatformThread::YieldCurrentThread();
+  }
+}
