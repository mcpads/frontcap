+
+void LocalStorageImpl::RestoreEmptyAreaConnected(
+    const blink::StorageKey& storage_key, SnapshotEntries entries,
+    RestoreEmptyAreaCallback callback) {
+  if (snapshot_inventory_error_ || !database_) {
+    std::move(callback).Run("Local storage backend is unavailable or recovered");
+    return;
+  }
