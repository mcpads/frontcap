+protocol::Response InspectorEmulationAgent::frontcapPrepareSharedClock(
+    String* clock_id, String* participant_id, String* unix_time_us) {
+  if (!web_local_frame_ || !web_local_frame_->GetFrame() ||
+      !base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen) ||
+      !virtual_time_controller_->FrontcapIsVirtualTimeEnabled() ||
+      virtual_time_controller_->VirtualTimeAllowedToAdvance()) {
+    return protocol::Response::ServerError("shared clock preparation requires a paused controlled page");
+  }
+  const int64_t now = (base::Time::Now() - base::Time::UnixEpoch()).InMicroseconds();
+  base::ReadOnlySharedMemoryRegion time;
+  base::UnsafeSharedMemoryRegion control;
+  uint32_t slot = 0;
+  uint64_t participant = 0;
+  if (!web_local_frame_->GetFrame()->GetLocalFrameHostRemote().FrontcapPrepareSharedClock(
+          String::FromUtf8(FrontcapRendererIdentity().ToString()), now,
+          &time, &control, &slot, &participant) || !time.IsValid()) {
+    return protocol::Response::ServerError("shared clock transport preparation failed");
+  }
+  const std::string identity = time.GetGUID().ToString();
+  const bool accepted = scheduler::ProcessTimeOverrideCoordinator::FrontcapPrepareSharedClock(
+      std::move(time), std::move(control), slot, participant);
+  bool confirmed = false;
+  const bool replied = web_local_frame_->GetFrame()->GetLocalFrameHostRemote().FrontcapConfirmSharedClock(
+      String::FromUtf8(FrontcapRendererIdentity().ToString()), String::FromUtf8(identity),
+      participant, accepted, accepted ? MakeFrontcapProcessControl()
+                                      : mojo::PendingRemote<mojom::blink::FrontcapProcessControl>(),
+      &confirmed);
+  if (!accepted)
+    return protocol::Response::ServerError("shared clock transport did not match renderer state");
+  if (!replied || !confirmed)
+    return protocol::Response::ServerError("shared clock registration was not confirmed");
+  *clock_id = String::FromUtf8(identity);
+  *participant_id = String::Number(participant);
+  *unix_time_us = String::Number(now);
+  return protocol::Response::Success();
+}
