+
+void WorkerAnimationFrameProvider::FrontcapRequestFreshFrame(uint64_t opportunity) {
+  if (!opportunity || opportunity != frontcap_opportunity_) return;
+  if (!FrontcapWorkerFrameIsCurrent(frontcap_worker_, frontcap_opportunity_)) {
+    FrontcapCompleteFrame(frontcap_opportunity_, false);
+    return;
+  }
+  if (FrontcapDeferWorkerFrame(frontcap_worker_, opportunity, base::BindOnce(
+          [](CrossThreadPersistent<WorkerAnimationFrameProvider> provider, uint64_t ticket) {
+            if (provider) provider->FrontcapRequestFreshFrame(ticket);
+          }, WrapCrossThreadWeakPersistent(this), opportunity))) return;
+  frontcap_requested_after_ = base::subtle::TimeTicksNowIgnoringOverride();
+  begin_frame_provider_->RequestBeginFrame();
