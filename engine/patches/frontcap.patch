+using StoredResponseMetadata = protocol::CacheStorage::FrontcapResponseMetadata;
+std::unique_ptr<StoredResponseMetadata> ResponseMetadata(
+    const mojom::blink::FetchAPIResponse& response) {
+  auto urls = std::make_unique<protocol::Array<String>>();
+  for (const auto& url : response.url_list) urls->push_back(url.GetString());
+  auto exposed = std::make_unique<protocol::Array<String>>();
+  for (const auto& name : response.cors_exposed_header_names) exposed->push_back(name);
+  auto result = StoredResponseMetadata::create()
+      .setResponseType(ResponseTypeToString(response.response_type))
+      .setResponseURLs(std::move(urls))
+      .setCorsExposedHeaderNames(std::move(exposed))
+      .setResponseTime(String::Number(response.response_time.ToInternalValue()))
+      .setPadding(String::Number(response.padding))
+      .setConnectionInfo(static_cast<int>(response.connection_info))
+      .setAlpnNegotiatedProtocol(response.alpn_negotiated_protocol)
+      .setWasFetchedViaSpdy(response.was_fetched_via_spdy)
+      .setRequestIncludeCredentials(response.request_include_credentials).build();
+  if (!response.mime_type.IsNull()) result->setMimeType(response.mime_type);
+  if (!response.request_method.IsNull()) result->setRequestMethod(response.request_method);
+  return result;
+}
+
+bool RestoreResponseMetadata(StoredResponseMetadata& metadata,
+                             mojom::blink::FetchAPIResponse& response) {
+  using Type = network::mojom::FetchResponseType;
+  const String type = metadata.getResponseType();
+  if (type == "default") response.response_type = Type::kDefault;
+  else if (type == "basic") response.response_type = Type::kBasic;
+  else if (type == "cors") response.response_type = Type::kCors;
+  else if (type == "opaqueResponse") response.response_type = Type::kOpaque;
+  else if (type == "opaqueRedirect") response.response_type = Type::kOpaqueRedirect;
+  else return false;  // Cache.put cannot store a network-error response.
+  int64_t time = 0, padding = 0;
+  if (!base::StringToInt64(metadata.getResponseTime().Utf8(), &time) ||
+      String::Number(time) != metadata.getResponseTime() ||
+      !base::StringToInt64(metadata.getPadding().Utf8(), &padding) ||
+      String::Number(padding) != metadata.getPadding() || padding < 0 ||
+      padding >= 32 * 1024 * 1024 || metadata.getConnectionInfo() < 0 ||
+      metadata.getConnectionInfo() > static_cast<int>(net::HttpConnectionInfo::kMaxValue) ||
+      metadata.getAlpnNegotiatedProtocol().length() > 1024 ||
+      !IsValidHTTPHeaderValue(metadata.getAlpnNegotiatedProtocol()) ||
+      metadata.getResponseURLs()->size() > 20 ||
+      metadata.getCorsExposedHeaderNames()->size() > 64) return false;
+  const bool opaque = response.response_type == Type::kOpaque || response.response_type == Type::kOpaqueRedirect;
+  if (!opaque && padding != 0) return false;
+  for (const auto& text : *metadata.getResponseURLs()) {
+    const KURL url(text);
+    if (text.length() > 8192 || !url.IsValid() || !url.ProtocolIsInHttpFamily() ||
+        !url.User().empty() || !url.Pass().empty() || url.HasFragmentIdentifier() ||
+        url.GetString() != text) return false;
+    response.url_list.push_back(url);
+  }
+  if (response.response_type != Type::kDefault && response.url_list.empty()) return false;
+  for (const auto& name : *metadata.getCorsExposedHeaderNames()) {
+    if (!IsValidHTTPToken(name) || name.length() > 1024) return false;
+    response.cors_exposed_header_names.push_back(name);
+  }
+  response.mime_type = metadata.getMimeType(String());
+  response.request_method = metadata.getRequestMethod(String());
+  if ((!response.mime_type.IsNull() && (response.mime_type.length() > 1024 ||
+                                       !IsValidHTTPHeaderValue(response.mime_type))) ||
+      (!response.request_method.IsNull() && (response.request_method.length() > 32 ||
+                                            !IsValidHTTPToken(response.request_method)))) return false;
+  response.response_time = base::Time::FromInternalValue(time);
+  response.padding = padding;
+  response.connection_info = static_cast<net::HttpConnectionInfo>(metadata.getConnectionInfo());
+  response.alpn_negotiated_protocol = metadata.getAlpnNegotiatedProtocol();
+  response.was_fetched_via_spdy = metadata.getWasFetchedViaSpdy();
+  response.request_include_credentials = metadata.getRequestIncludeCredentials();
+  return true;
+}
