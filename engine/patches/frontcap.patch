+
+void ProcessTimeOverrideCoordinator::Hold(ScopedOverride* handle) {
+  base::AutoLock auto_lock(lock_);
+  // A posted task cannot run while this thread is inside Atomics.wait.
+  // Only its actual wake transition can make it runnable again.
+  if (handle->frontcap_atomic_waiting_ || handle->frontcap_arrival_waiting_) return;
+  FrontcapSharedHoldLocked();
+  handle->stalled_.store(false, std::memory_order_release);
+  auto client_it = requested_ticks_by_client_.find(handle);
+  if (client_it != requested_ticks_by_client_.end()) {
+    client_it->second = FrontcapVirtualTicks();
+  }
+  handle->holds_.fetch_add(1, std::memory_order_acq_rel);
+}
+
+bool ProcessTimeOverrideCoordinator::FrontcapBlockedLocked() const {
+  for (const auto& entry : frontcap_blocks_) {
+    if (entry.blocks > 0 && !entry.suspended) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Time moves to what every client asked for while it was blocked.
+void ProcessTimeOverrideCoordinator::FrontcapMaybeAdvanceLocked() {
+  if (frontcap_shared_now_.load(std::memory_order_acquire)) {
+    FrontcapSharedProposalLocked();
+    return;
+  }
+  if (FrontcapBlockedLocked() || requested_ticks_by_client_.empty()) {
+    return;
+  }
+  const auto previous_ticks = FrontcapVirtualTicks();
+  base::TimeTicks new_ticks = base::TimeTicks::Max();
+  for (const auto& entry : requested_ticks_by_client_) {
+    new_ticks = std::min(new_ticks, entry.second);
+  }
+  if (new_ticks > previous_ticks) {
+    PublishFrontcapCookieTime(new_ticks);
+    current_ticks_.store(new_ticks, std::memory_order_release);
+    for (const auto& entry : requested_ticks_by_client_) {
+      entry.first->ScheduleWork();
+    }
+  }
+}
+
+ProcessTimeOverrideCoordinator::FrontcapOwnerBlocks&
+ProcessTimeOverrideCoordinator::FrontcapBlocksForOwnerLocked(
+    base::PlatformThreadRef owner) {
+  for (auto& entry : frontcap_blocks_) {
+    if (entry.owner == owner) return entry;
+  }
+  bool suspended = false;
+  for (const auto& [client, ticks] : requested_ticks_by_client_) {
+    if (client->frontcap_atomic_waiting_ &&
+        client->frontcap_atomic_owner_ == owner) {
+      suspended = true;
+      break;
+    }
+  }
+  frontcap_blocks_.push_back({owner, 0, suspended});
+  return frontcap_blocks_.back();
+}
