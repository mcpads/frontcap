+bool Database::WaitsForUnfinishedTransaction(
+    Transaction* transaction,
+    std::vector<PartitionedLockManager::PartitionedLockRequest>&
+        lock_requests) {
+  std::vector<PartitionedLockId> blocked =
+      lock_manager().GetUnacquirableLocks(lock_requests);
+  if (blocked.empty()) {
+    return false;
+  }
+  // A conflicting transaction that holds or queues for a blocked lock and has not
+  // been told to commit needs its client to run before it releases.
+  for (Connection* connection : connections_) {
+    for (const auto& [_, other] : connection->transactions()) {
+      if (other.get() == transaction ||
+          other->is_commit_pending() ||
+          (other->state() != Transaction::CREATED &&
+           other->state() != Transaction::STARTED)) {
+        continue;
+      }
+      for (const auto& request :
+           BuildLockRequestsForTransaction(other->mode(), other->scope())) {
+        if ((request.type == PartitionedLockManager::LockType::kExclusive ||
+             transaction->mode() != blink::mojom::IDBTransactionMode::ReadOnly) &&
+            std::ranges::find(blocked, request.lock_id) != blocked.end()) {
+          return true;
+        }
+      }
+    }
+  }
+  return false;
+}
