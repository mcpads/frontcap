+  auto& coordinator = ProcessTimeOverrideCoordinator::Instance();
+  base::AutoLock auto_lock(coordinator.lock_);
+  if (holds_.load(std::memory_order_acquire) == hold_count) {
+    stalled_.store(true, std::memory_order_release);
+  }
