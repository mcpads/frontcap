+  if (frontcap_batch_canvases_.empty()) {
+    FrontcapCompleteFrame(frontcap_opportunity_, true);
+    return;
+  }
+  auto done = base::BarrierCallback<bool>(frontcap_batch_canvases_.size(),
+      BindOnce([](WeakPersistent<WorkerAnimationFrameProvider> provider,
+                  uint64_t opportunity, const std::vector<bool>& delivered) {
+        if (provider)
+          provider->FrontcapCompleteFrame(opportunity, std::ranges::all_of(
+              delivered, [](bool value) { return value; }));
