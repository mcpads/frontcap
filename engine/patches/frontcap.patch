+// frontcap engine patch 6: with FrontcapFramesWhileFrozen the page's main frames are held back (cc's
+// gate) except one at a time an automation lets run, so rendering (animations, their events,
+// animation-frame callbacks) happens at the instants it chooses. Answers once that frame has run, or at
+// once when the page asked for none or none can run (rendering then would change nothing).
+void InspectorEmulationAgent::frontcapDrainCurrentTasks(
+    std::unique_ptr<FrontcapDrainCurrentTasksCallback> callback) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen) ||
+      !virtual_time_controller_->FrontcapIsVirtualTimeEnabled()) {
+    callback->sendFailure(protocol::Response::ServerError(
+        "controlled virtual time is required"));
+    return;
+  }
+  // Worker evaluation receipts use the parent's loading queue. Finish those
+  // ready callbacks before deciding that all enrolled workers are idle.
+  // Reserve HashMap's empty and deleted keys; never reuse a retired ticket.
+  CHECK_LT(frontcap_next_request_frontier_,
+           std::numeric_limits<uint64_t>::max() - 1);
+  const uint64_t frontier = ++frontcap_next_request_frontier_;
+  frontcap_request_frontiers_.insert(
+      frontier, virtual_time_controller_->FrontcapAdmitServiceTasks());
+  FrontcapFinishRequestFrontier(std::move(callback), frontier);
+}
+
+void InspectorEmulationAgent::FrontcapFinishRequestFrontier(
+    std::unique_ptr<FrontcapDrainCurrentTasksCallback> callback,
+    uint64_t frontier) {
+  if (!frontcap_request_frontiers_.Contains(frontier)) {
+    callback->sendFailure(protocol::Response::ServerError(
+        "request frontier cancelled"));
+    return;
+  }
+  if (!base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen) ||
+      !virtual_time_controller_->FrontcapIsVirtualTimeEnabled()) {
+    frontcap_request_frontiers_.erase(frontier);
+    callback->sendFailure(protocol::Response::ServerError(
+        "controlled virtual time is required"));
+    return;
+  }
+  // Read the other participants first: an idle vote follows their last posted
+  // task. Admit that task before examining this thread's queues. Pending loads
+  // and future deadlines are deliberately excluded: the caller is collecting
+  // requests to answer, not waiting for answers it has not chosen yet.
+  const bool others_due = virtual_time_controller_->FrontcapOtherThreadsDue(
+      /*include_worker_enrollment=*/true);
+  virtual_time_controller_->FrontcapAdmitTasksOfThisInstant();
+  const bool local_due = virtual_time_controller_->FrontcapTaskCanRunNow();
+  if (others_due || local_due) {
+    if (!local_due) base::PlatformThread::Sleep(base::Milliseconds(1));
+    virtual_time_controller_->FrontcapPostAfterReadyTasks(
+        blink::BindOnce(&InspectorEmulationAgent::FrontcapFinishRequestFrontier,
+                 WrapWeakPersistent(this), std::move(callback), frontier));
+    return;
+  }
+  frontcap_request_frontiers_.erase(frontier);
+  callback->sendSuccess(String::Number(
+      (base::Time::Now() - base::Time::UnixEpoch()).InMicroseconds()));
+}
