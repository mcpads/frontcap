+HeapVector<Member<Node>> AXObjectCacheImpl::FrontcapQueryRole(
+    Document& document, const String& role, const std::optional<String>& name) {
+  UpdateAXForAllDocuments();
+  ScopedFreezeAXCache freeze(*this);
+  DocumentLifecycle::DisallowTransitionScope disallow(document.Lifecycle());
+  HeapVector<Member<Node>> result;
+  HeapVector<Member<AXObject>> reachable;
+  if (AXObject* root = Get(&document))
+    reachable.push_back(root);
+  while (!reachable.empty()) {
+    AXObject* object = reachable.back();
+    reachable.pop_back();
+    if (object->IsDetached() || !object->IsIncludedInTree())
+      continue;
+    Node* node = object->GetNode();
+    // Child documents are queried separately by the observer's scoped traversal.
+    if (node && &node->GetDocument() != &document)
+      continue;
+    reachable.append_range(base::Reversed(object->ChildrenIncludingIgnored()));
+    if (!node || object->IsIgnored())
+      continue;
+    ui::AXNodeData data;
+    object->Serialize(&data, ui::kAXModeInspector);
+    if (role != AXObject::RoleName(data.role))
+      continue;
+    if (name && name->Utf8() != data.GetStringAttribute(
+                                  ax::mojom::blink::StringAttribute::kName))
+      continue;
+    result.push_back(node);
+  }
+  return result;
+}
