+  String name_;
+  int64_t version_;
+  std::unique_ptr<Callback> callback_;
+  base::OnceClosure completion_;
+  Vector<Store> stores_;
+  HeapMojoAssociatedReceiver<mojom::blink::IDBFactoryClient, IDBInitialization>
