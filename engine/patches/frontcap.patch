+bool PageHandler::FrontcapControlsDialogs(WebContentsImpl* contents) {
+  auto* state = DialogState(contents);
+  return state && state->enabled;
+}
+
+void PageHandler::PrepareFrontcapDialog(RenderFrameHostImpl* frame,
+                                        int64_t unix_time_us) {
+  auto* contents =
+      static_cast<WebContentsImpl*>(WebContents::FromRenderFrameHost(frame));
+  if (auto* state = DialogState(contents); state && state->enabled) {
+    state->opening_times[frame->devtools_frame_token().ToString()] =
+        base::NumberToString(unix_time_us);
+  }
+}
+
+void PageHandler::RetainFrontcapDialog(WebContentsImpl* contents,
+                                       RenderFrameHostImpl* frame,
+                                       const std::string& type,
+                                       const std::u16string& message,
+                                       const std::u16string& default_prompt,
+                                       JavaScriptDialogCallback callback) {
+  auto* state = DialogState(contents);
+  if (!state || !state->enabled) {
+    return;
+  }
+  CHECK(!state->pending);
+  NativeDialog dialog{base::UnguessableToken::Create().ToString(),
+                      frame->devtools_frame_token().ToString(),
+                      frame->GetLastCommittedURL().spec(),
+                      type,
+                      base::UTF16ToUTF8(message),
+                      base::UTF16ToUTF8(default_prompt),
+                      std::nullopt, {}, {}};
+  // Capture source identity at opening, while the original document still owns
+  // the callback. Inspector tokens cannot address a frame in a replay generation.
+  for (auto* source = frame; source; source = source->GetParent()) {
+    dialog.frame_urls.push_back(source->GetLastCommittedURL().spec());
+    if (auto* parent = source->GetParent()) {
+      size_t index = 0;
+      while (index < parent->child_count() &&
+             parent->child_at(index) != source->frame_tree_node()) {
+        ++index;
+      }
+      CHECK_LT(index, parent->child_count());
+      dialog.frame_path.push_back(base::checked_cast<int>(index));
+    }
+  }
+  std::ranges::reverse(dialog.frame_path);
+  std::ranges::reverse(dialog.frame_urls);
+  auto time = state->opening_times.find(dialog.frame);
+  if (time != state->opening_times.end()) {
+    dialog.unix_time_us = std::move(time->second);
+    state->opening_times.erase(time);
+  }
+  state->pending = std::make_unique<PendingNativeDialog>(
+      PendingNativeDialog{std::move(dialog), std::move(callback)});
+}
+
+void PageHandler::CancelFrontcapDialog(WebContentsImpl* contents) {
+  auto* state = DialogState(contents);
+  if (!state || !state->pending) {
+    return;
+  }
+  auto pending = std::move(state->pending);
+  state->receipts.push_back({pending->dialog, std::nullopt, std::nullopt,
+                             "cancelled", false, std::string()});
+  std::move(pending->callback).Run(false, std::u16string());
+}
+
+void PageHandler::FrontcapDialogClosed(WebContentsImpl* contents,
+                                       bool success,
+                                       const std::u16string& user_input) {
+  auto* state = DialogState(contents);
+  if (!state || !state->pending) {
+    return;
+  }
+  // A non-controller owner closed the native dialog. Keep that distinct from a
+  // correlated answer and do not invoke its already-consumed callback again.
+  state->receipts.push_back({state->pending->dialog, std::nullopt, std::nullopt,
+                             "external", success,
+                             base::UTF16ToUTF8(user_input)});
+  state->pending.reset();
+}
+
+Response PageHandler::FrontcapSetDialogControl(bool enabled) {
+  if (!base::FeatureList::IsEnabled(
+          blink::features::kFrontcapFramesWhileFrozen)) {
+    return Response::ServerError(
+        "controlled dialogs are not enabled in this engine");
+  }
+  auto result = FrontcapDialogContents(host_);
+  if (std::holds_alternative<Response>(result)) {
+    return std::get<Response>(result);
+  }
+  auto* contents = std::get<WebContentsImpl*>(result);
+  auto* state = DialogState(contents, true);
+  if (enabled && !state->enabled && contents->IsJavaScriptDialogShowing())
+    return Response::InvalidParams("enable control before a native dialog opens");
+  if (!enabled && state->pending) {
+    return Response::InvalidParams(
+        "answer the pending dialog before disabling control");
+  }
+  state->enabled = enabled;
+  if (!enabled) {
+    state->opening_times.clear();
+  }
+  return Response::Success();
+}
+
+Response PageHandler::FrontcapGetDialogs(
+    bool* controlled,
+    std::unique_ptr<protocol::Array<Page::FrontcapDialog>>* dialogs,
+    std::unique_ptr<protocol::Array<Page::FrontcapDialogReceipt>>* receipts) {
+  auto result = FrontcapDialogContents(host_);
+  if (std::holds_alternative<Response>(result)) {
+    return std::get<Response>(result);
+  }
+  *dialogs = std::make_unique<protocol::Array<Page::FrontcapDialog>>();
+  *receipts = std::make_unique<protocol::Array<Page::FrontcapDialogReceipt>>();
+  auto* state = DialogState(std::get<WebContentsImpl*>(result));
+  *controlled = state && state->enabled;
+  if (state) {
+    if (state->pending) {
+      (*dialogs)->push_back(DescribeDialog(state->pending->dialog));
+    }
+    for (const auto& receipt : state->receipts) {
+      (*receipts)->push_back(DescribeDialogReceipt(receipt));
+    }
+  }
+  return Response::Success();
+}
+
+Response PageHandler::FrontcapAnswerDialog(
+    const std::string& dialog_id,
+    const std::string& request_id,
+    bool accept,
+    std::optional<std::string> prompt_text,
+    std::unique_ptr<Page::FrontcapDialogReceipt>* receipt) {
+  if (request_id.empty() || request_id.size() > 128) {
+    return Response::InvalidParams("requestId must contain 1 to 128 bytes");
+  }
+  auto result = FrontcapDialogContents(host_);
+  if (std::holds_alternative<Response>(result)) {
+    return std::get<Response>(result);
+  }
+  auto* state = DialogState(std::get<WebContentsImpl*>(result));
+  if (!state) {
+    return Response::InvalidParams("no controlled dialog");
+  }
+  for (const auto& prior : state->receipts) {
+    if (prior.request_id == request_id) {
+      if (prior.dialog.id != dialog_id || prior.accept != accept ||
+          prior.requested_prompt != prompt_text) {
+        return Response::InvalidParams(
+            "requestId was used with different arguments");
+      }
+      *receipt = DescribeDialogReceipt(prior);
+      return Response::Success();
+    }
+  }
+  if (!state->enabled || !state->pending ||
+      state->pending->dialog.id != dialog_id) {
+    return Response::InvalidParams(
+        "dialogId is not the pending controlled dialog");
+  }
+  const auto& dialog = state->pending->dialog;
+  const bool prompt = dialog.type == Page::DialogTypeEnum::Prompt;
+  if (prompt_text && (!prompt || !accept)) {
+    return Response::InvalidParams("promptText requires an accepted prompt");
+  }
+  std::string answer = prompt && accept
+                           ? prompt_text.value_or(dialog.default_prompt)
+                           : std::string();
+  NativeDialogReceipt recorded{dialog,     request_id, prompt_text,
+                               "answered", accept,     answer};
+  // Publish the receipt before resuming the renderer. Losing this DevTools
+  // session after the callback cannot erase the applied answer or repeat it.
+  state->receipts.push_back(recorded);
+  *receipt = DescribeDialogReceipt(recorded);
+  auto pending = std::move(state->pending);
+  std::move(pending->callback).Run(accept, base::UTF8ToUTF16(answer));
+  return Response::Success();
+}
+
+Response PageHandler::FrontcapForgetDialogReceipts(
+    std::unique_ptr<protocol::Array<std::string>> dialog_ids) {
+  auto result = FrontcapDialogContents(host_);
+  if (std::holds_alternative<Response>(result)) {
+    return std::get<Response>(result);
+  }
+  auto* state = DialogState(std::get<WebContentsImpl*>(result));
+  if (state) {
+    std::erase_if(state->receipts, [&](const NativeDialogReceipt& receipt) {
+      return std::ranges::find(*dialog_ids, receipt.dialog.id) !=
+             dialog_ids->end();
+    });
+  }
+  return Response::Success();
+}
