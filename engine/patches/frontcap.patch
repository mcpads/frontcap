+bool RenderProcessHostImpl::FrontcapAwaitDomStorageWrites(
+    std::optional<bool> confirmed) {
+  if (!base::FeatureList::IsEnabled(
+          blink::features::kFrontcapFramesWhileFrozen) ||
+      are_ref_counts_disabled_ || !storage_partition_impl_ ||
+      dom_storage_receiver_ids_.empty() || !IsInitializedAndNotDead()) {
+    return false;
