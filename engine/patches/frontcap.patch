+FrontcapStartBlock::FrontcapStartBlock(bool wait_for_script)
+    : wait_for_script_(wait_for_script),
+      owner_(base::PlatformThread::CurrentRef()) {
+  scheduler::FrontcapBeginWorkerEnrollment(owner_);
+  scheduler::FrontcapBlockProcessVirtualTime(owner_);
+}
+
+FrontcapStartBlock::~FrontcapStartBlock() {
+  Lift();
+}
+
+void FrontcapStartBlock::Disown() {
+  if (owner_ == base::PlatformThreadRef() ||
+      !held_.load(std::memory_order_acquire)) {
+    return;
+  }
+  // Before the thread starts, move both holds without an empty interval.
+  if (enrolling_.load(std::memory_order_acquire)) {
+    scheduler::FrontcapBeginWorkerEnrollment(base::PlatformThreadRef());
+    scheduler::FrontcapEndWorkerEnrollment(owner_);
+  }
+  scheduler::FrontcapBlockProcessVirtualTime(base::PlatformThreadRef());
+  scheduler::FrontcapUnblockProcessVirtualTime(owner_);
+  owner_ = base::PlatformThreadRef();
+}
+
+void FrontcapStartBlock::Joined() {
+  // Network script bodies remain an external decision after the thread has
+  // joined. A local Blob/data body must arrive before its runnable work can
+  // be collected, but imports requested by that body are external decisions.
+  if (!wait_for_script_) EndEnrollment();
+}
+
+void FrontcapStartBlock::EndEnrollment() {
+  if (enrolling_.exchange(false, std::memory_order_acq_rel))
+    scheduler::FrontcapEndWorkerEnrollment(owner_);
+}
+
+void FrontcapStartBlock::Lift() {
+  EndEnrollment();
+  if (held_.exchange(false, std::memory_order_acq_rel)) {
+    scheduler::FrontcapUnblockProcessVirtualTime(owner_);
+  }
+}
+
+void DedicatedWorkerObjectProxy::FrontcapWillRunScripts() {
+  if (frontcap_start_block_) frontcap_start_block_->Joined();
+  // The worker holds time for its own work now (WorkerThread): the parent stops
+  // counting its start.
+  PostCrossThreadTask(
+      *GetParentExecutionContextTaskRunners()->Get(TaskType::kInternalLoading),
+      FROM_HERE,
+      CrossThreadBindOnce(&DedicatedWorkerMessagingProxy::FrontcapWorkerJoined,
+                          messaging_proxy_weak_ptr_));
+}
+
+void DedicatedWorkerObjectProxy::FrontcapDidLoadMainScript() {
+  if (frontcap_start_block_) {
+    frontcap_start_block_->Lift();
+  }
+}
+
+void DedicatedWorkerObjectProxy::DidTerminateWorkerThread() {
+  if (frontcap_start_block_) {
+    frontcap_start_block_->Lift();
+  }
+  ThreadedObjectProxyBase::DidTerminateWorkerThread();
+}
