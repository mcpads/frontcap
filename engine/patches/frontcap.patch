+void QuotaManagerImpl::FrontcapRestoreBucket(
+    const BucketInitParams& params,
+    base::OnceCallback<void(QuotaErrorOr<BucketInfo>)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  EnsureDatabaseOpened();
+  if (db_disabled_) {
+    std::move(callback).Run(base::unexpected(QuotaError::kDatabaseDisabled));
+    return;
+  }
+  // Restoring an expired policy must not implicitly delete its saved data.
+  // Ordinary page reads retain the usual expiration behavior afterward.
+  GetQuotaSettings(
+      base::BindOnce(&QuotaManagerImpl::DidGetQuotaSettingsForFrontcapRestore,
+                     weak_factory_.GetWeakPtr(), params, std::move(callback)));
+}
+
+void QuotaManagerImpl::DidGetQuotaSettingsForFrontcapRestore(
+    const BucketInitParams& params,
+    base::OnceCallback<void(QuotaErrorOr<BucketInfo>)> callback,
+    const QuotaSettings& settings) {
+  const int64_t quota = GetQuotaForStorageKey(params.storage_key, settings);
+  const int64_t max_buckets =
+      (params.name == kDefaultBucketName || quota == kNoLimit)
+          ? 0
+          : std::max(int64_t{1}, quota / kTypicalBucketUsage);
+  PostTaskAndReplyWithResultForDBThread(
+      base::BindOnce(
+          [](const BucketInitParams& params, int max_buckets,
+             QuotaDatabase* database) {
+            CHECK(database);
+            return database->FrontcapRestoreBucket(params, max_buckets);
+          },
+          params, max_buckets),
+      base::BindOnce(
+          [](base::WeakPtr<QuotaManagerImpl> owner,
+             base::OnceCallback<void(QuotaErrorOr<BucketInfo>)> callback,
+             QuotaErrorOr<QuotaDatabase::FrontcapRestoredBucket> restored) {
+            if (!owner) {
+              std::move(callback).Run(
+                  base::unexpected(QuotaError::kUnknownError));
+              return;
+            }
+            if (!restored.has_value()) {
+              std::move(callback).Run(base::unexpected(restored.error()));
+              return;
+            }
+            QuotaErrorOr<BucketInfo> result = std::move(restored->info);
+            if (restored->created) {
+              owner->NotifyUpdatedBucket(result);
+            }
+            std::move(callback).Run(std::move(result));
+          },
+          weak_factory_.GetWeakPtr(), std::move(callback)));
+}
