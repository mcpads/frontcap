+// A renderer's writes reach the backend only when it confirms them: one that
+// ends unconfirmed (a crash, a kill, a lost reply) may have taken writes the
+// backend never received, so no later capture can certify the partition.
+void StoragePartitionImpl::FrontcapDomStorageClientEnded(
+    mojo::ReceiverId receiver_id) {
+  if (!base::FeatureList::IsEnabled(
+          blink::features::kFrontcapFramesWhileFrozen)) {
+    return;
+  }
+  if (frontcap_certified_dom_storage_.erase(receiver_id))
+    return;
+  if (!frontcap_dom_storage_loss_) {
+    frontcap_dom_storage_loss_ =
+        "A renderer ended before confirming its DOM storage writes";
+  }
+}
+
+void StoragePartitionImpl::FrontcapConfirmDomStorageWrites(
+    const std::set<mojo::ReceiverId>& receiver_ids,
+    base::OnceCallback<void(bool)> callback) {
+  std::vector<mojo::Remote<blink::mojom::DomStorageClient>*> clients;
+  for (auto id : receiver_ids) {
+    auto it = dom_storage_clients_.find(id);
+    if (it != dom_storage_clients_.end() && it->second.is_bound())
+      clients.push_back(&it->second);
+  }
+  auto done = base::BarrierCallback<bool>(
+      clients.size(),
+      base::BindOnce(
+          [](base::OnceCallback<void(bool)> callback,
+             std::vector<bool> complete) {
+            std::move(callback).Run(std::ranges::all_of(
+                complete, [](bool confirmed) { return confirmed; }));
+          },
+          std::move(callback)));
+  for (auto* client : clients) {
+    (*client)->FrontcapWaitForWrites(
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::OnceCallback<void(bool)>(done), false));
+  }
+}
+
+void StoragePartitionImpl::FrontcapCertifyDomStorageWrites(
+    const std::set<mojo::ReceiverId>& receiver_ids) {
+  for (auto id : receiver_ids) {
+    if (dom_storage_clients_.contains(id))
+      frontcap_certified_dom_storage_.insert(id);
+  }
+}
