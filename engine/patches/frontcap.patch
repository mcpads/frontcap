+void ProcessTimeOverrideCoordinator::ScopedOverride::ScheduleWork() {
+  schedule_work_callback_.Run();
+  if (frontcap_atomic_waiting_ && !frontcap_atomic_wake_posted_ &&
+      frontcap_atomic_deadline_ <= ProcessTimeOverrideCoordinator::Instance().FrontcapVirtualTicks()) {
+    frontcap_atomic_wake_posted_ = true;
+    // The callback only posts a wake. Never enter V8 while holding this lock:
+    // a V8 notifier acquires the wait lock before calling our wake transition.
+    frontcap_atomic_wake_.Run();
+  }
+}
+
+void ProcessTimeOverrideCoordinator::ScopedOverride::FrontcapWaitForAtomics(
+    base::TimeTicks deadline, base::RepeatingClosure wake) {
+  auto& coordinator = ProcessTimeOverrideCoordinator::Instance();
+  base::AutoLock lock(coordinator.lock_);
+  frontcap_atomic_waiting_ = true;
+  frontcap_atomic_wake_posted_ = false;
+  frontcap_atomic_deadline_ = deadline;
+  frontcap_atomic_wake_ = std::move(wake);
+  frontcap_atomic_owner_ = base::PlatformThread::CurrentRef();
+  stalled_.store(true, std::memory_order_release);
+  coordinator.requested_ticks_by_client_[this] = deadline;
+  for (auto& block : coordinator.frontcap_blocks_) {
+    if (block.owner == frontcap_atomic_owner_) block.suspended = true;
+  }
+  coordinator.FrontcapMaybeAdvanceLocked();
+}
+
+void ProcessTimeOverrideCoordinator::ScopedOverride::FrontcapWakeFromAtomics() {
+  auto& coordinator = ProcessTimeOverrideCoordinator::Instance();
+  base::AutoLock lock(coordinator.lock_);
+  if (!frontcap_atomic_waiting_) return;
+  coordinator.FrontcapSharedHoldLocked();
+  frontcap_atomic_waiting_ = false;
+  frontcap_atomic_wake_.Reset();
+  stalled_.store(false, std::memory_order_release);
+  coordinator.requested_ticks_by_client_[this] = NowTicks();
+  holds_.fetch_add(1, std::memory_order_acq_rel);
+  for (auto it = coordinator.frontcap_blocks_.begin();
+       it != coordinator.frontcap_blocks_.end(); ++it) {
+    if (it->owner != frontcap_atomic_owner_) continue;
+    it->suspended = false;
+    if (it->blocks == 0 && it->enrollments == 0)
+      coordinator.frontcap_blocks_.erase(it);
+    break;
+  }
+}
