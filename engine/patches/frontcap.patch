+
+void LocalStorageImpl::GetSnapshot(GetSnapshotCallback callback) {
+  ReadSnapshot(base::BindOnce(
+      [](GetSnapshotCallback callback, StatusOr<Snapshot> snapshot) {
+        if (!snapshot.has_value()) {
+          std::move(callback).Run(mojom::LocalStorageSnapshotResult::NewError(
+              snapshot.error().ToString()));
+          return;
+        }
+        std::vector<mojom::DomStorageAreaSnapshotPtr> areas;
+        for (const auto& [key, values] : *snapshot) {
+          std::vector<blink::mojom::KeyValuePtr> entries;
+          for (const auto& [name, value] : values)
+            entries.push_back(blink::mojom::KeyValue::New(name, value));
+          areas.push_back(mojom::DomStorageAreaSnapshot::New(key, std::move(entries)));
+        }
+        std::move(callback).Run(
+            mojom::LocalStorageSnapshotResult::NewAreas(std::move(areas)));
+      }, std::move(callback)));
+}
+
+void LocalStorageImpl::ReadSnapshot(SnapshotCallback callback) {
+  auto guarded = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      std::move(callback),
+      StatusOr<Snapshot>(base::unexpected(
+          DbStatus::IOError("Local storage snapshot interrupted"))));
+  RunWhenConnected(base::BindOnce(&LocalStorageImpl::ReadSnapshotConnected,
+                                  weak_ptr_factory_.GetWeakPtr(),
+                                  std::move(guarded)));
+}
+
+void LocalStorageImpl::ReadSnapshotConnected(SnapshotCallback callback) {
+  if (snapshot_inventory_error_) {
+    std::move(callback).Run(base::unexpected(*snapshot_inventory_error_));
+    return;
+  }
+  if (!database_) {
+    std::move(callback).Run(base::unexpected(
+        DbStatus::IOError("Local storage inventory unavailable")));
+    return;
+  }
+  database_->ReadAllMetadata(base::BindOnce(
+      &LocalStorageImpl::OnSnapshotMetadata, weak_ptr_factory_.GetWeakPtr(),
+      std::move(callback)));
+}
+
+void LocalStorageImpl::OnSnapshotMetadata(
+    SnapshotCallback callback,
+    StatusOr<DomStorageDatabase::Metadata> metadata) {
+  if (!metadata.has_value()) {
+    std::move(callback).Run(base::unexpected(metadata.error()));
+    return;
+  }
+  if (snapshot_inventory_error_) {
+    std::move(callback).Run(base::unexpected(*snapshot_inventory_error_));
+    return;
+  }
+  if (!database_) {
+    std::move(callback).Run(base::unexpected(
+        DbStatus::IOError("Local storage inventory disconnected")));
+    return;
+  }
+  std::set<blink::StorageKey> keys;
+  for (const auto& entry : metadata->map_metadata)
+    keys.insert(entry.map_locator.storage_key());
+  for (const auto& [key, holder] : areas_)
+    keys.insert(key);
+  if (keys.empty()) {
+    std::move(callback).Run(Snapshot());
+    return;
+  }
+  using Area = std::pair<blink::StorageKey, SnapshotEntries>;
+  auto complete = base::BarrierCallback<StatusOr<Area>>(
+      keys.size(),
+      base::BindOnce(
+          [](SnapshotCallback callback, std::vector<StatusOr<Area>> areas) {
+            Snapshot snapshot;
+            for (auto& area : areas) {
+              if (!area.has_value()) {
+                std::move(callback).Run(base::unexpected(area.error()));
+                return;
+              }
+              snapshot.emplace(std::move(area->first), std::move(area->second));
+            }
+            std::move(callback).Run(std::move(snapshot));
+          },
+          std::move(callback)));
+  for (const auto& key : keys) {
+    auto read = base::BindOnce(
+        [](blink::StorageKey key,
+           base::RepeatingCallback<void(StatusOr<Area>)> complete,
+           StatusOr<SnapshotEntries> entries) {
+          if (!entries.has_value()) {
+            complete.Run(base::unexpected(entries.error()));
+            return;
+          }
+          complete.Run(Area(std::move(key), std::move(*entries)));
+        },
+        key, complete);
+    auto guarded = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+        std::move(read), StatusOr<SnapshotEntries>(base::unexpected(
+                             DbStatus::IOError("Storage area disappeared"))));
+    auto found = areas_.find(key);
+    if (found != areas_.end()) {
+      found->second->storage_area()->ReadSnapshot(std::move(guarded));
+    } else {
+      // Read an existing persisted map directly: binding would create an area
+      // and later write access metadata merely because it was inspected.
+      database_->ReadMapKeyValues(DomStorageDatabase::MapLocator(key),
+                                   std::move(guarded));
+    }
+  }
+}
