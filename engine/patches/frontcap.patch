+void BucketManagerHost::BindFrontcapStorage(
+    const std::string& token,
+    mojo::PendingReceiver<blink::mojom::IDBFactory> indexed_db,
+    mojo::PendingReceiver<blink::mojom::CacheStorage> caches,
+    BindFrontcapStorageCallback callback) {
+  auto context = receivers_.current_context();
+  if (!context) {
+    std::move(callback).Run(false, "", std::nullopt);
+    return;
+  }
+  auto scope = manager_->TakeFrontcapScope(
+      token, context->GetBucketClientInfo(), base::PassKey<BucketManagerHost>());
+  if (!scope) {
+    std::move(callback).Run(false, "", std::nullopt);
+    return;
+  }
+  const auto params = scope->bucket_name
+      ? storage::BucketInitParams(scope->storage_key, *scope->bucket_name)
+      : storage::BucketInitParams::ForDefaultBucket(scope->storage_key);
+  // Binding a saved scope must not update or expire a restored bucket.
+  // The capability has already been consumed; failure does not authorize reuse.
+  const bool create_if_missing = scope->create_if_missing;
+  auto bound =
+      base::BindOnce(
+          [](base::WeakPtr<BucketManagerHost> self,
+             base::WeakPtr<BucketContext> context,
+             BucketManager::FrontcapScope scope,
+             mojo::PendingReceiver<blink::mojom::IDBFactory> indexed_db,
+             mojo::PendingReceiver<blink::mojom::CacheStorage> caches,
+             BindFrontcapStorageCallback callback,
+             storage::QuotaErrorOr<storage::BucketInfo> result) {
+            if (!self || !context || scope.lifetime.expired() ||
+                context->GetBucketClientInfo() != scope.client || !result.has_value() ||
+                result->storage_key != scope.storage_key ||
+                result->name != scope.bucket_name.value_or(storage::kDefaultBucketName)) {
+              std::move(callback).Run(false, "", std::nullopt);
+              return;
+            }
+            auto checker = IndexedDBClientStateCheckerFactory::InitializePendingRemote(scope.client);
+            if (!checker) {
+              std::move(callback).Run(false, "", std::nullopt);
+              return;
+            }
+            self->GetStoragePartition()->BindIndexedDB(
+                result->ToBucketLocator(), scope.client, std::move(checker), std::move(indexed_db));
+            // Keep the resolved identity for both providers. Re-resolving a
+            // default bucket by name can expire and delete the saved data.
+            context->BindCacheStorageForBucket(*result, std::move(caches));
+            std::move(callback).Run(true, scope.storage_key.Serialize(), scope.bucket_name);
+          },
