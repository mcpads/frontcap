+protocol::Response InspectorEmulationAgent::frontcapPrepareClock(
+    const String& unix_time_us) {
+  if (!web_local_frame_ ||
+      !base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen)) {
+    return protocol::Response::ServerError(
+        "clock preparation requires a controlled-engine page session");
+  }
+  int64_t microseconds;
+  if (!base::StringToInt64(unix_time_us.Utf8(), &microseconds))
+    return protocol::Response::InvalidParams("invalid Unix microseconds");
+  const base::Time initial_time =
+      base::Time::UnixEpoch() + base::Microseconds(microseconds);
+  if (initial_time.is_inf())
+    return protocol::Response::InvalidParams("Unix microseconds out of range");
+  const bool enabled = virtual_time_controller_->FrontcapIsVirtualTimeEnabled();
+  if (!enabled) {
+    // Do not convert an already running application's real clock retroactively.
+    for (Page* page : Page::OrdinaryPages()) {
+      for (Frame* frame = page->MainFrame(); frame;
+           frame = frame->Tree().TraverseNext()) {
+        auto* local = DynamicTo<LocalFrame>(frame);
+        if (local && !local->IsDetached() &&
+            (!local->GetDocument() ||
+             !local->GetDocument()->IsInitialEmptyDocument())) {
+          return protocol::Response::ServerError(
+              "clock preparation requires unstarted documents");
+        }
+      }
+    }
+  }
+  // This session owns no grant. Persist its participant role for a future
+  // renderer replacement without cancelling another page's in-flight grant.
+  frontcap_bind_storage_clock_.Set(false);
+  virtual_time_policy_.Set(protocol::Emulation::VirtualTimePolicyEnum::Pause);
+  virtual_time_budget_.Set(0);
+  initial_virtual_time_.Set(initial_time.InSecondsFSinceUnixEpoch());
+  virtual_time_task_starvation_count_.Set(0);
+  frontcap_budget_end_.reset();
+  InnerEnable();
+  if (!enabled) {
+    virtual_time_base_ticks_ =
+        virtual_time_controller_->EnableVirtualTime(initial_time);
+    virtual_time_controller_->SetVirtualTimePolicy(
+        VirtualTimeController::VirtualTimePolicy::kPause);
+  }
+  return protocol::Response::Success();
+}
