+void InspectorCacheStorageAgent::frontcapPutEntries(
+    const String& storage_key,
+    std::optional<String> storage_bucket_name,
+    const String& cache_name,
+    std::unique_ptr<protocol::Array<protocol::CacheStorage::FrontcapCacheEntry>> entries,
+    std::unique_ptr<FrontcapPutEntriesCallback> callback) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen)) {
+    callback->sendFailure(ProtocolResponse::ServerError("frontcap storage control is disabled"));
+    return;
+  }
+  LocalFrame* frame = frames_->FrameWithStorageKey(storage_key);
+  if (!frame && frames_->Root() &&
+      FrontcapStorageScopes::From(*frames_->Root()->DomWindow()).Find(storage_key, storage_bucket_name)) {
+    frame = frames_->Root();
+  }
+  if (!frame || !frame->DomWindow()->GetSecurityOrigin()->IsPotentiallyTrustworthy()) {
+    callback->sendFailure(ProtocolResponse::InvalidParams("Expected an enrolled trustworthy storage key"));
+    return;
+  }
+  if (cache_name.empty() || cache_name.length() > 1024 || cache_name.contains('|') || entries->size() > 64) {
+    callback->sendFailure(ProtocolResponse::InvalidParams("Expected a named cache and 0 to 64 entries"));
+    return;
+  }
+  size_t total_bytes = 0;
+  HashSet<String> urls;
+  auto valid_headers = [](const auto& headers, bool allow_filtered = false, bool opaque = false) {
+    if (headers.size() > 64)
+      return false;
+    HashSet<String> names;
+    for (const auto& header : headers) {
+      const String name = header->getName().ToAsciiLower();
+      const String& value = header->getValue();
+      if (!IsValidHTTPToken(name) || !IsValidHTTPHeaderValue(value) ||
+          name.length() > 1024 || value.length() > 8192 ||
+          !names.insert(name).is_new_entry || (!allow_filtered && (name == "set-cookie" || name == "set-cookie2")))
+        return false;
+      if (name == "vary" && !opaque) {
+        for (const String& field : value.Split(',')) {
+          if (field.StripWhiteSpace() == "*")
+            return false;
+        }
+      }
+    }
+    return true;
+  };
+  // Validate the entire declaration before opening/creating a cache or a blob.
+  for (const auto& entry : *entries) {
+    const KURL url(entry->getRequestURL());
+    const int status = entry->getResponseStatus();
+    const auto& body = entry->getBody();
+    auto restored = mojom::blink::FetchAPIResponse::New();
+    if (entry->hasMetadata() && !RestoreResponseMetadata(*entry->getMetadata(nullptr), *restored)) {
+      callback->sendFailure(ProtocolResponse::InvalidParams("Invalid stored response metadata"));
+      return;
+    }
+    const bool opaque = restored->response_type == network::mojom::FetchResponseType::kOpaque ||
+                        restored->response_type == network::mojom::FetchResponseType::kOpaqueRedirect;
+    if (!url.IsValid() || !url.ProtocolIsInHttpFamily() ||
+        !url.User().empty() || !url.Pass().empty() || url.HasFragmentIdentifier() ||
+        url.GetString() != entry->getRequestURL() || !urls.insert(url.GetString()).is_new_entry ||
+        status < 200 || status > 599 || (status == 206 && !opaque) ||
+        ((status == 204 || status == 205 || status == 304) && body.size() != 0) ||
+        !IsValidHTTPHeaderValue(entry->getResponseStatusText()) || entry->getResponseStatusText().length() > 1024 ||
+        !valid_headers(*entry->getRequestHeaders()) || !valid_headers(*entry->getResponseHeaders(), entry->hasMetadata(), opaque) ||
+        body.size() > 4 * 1024 * 1024 - total_bytes) {
+      callback->sendFailure(ProtocolResponse::InvalidParams("Invalid cache entry or batch exceeds 4 MiB of bodies"));
+      return;
+    }
+    total_bytes += body.size();
+  }
+  Vector<mojom::blink::BatchOperationPtr> operations;
+  const base::Time now = base::Time::Now();
+  for (const auto& entry : *entries) {
+    auto operation = mojom::blink::BatchOperation::New();
+    operation->operation_type = mojom::blink::OperationType::kPut;
+    operation->request = mojom::blink::FetchAPIRequest::New();
+    operation->request->url = KURL(entry->getRequestURL());
+    operation->request->method = "GET";
+    for (const auto& header : *entry->getRequestHeaders())
+      operation->request->headers.Set(header->getName().ToAsciiLower(), header->getValue());
+    operation->response = mojom::blink::FetchAPIResponse::New();
+    operation->response->status_code = entry->getResponseStatus();
+    operation->response->status_text = entry->getResponseStatusText();
+    operation->response->response_time = now;
+    if (entry->hasMetadata()) {
+      const bool restored = RestoreResponseMetadata(*entry->getMetadata(nullptr), *operation->response);
+      CHECK(restored);  // Already validated above, before opening the cache.
+    }
+    for (const auto& header : *entry->getResponseHeaders())
+      operation->response->headers.Set(header->getName().ToAsciiLower(), header->getValue());
+    const auto& body = entry->getBody();
+    if (body.size()) {
+      auto blob = std::make_unique<BlobData>();
+      blob->AppendBytes(body.Span());
+      operation->response->blob = BlobDataHandle::Create(std::move(blob), body.size());
+    }
+    operations.push_back(std::move(operation));
+  }
+  auto wrapped = RequestCallbackWrapper<FrontcapPutEntriesCallback>::Wrap(std::move(callback));
+  auto storage = GetCacheStorageRemote(storage_key, storage_bucket_name, wrapped->GetFailureCallback());
+  if (!storage.has_value()) {
+    wrapped->SendFailure(storage.error());
+    return;
+  }
+  const String cache_id = BuildCacheId(storage_key, storage_bucket_name, cache_name);
+  const int64_t trace_id = blink::cache_storage::CreateTraceId();
+  storage.value()->Open(cache_name, trace_id, blink::BindOnce(
+      [](String cache_id, int64_t trace_id, Vector<mojom::blink::BatchOperationPtr> operations,
+         scoped_refptr<RequestCallbackWrapper<FrontcapPutEntriesCallback>> wrapped,
+         mojom::blink::CacheStorage::OpenResult result) {
+        if (!result.has_value()) {
+          wrapped->SendFailure(ProtocolResponse::ServerError(CacheStorageErrorString(result.error())));
+          return;
+        }
+        // Open has committed the empty cache. Batch requires at least one operation.
+        if (operations.empty()) {
+          wrapped->SendSuccess(cache_id);
+          return;
+        }
+        mojo::AssociatedRemote<mojom::blink::CacheStorageCache> remote;
+        remote.Bind(std::move(result.value()));
+        auto* cache = remote.get();
+        remote.set_disconnect_handler(blink::BindOnce(
+            wrapped->GetFailureCallback(), ProtocolResponse::ServerError("Cache write connection closed; outcome unknown")));
+        cache->Batch(std::move(operations), trace_id, blink::BindOnce(
+            [](mojo::AssociatedRemote<mojom::blink::CacheStorageCache> remote, String cache_id,
+               scoped_refptr<RequestCallbackWrapper<FrontcapPutEntriesCallback>> wrapped,
+               mojom::blink::CacheStorageVerboseErrorPtr result) {
+              if (result->value != mojom::blink::CacheStorageError::kSuccess) {
+                wrapped->SendFailure(ProtocolResponse::ServerError(CacheStorageErrorString(result->value)));
+                return;
+              }
+              wrapped->SendSuccess(cache_id);
+            }, std::move(remote), std::move(cache_id), wrapped));
+      }, cache_id, trace_id, std::move(operations), wrapped));
+}
