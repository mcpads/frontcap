+
+void WorkerAnimationFrameProvider::FrontcapUpdateControl() {
+  if (!frontcap_controlled_ && !frontcap_worker_.is_empty() &&
+      scheduler::FrontcapProcessOnVirtualTime()) {
+    frontcap_controlled_ = true;
+    begin_frame_provider_->FrontcapCancelBeginFrame();
+  }
