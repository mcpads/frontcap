+
+void WorkerAnimationFrameProvider::FrontcapAcceptFrame(
+    uint64_t opportunity, base::Time instant, base::UnguessableToken clock) {
+  FrontcapUpdateControl();
+  const auto ticks = scheduler::ProcessTimeOverrideCoordinator::FrontcapFrameTicks(
+      instant, clock);
+  if (!frontcap_controlled_ || frontcap_opportunity_ ||
+      context_->IsContextDestroyed() || !ticks ||
+      !FrontcapWorkerFrameIsCurrent(frontcap_worker_, opportunity)) {
+    FrontcapCompleteWorkerFrame(frontcap_worker_, opportunity, false);
+    return;
+  }
+  frontcap_opportunity_ = opportunity;
+  frontcap_frame_instant_ = instant;
+  frontcap_frame_ticks_ = *ticks;
+  frontcap_clock_ = clock;
+  if (!callback_collection_.HasFrameCallback()) {
+    FrontcapCompleteFrame(frontcap_opportunity_, true);
+    return;
+  }
+  FrontcapRequestFreshFrame(frontcap_opportunity_);
