+void PageHandler::SelectFrontcapCookieClockOwner(RenderFrameHostImpl* frame) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen))
+    return;
+  auto target = FrontcapDialogContents(frame);
+  if (!std::holds_alternative<WebContentsImpl*>(target)) return;
+  auto* state = DialogState(std::get<WebContentsImpl*>(target), true);
+  state->cookie_clock_frame = frame->GetWeakPtr();
+}
+
+bool PageHandler::HoldFrontcapSharedWindowClosure(RenderFrameHostImpl* frame) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen)) return false;
+  auto target = FrontcapDialogContents(frame);
+  if (!std::holds_alternative<WebContentsImpl*>(target)) return false;
+  auto* clock = ExistingCookieClockForProcess(frame->GetProcess());
+  if (!clock || !clock->shared_time.IsValid()) return false;
+  auto* control = static_cast<blink::frontcap::SharedControl*>(clock->shared_control_mapping.memory());
+  if (!control->activated.load(std::memory_order_acquire) ||
+      control->failed.load(std::memory_order_acquire)) return false;
+  auto* contents = std::get<WebContentsImpl*>(target);
+  const auto id = DevToolsAgentHost::GetOrCreateFor(contents)->GetId();
+  const auto instant = static_cast<const std::atomic<int64_t>*>(
+      clock->shared_time.mapping.memory())->load(std::memory_order_acquire);
+  clock->shared_window_closures.try_emplace(id,
+      CookieClockState::WindowClosure{contents->GetWeakPtr(), instant});
+  return true;
+}
+
+Response PageHandler::FrontcapGetSharedWindowClosures(
+    std::unique_ptr<protocol::Array<Page::FrontcapWindowClosure>>* closures) {
+  if (!std::holds_alternative<WebContentsImpl*>(FrontcapDialogContents(host_)))
+    return Response::ServerError("shared window closure requires a top target");
+  auto* clock = CookieClockForFrame(host_);
+  *closures = std::make_unique<protocol::Array<Page::FrontcapWindowClosure>>();
+  for (const auto& [target, closure] : clock->shared_window_closures) {
+    (*closures)->push_back(Page::FrontcapWindowClosure::Create()
+        .SetTargetId(target).SetUnixTimeUs(base::NumberToString(closure.unix_time_us))
+        .SetClosed(!closure.window).Build());
+  }
+  return Response::Success();
+}
+
+Response PageHandler::FrontcapAcknowledgeSharedWindowClosure(
+    const std::string& clock_id, const std::string& target_id) {
+  if (!std::holds_alternative<WebContentsImpl*>(FrontcapDialogContents(host_)))
+    return Response::ServerError("shared window closure requires a top target");
+  auto* clock = CookieClockForFrame(host_);
+  if (!clock->shared_time.IsValid() || clock->shared_time.region.GetGUID().ToString() != clock_id)
+    return Response::ServerError("shared clock scope mismatch");
+  const auto* control = static_cast<const blink::frontcap::SharedControl*>(
+      clock->shared_control_mapping.memory());
+  if (!control->activated.load(std::memory_order_acquire) ||
+      control->failed.load(std::memory_order_acquire) || clock->shared_suspension.empty())
+    return Response::ServerError("shared window closure requires a held active clock");
+  auto found = clock->shared_window_closures.find(target_id);
+  if (found == clock->shared_window_closures.end()) return Response::Success();
+  if (found->second.window) return Response::ServerError("shared window is still closing");
+  clock->shared_window_closures.erase(found);
+  return Response::Success();
+}
+
+void PageHandler::HoldFrontcapSharedWindow(RenderFrameHostImpl* opener,
+    WebContentsImpl* contents) {
+  auto* clock = ExistingCookieClockForProcess(opener->GetProcess());
+  if (!clock || !clock->shared_time.IsValid()) return;
+  const auto* control = static_cast<const blink::frontcap::SharedControl*>(
+      clock->shared_control_mapping.memory());
+  if (!control->activated.load(std::memory_order_acquire)) return;
+  // The opener is still inside window.open. Hold publication before its task
+  // can finish and propose a later instant, even if inspector enrollment lags.
+  // Native WebContents destruction cancels an unadmitted window's obligation.
+  clock->shared_pending_windows.push_back(contents->GetWeakPtr());
+}
+
+Response PageHandler::FrontcapGetSharedWindowRenderer(const std::string& clock_id,
+    std::string* renderer_id, std::string* unix_time_us) {
+  auto target = FrontcapDialogContents(host_);
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) ||
+      !std::holds_alternative<WebContentsImpl*>(target))
+    return Response::ServerError("shared window admission requires a controlled top target");
+  auto* clock = CookieClockForFrame(host_);
+  if (!clock->shared_time.IsValid() || clock->shared_time.region.GetGUID().ToString() != clock_id)
+    return Response::ServerError("shared clock scope mismatch");
+  const auto* control = static_cast<const blink::frontcap::SharedControl*>(
+      clock->shared_control_mapping.memory());
+  if (!control->activated.load(std::memory_order_acquire) ||
+      control->failed.load(std::memory_order_acquire) || clock->shared_suspension.empty())
+    return Response::ServerError("shared window admission requires a held active clock");
+  renderer_id->clear();
+  for (const auto& [key, registration] : clock->shared_participants) {
+    if (key.first == host_->GetProcess()->GetDeprecatedID() && registration->alive &&
+        !registration->retired && registration->confirmed &&
+        control->participants[registration->handle.slot].armed.load(std::memory_order_acquire)) {
+      *renderer_id = key.second;
+      break;
+    }
+  }
+  *unix_time_us = base::NumberToString(static_cast<const std::atomic<int64_t>*>(
+      clock->shared_time.mapping.memory())->load(std::memory_order_acquire));
+  return Response::Success();
+}
+
+Response PageHandler::FrontcapAdmitSharedWindow(const std::string& clock_id, std::string* renderer_id) {
+  std::string unix_time_us;
+  auto response = FrontcapGetSharedWindowRenderer(clock_id, renderer_id, &unix_time_us);
+  if (!response.IsSuccess()) return response;
+  if (renderer_id->empty()) return Response::ServerError("shared window renderer is not armed");
+  auto* clock = CookieClockForFrame(host_);
+  auto target = FrontcapDialogContents(host_);
+  auto* contents = std::get<WebContentsImpl*>(target);
+  std::erase_if(clock->shared_pending_windows,
+      [contents](const auto& window) { return !window || window.get() == contents; });
+  return Response::Success();
+}
+
+bool PageHandler::CanDelegateFrontcapNavigation(RenderFrameHostImpl* from,
+                                                RenderFrameHostImpl* to) {
+  if (!from || !to || from->GetProcess() == to->GetProcess() ||
+      !base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen))
+    return false;
+  auto* clock = ExistingCookieClockForProcess(from->GetProcess());
+  if (!clock || clock != ExistingCookieClockForProcess(to->GetProcess()) ||
+      !clock->shared_time.IsValid())
+    return false;
+  const auto* control = static_cast<const blink::frontcap::SharedControl*>(
+      clock->shared_control_mapping.memory());
+  if (!control->activated.load(std::memory_order_acquire) ||
+      control->failed.load(std::memory_order_acquire))
+    return false;
+  for (auto* process : {from->GetProcess(), to->GetProcess()}) {
+    bool armed = false;
+    for (const auto& [key, registration] : clock->shared_participants) {
+      if (key.first == process->GetDeprecatedID() && registration->alive &&
+          !registration->retired && registration->confirmed &&
+          control->participants[registration->handle.slot].armed.load(std::memory_order_acquire)) {
+        armed = true;
+        break;
+      }
+    }
+    if (!armed) return false;
+  }
+  return true;
+}
+
+bool PageHandler::HasFrontcapSharedClock(RenderProcessHost* process) {
+  auto* clock = ExistingCookieClockForProcess(process);
+  if (!clock) return false;
+  for (const auto& [key, registration] : clock->shared_participants) {
+    if (key.first == process->GetDeprecatedID() && registration->alive &&
+        !registration->retired) return true;
+  }
+  return false;
+}
+
+bool PageHandler::RetireFrontcapSharedClock(RenderProcessHost* process) {
+  // Native death is never reclassified as orderly cleanup.
+  if (!process->IsInitializedAndNotDead()) return true;
+  // Only RenderProcessHostImpl::Cleanup calls this, after every live frame,
+  // worker, keep-alive and pending-reuse owner has gone. A timeout or target
+  // detach is never retirement proof. Busy retains cleanup for a later turn.
+  auto* clock = ExistingCookieClockForProcess(process);
+  if (!clock) return true;
+  for (const auto& [key, registration] : clock->shared_participants) {
+    if (key.first == process->GetDeprecatedID() && registration->alive &&
+        !registration->Retire()) return false;
+  }
+  return true;
+}
+
+void PageHandler::PrepareFrontcapSharedClock(
+    RenderFrameHostImpl* frame, const std::string& renderer_identity,
+    int64_t expected_unix_time_us,
+    base::OnceCallback<void(base::ReadOnlySharedMemoryRegion,
+        base::UnsafeSharedMemoryRegion, uint32_t, uint64_t)> callback) {
+  auto refuse = [&callback]() {
+    std::move(callback).Run({}, {}, 0, 0);
+  };
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) ||
+      renderer_identity.empty() || !frame->GetProcess()->IsInitializedAndNotDead() ||
+      !std::holds_alternative<WebContentsImpl*>(FrontcapDialogContents(frame))) {
+    refuse(); return;
+  }
+  auto* clock = CookieClockForFrame(frame);
+  if (clock->binding_pending || !clock->region.IsValid()) {
+    refuse(); return;
+  }
+  auto existing = clock->region.Map();
+  if (!existing.IsValid() || existing.size() != sizeof(base::subtle::Atomic64) ||
+      base::subtle::Acquire_Load(static_cast<const base::subtle::Atomic64*>(
+          existing.memory())) != expected_unix_time_us) {
+    refuse(); return;
+  }
+  if (!clock->shared_time.IsValid()) {
+    auto time = base::ReadOnlySharedMemoryRegion::Create(sizeof(std::atomic<int64_t>));
+    auto control = base::UnsafeSharedMemoryRegion::Create(sizeof(blink::frontcap::SharedControl));
+    auto mapping = control.Map();
+    if (!time.IsValid() || !mapping.IsValid()) {
+      refuse(); return;
+    }
+    const auto& scope = time.region.GetGUID();
+    new (time.mapping.memory()) std::atomic<int64_t>(expected_unix_time_us);
+    new (mapping.memory()) blink::frontcap::SharedControl(
+        {scope.GetHighForSerialization(), scope.GetLowForSerialization()});
+    clock->shared_time = std::move(time);
+    clock->shared_control = std::move(control);
+    clock->shared_control_mapping = std::move(mapping);
+  }
+  blink::frontcap::SharedClock shared{
+      *static_cast<blink::frontcap::SharedControl*>(clock->shared_control_mapping.memory()),
+      *static_cast<std::atomic<int64_t>*>(clock->shared_time.mapping.memory())};
+  if (shared.now->load(std::memory_order_acquire) != expected_unix_time_us ||
+      shared.control->failed.load(std::memory_order_acquire)) {
+    refuse(); return;
+  }
+  const auto key = std::make_pair(frame->GetProcess()->GetDeprecatedID(), renderer_identity);
+  auto found = clock->shared_participants.find(key);
+  if (found == clock->shared_participants.end()) {
+    blink::frontcap::Handle handle{};
+    if (blink::frontcap::Join(shared, handle) != blink::frontcap::Status::ok) {
+      refuse(); return;
+    }
+    found = clock->shared_participants.emplace(key,
+        std::make_unique<SharedClockRegistration>(frame->GetProcess(), shared, handle)).first;
+  }
+  if (found->second->retired) { refuse(); return; }
+  auto time = clock->shared_time.region.Duplicate();
+  auto control = clock->shared_control.Duplicate();
+  if (!time.IsValid() || !control.IsValid()) {
+    shared.control->failed.store(true, std::memory_order_release);
+    refuse(); return;
+  }
+  std::move(callback).Run(std::move(time), std::move(control),
+                         static_cast<uint32_t>(found->second->handle.slot), found->second->handle.identity);
+}
+
+bool PageHandler::ConfirmFrontcapSharedClock(RenderFrameHostImpl* frame,
+    const std::string& renderer_identity, const std::string& clock_id,
+    uint64_t participant, bool accepted,
+    mojo::PendingRemote<blink::mojom::FrontcapProcessControl> process_control) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) ||
+      !std::holds_alternative<WebContentsImpl*>(FrontcapDialogContents(frame))) return false;
+  auto* clock = CookieClockForFrame(frame);
+  if (!clock->shared_time.IsValid() || clock->shared_time.region.GetGUID().ToString() != clock_id)
+    return false;
+  const auto key = std::make_pair(frame->GetProcess()->GetDeprecatedID(), renderer_identity);
+  const auto found = clock->shared_participants.find(key);
+  if (found == clock->shared_participants.end() || found->second->handle.identity != participant)
+    return false;
+  auto& registration = *found->second;
+  auto* control = static_cast<blink::frontcap::SharedControl*>(clock->shared_control_mapping.memory());
+  if (!accepted) {
+    // Validation failure is not native death, but it still invalidates this
+    // preparation. Do not present the incomplete membership as ready to activate.
+    control->failed.store(true, std::memory_order_release);
+    return false;
+  }
+  if (!registration.alive || registration.retired || control->failed.load(std::memory_order_acquire)) return false;
+  if (!registration.process_control.is_bound()) {
+    if (!process_control.is_valid()) return false;
+    registration.process_control.Bind(std::move(process_control));
+    registration.process_control.set_disconnect_handler(base::BindOnce(
+        &SharedClockRegistration::FailControl, base::Unretained(&registration)));
+  }
+  registration.confirmed = true;
+  return true;
+}
+
+Response PageHandler::FrontcapGetSharedClock(std::string* clock_id,
+    std::string* unix_time_us, bool* failed, bool* activated, std::string* bound_us,
+    std::string* suspension_id, bool* controller_attached,
+    std::unique_ptr<protocol::Array<Page::FrontcapClockParticipant>>* participants) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen))
+    return Response::ServerError("shared clock inventory requires controlled engine");
+  auto target = FrontcapDialogContents(host_);
+  if (std::holds_alternative<Response>(target)) return std::get<Response>(target);
+  auto* clock = CookieClockForFrame(host_);
+  if (!clock->shared_time.IsValid())
+    return Response::ServerError("shared clock is not prepared");
+  *clock_id = clock->shared_time.region.GetGUID().ToString();
+  *unix_time_us = base::NumberToString(static_cast<const std::atomic<int64_t>*>(
+      clock->shared_time.mapping.memory())->load(std::memory_order_acquire));
+  *failed = static_cast<const blink::frontcap::SharedControl*>(
+      clock->shared_control_mapping.memory())->failed.load(std::memory_order_acquire);
+  const auto* control = static_cast<const blink::frontcap::SharedControl*>(clock->shared_control_mapping.memory());
+  *activated = control->activated.load(std::memory_order_acquire);
+  *bound_us = base::NumberToString(clock->shared_bound);
+  *suspension_id = clock->shared_suspension;
+  *controller_attached = !!clock->shared_controller;
+  *participants = std::make_unique<protocol::Array<Page::FrontcapClockParticipant>>();
+  blink::frontcap::ParticipantClock view(
+      *static_cast<blink::frontcap::SharedControl*>(clock->shared_control_mapping.memory()),
+      *static_cast<const std::atomic<int64_t>*>(clock->shared_time.mapping.memory()));
+  // Never wait for a renderer that may own the guard. Missing proposal fields
+  // mean the caller has no proposal evidence and must retry or retain its hold.
+  blink::frontcap::Guard guard(view, blink::frontcap::kAuthority);
+  for (const auto& [key, registration] : clock->shared_participants) {
+    auto participant = Page::FrontcapClockParticipant::Create()
+        .SetRendererId(key.second)
+        .SetParticipantId(base::NumberToString(registration->handle.identity))
+        .SetAlive(registration->alive).SetConfirmed(registration->confirmed)
+        .SetRetired(registration->retired)
+        .SetArmed(!registration->retired && blink::frontcap::Matches(view, registration->handle) &&
+            control->participants[registration->handle.slot].armed.load(std::memory_order_acquire)).Build();
+    if (!registration->retired && guard.status() == blink::frontcap::Status::ok &&
+        blink::frontcap::Matches(view, registration->handle)) {
+      const auto& proposal = control->participants[registration->handle.slot];
+      participant->SetProposedTimeUs(base::NumberToString(proposal.proposed));
+      participant->SetProposalRevision(base::NumberToString(proposal.revision));
+    }
+    (*participants)->push_back(std::move(participant));
+  }
+  return Response::Success();
+}
+
+void PageHandler::FrontcapActivateSharedClock(const std::string& clock_id,
+    std::unique_ptr<FrontcapActivateSharedClockCallback> callback) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) ||
+      !std::holds_alternative<WebContentsImpl*>(FrontcapDialogContents(host_))) {
+    callback->sendFailure(Response::ServerError("shared clock activation requires a controlled top target")); return;
+  }
+  auto* clock = CookieClockForFrame(host_);
+  auto refuse = [&callback] { callback->sendFailure(Response::ServerError("shared clock participants are not ready")); };
+  if (!clock->shared_time.IsValid() || clock->shared_time.region.GetGUID().ToString() != clock_id ||
+      clock->binding_pending || clock->shared_participants.empty()) { refuse(); return; }
+  auto& control = *static_cast<blink::frontcap::SharedControl*>(clock->shared_control_mapping.memory());
+  if (control.failed.load(std::memory_order_acquire)) { refuse(); return; }
+  bool includes_owner = false;
+  for (const auto& [key, registration] : clock->shared_participants) {
+    if (registration->retired) continue;
+    if (!registration->alive || !registration->confirmed ||
+        !control.participants[registration->handle.slot].armed.load(std::memory_order_acquire)) { refuse(); return; }
+    if (key.first == host_->GetProcess()->GetDeprecatedID()) includes_owner = true;
+  }
+  auto* contents = std::get<WebContentsImpl*>(FrontcapDialogContents(host_));
+  auto* selected = DialogState(contents);
+  if (!includes_owner || clock->tab.get() != contents || !selected ||
+      selected->cookie_clock_frame.get() != host_) { refuse(); return; }
+  if (control.activated.load(std::memory_order_acquire)) { callback->sendSuccess(); return; }
+  auto mapping = clock->region.Map();
+  const auto now = static_cast<const std::atomic<int64_t>*>(clock->shared_time.mapping.memory())->load(std::memory_order_acquire);
+  if (!mapping.IsValid() || mapping.size() != sizeof(base::subtle::Atomic64) ||
+      base::subtle::Acquire_Load(static_cast<const base::subtle::Atomic64*>(mapping.memory())) != now) { refuse(); return; }
+  clock->shared_bound = now;
+  auto done = base::BindOnce([](base::WeakPtr<CookieClockState> clock,
+      base::WeakPtr<PageHandler> controller,
+      std::unique_ptr<FrontcapActivateSharedClockCallback> callback, bool attached) {
+    if (!clock) { callback->sendFailure(Response::ServerError("shared clock partition disappeared")); return; }
+    auto* state = static_cast<blink::frontcap::SharedControl*>(clock->shared_control_mapping.memory());
+    if (!attached || state->failed.load(std::memory_order_acquire)) {
+      state->failed.store(true, std::memory_order_release);
+      callback->sendFailure(Response::ServerError("shared storage clock activation failed")); return;
+    }
+    // Both cookie and quota services have acknowledged this read-only region.
+    state->activated.store(true, std::memory_order_release);
+    if (controller) {
+      controller->frontcap_shared_detach_ = BindSharedClockController(clock.get(), controller);
+    } else if (clock->shared_suspension.empty()) {
+      clock->shared_suspension = base::UnguessableToken::Create().ToString();
+    }
+    clock->shared_publisher.Start(FROM_HERE, base::Milliseconds(1), base::BindRepeating(
+        [](base::WeakPtr<CookieClockState> clock) { if (clock) clock->PublishSharedTime(); }, clock));
+    callback->sendSuccess();
+  }, clock->weak_factory.GetWeakPtr(), frontcap_shared_controller_factory_.GetWeakPtr(), std::move(callback));
+  clock->bindings.push_back({host_->GetWeakPtr(), clock->shared_time.region.Duplicate(), std::move(done)});
+  ProcessCookieClockBindings(clock);
+}
+
+Response PageHandler::FrontcapGrantSharedClock(const std::string& clock_id,
+    const std::string& bound_us) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) ||
+      !std::holds_alternative<WebContentsImpl*>(FrontcapDialogContents(host_)))
+    return Response::ServerError("shared clock grant requires a controlled top target");
+  auto* clock = CookieClockForFrame(host_);
+  if (!clock->shared_time.IsValid() || clock->shared_time.region.GetGUID().ToString() != clock_id)
+    return Response::ServerError("shared clock scope mismatch");
+  const auto* control = static_cast<const blink::frontcap::SharedControl*>(clock->shared_control_mapping.memory());
+  const auto now = static_cast<const std::atomic<int64_t>*>(clock->shared_time.mapping.memory())->load(std::memory_order_acquire);
+  int64_t bound;
+  if (control->failed.load(std::memory_order_acquire) || !control->activated.load(std::memory_order_acquire) ||
+      clock->shared_controller.get() != this || !clock->shared_suspension.empty() || clock->binding_pending || !base::StringToInt64(bound_us, &bound) || bound < now || bound == blink::frontcap::kIdle)
+    return Response::ServerError("invalid shared clock grant");
+  clock->shared_bound = bound;
+  return Response::Success();
+}
+
+Response PageHandler::FrontcapSuspendSharedClock(const std::string& clock_id,
+    std::string* suspension_id, std::string* unix_time_us, std::string* bound_us) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) ||
+      !std::holds_alternative<WebContentsImpl*>(FrontcapDialogContents(host_)))
+    return Response::ServerError("shared clock suspension requires a controlled top target");
+  auto* clock = CookieClockForFrame(host_);
+  if (!clock->shared_time.IsValid() || clock->shared_time.region.GetGUID().ToString() != clock_id)
+    return Response::ServerError("shared clock scope mismatch");
+  const auto* control = static_cast<const blink::frontcap::SharedControl*>(clock->shared_control_mapping.memory());
+  if (!control->activated.load(std::memory_order_acquire) || control->failed.load(std::memory_order_acquire))
+    return Response::ServerError("shared clock is not active");
+  // Publication and this command run on the same browser UI sequence. Keeping
+  // the hold in partition state makes inspector detach unable to release it.
+  // This holds logical time, not all tasks due at the already-published instant.
+  if (clock->shared_suspension.empty())
+    clock->shared_suspension = base::UnguessableToken::Create().ToString();
+  *suspension_id = clock->shared_suspension;
+  *unix_time_us = base::NumberToString(static_cast<const std::atomic<int64_t>*>(
+      clock->shared_time.mapping.memory())->load(std::memory_order_acquire));
+  *bound_us = base::NumberToString(clock->shared_bound);
+  return Response::Success();
+}
+
+Response PageHandler::FrontcapResumeSharedClock(const std::string& clock_id,
+    const std::string& suspension_id, std::optional<std::string> bound_us) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) ||
+      !std::holds_alternative<WebContentsImpl*>(FrontcapDialogContents(host_)))
+    return Response::ServerError("shared clock resume requires a controlled top target");
+  auto* clock = CookieClockForFrame(host_);
+  if (clock->shared_process_commands)
+    return Response::InvalidParams("native process control is still pending");
+  if (!clock->shared_time.IsValid() || clock->shared_time.region.GetGUID().ToString() != clock_id)
+    return Response::ServerError("shared clock scope mismatch");
+  const auto* control = static_cast<const blink::frontcap::SharedControl*>(clock->shared_control_mapping.memory());
+  if (!control->activated.load(std::memory_order_acquire) || control->failed.load(std::memory_order_acquire) ||
+      suspension_id.empty() || suspension_id != clock->shared_suspension)
+    return Response::ServerError("shared clock suspension mismatch");
+  // Validate before changing either ownership or the retained endpoint. This
+  // command and publication share the browser UI sequence, so no commit can
+  // observe the old endpoint between replacement and releasing the hold.
+  if (bound_us) {
+    const auto now = static_cast<const std::atomic<int64_t>*>(
+        clock->shared_time.mapping.memory())->load(std::memory_order_acquire);
+    int64_t bound;
+    if (clock->binding_pending || !base::StringToInt64(*bound_us, &bound) ||
+        bound < now || bound == blink::frontcap::kIdle)
+      return Response::ServerError("invalid shared clock resume bound");
+    clock->shared_bound = bound;
+  }
+  // Preserve scheduler proposals and budgets; only the explicit bound changes.
+  // Transfer control before releasing the hold; stale handler teardown is inert.
+  frontcap_shared_detach_ = BindSharedClockController(clock,
+      frontcap_shared_controller_factory_.GetWeakPtr());
+  clock->shared_suspension.clear();
+  return Response::Success();
+}
+
+void PageHandler::BindFrontcapCookieClock(
+    RenderFrameHostImpl* frame, base::ReadOnlySharedMemoryRegion region,
+    base::OnceCallback<void(bool)> callback) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) ||
+      !region.IsValid()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  auto target = FrontcapDialogContents(frame);
+  if (!std::holds_alternative<WebContentsImpl*>(target)) {
+    std::move(callback).Run(false);
+    return;
+  }
+  auto* contents = std::get<WebContentsImpl*>(target);
+  auto* state = DialogState(contents, true);
+  if (state->cookie_clock_frame.get() != frame) {
+    std::move(callback).Run(false);
+    return;
+  }
+  auto* clock = CookieClockForFrame(frame);
+  if (clock->shared_time.IsValid() &&
+      static_cast<const blink::frontcap::SharedControl*>(clock->shared_control_mapping.memory())->activated.load(std::memory_order_acquire) &&
+      region.GetGUID() != clock->shared_time.region.GetGUID()) {
+    std::move(callback).Run(false); return;
+  }
+  // Independent live tabs must not compete for one cookie store's clock.
+  // A replacement may inherit it only after the previous tab closes.
+  if (clock->tab && clock->tab.get() != contents &&
+      !clock->tab->IsBeingDestroyed()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  clock->tab = contents->GetWeakPtr();
+  clock->bindings.push_back(
+      {frame->GetWeakPtr(), std::move(region), std::move(callback)});
+  ProcessCookieClockBindings(clock);
+}
