+void StoragePartitionImpl::FrontcapWaitForDomStorageWrites(
+    base::OnceCallback<void(std::optional<std::string>)> callback) {
+  if (frontcap_dom_storage_loss_) {
+    std::move(callback).Run(frontcap_dom_storage_loss_);
+    return;
+  }
+  std::set<mojo::ReceiverId> live;
+  for (const auto& client : dom_storage_clients_)
+    live.insert(client.first);
+  FrontcapConfirmDomStorageWrites(
+      live,
+      base::BindOnce(
+          [](base::WeakPtr<StoragePartitionImpl> partition,
+             base::OnceCallback<void(std::optional<std::string>)> callback,
+             bool complete) {
+            if (!partition) {
+              std::move(callback).Run("The storage partition was destroyed");
+              return;
+            }
+            if (partition->frontcap_dom_storage_loss_) {
+              std::move(callback).Run(partition->frontcap_dom_storage_loss_);
+              return;
+            }
+            if (!complete) {
+              std::move(callback).Run(
+                  "A renderer's DOM storage write failed or was lost");
+              return;
+            }
+            std::move(callback).Run(std::nullopt);
+          },
+          weak_factory_.GetWeakPtr(), std::move(callback)));
+}
