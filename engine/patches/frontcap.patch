+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_STORAGE_STORAGE_MUTATION_BARRIER_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_STORAGE_STORAGE_MUTATION_BARRIER_H_
+
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/memory/ref_counted.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+
+namespace blink {
+// Same-sequence completion state shared by a controller and its issued writes.
+// Callbacks retain this state through completion; an on-complete closure can
+// also retain the write owner and its remote until the backend answers.
+class StorageMutationBarrier : public base::RefCounted<StorageMutationBarrier> {
+ public:
+  base::OnceCallback<void(bool)> Track(base::OnceClosure on_complete) {
+    ++pending_;
+    return mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+        base::BindOnce(&StorageMutationBarrier::Complete,
+                       base::RetainedRef(this), std::move(on_complete)), false);
+  }
+  void Wait(base::OnceCallback<void(bool)> callback) {
+    if (!pending_) {
+      std::move(callback).Run(valid_);
+      return;
+    }
+    waiters_.push_back(std::move(callback));
+  }
+  // Reconnection can reconcile a lost backend with optimistic renderer state.
+  // Capture cannot certify that history as complete.
+  void Invalidate() { valid_ = false; }
+
+ private:
+  friend class base::RefCounted<StorageMutationBarrier>;
+  ~StorageMutationBarrier() = default;
+  void Complete(base::OnceClosure on_complete, bool success) {
+    CHECK_GT(pending_, 0u);
+    valid_ &= success;
+    std::move(on_complete).Run();
+    if (--pending_)
+      return;
+    auto waiters = std::move(waiters_);
+    for (auto& callback : waiters)
+      std::move(callback).Run(valid_);
+  }
+  size_t pending_ = 0;
+  bool valid_ = true;
+  Vector<base::OnceCallback<void(bool)>> waiters_;
+};
+}  // namespace blink
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_STORAGE_STORAGE_MUTATION_BARRIER_H_
