+// static
+void ProcessTimeOverrideCoordinator::FrontcapBlock(
+    base::PlatformThreadRef owner) {
+  auto& self = Instance();
+  base::AutoLock auto_lock(self.lock_);
+  self.FrontcapSharedHoldLocked();
+  ++self.FrontcapBlocksForOwnerLocked(owner).blocks;
