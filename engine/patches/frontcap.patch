+bool DevToolsURLLoaderInterceptor::MatchesPatterns(
+    const std::vector<Pattern>& patterns, bool handle_auth) const {
+  if (handle_auth != handle_auth_ || patterns.size() != patterns_.size())
+    return false;
+  for (size_t i = 0; i < patterns.size(); ++i) {
+    if (patterns[i].url_pattern != patterns_[i].url_pattern ||
+        patterns[i].resource_types != patterns_[i].resource_types ||
+        patterns[i].interception_stage != patterns_[i].interception_stage)
+      return false;
+  }
+  return true;
+}
+
+void DevToolsURLLoaderInterceptor::BindConsumer(
+    RequestInterceptedCallback callback,
+    CheckCookieAccessCallback cookie_callback) {
+  CHECK(!HasConsumer());
+  request_intercepted_callback_ = std::move(callback);
+  cookie_access_callback_ = std::move(cookie_callback);
+}
+
+void DevToolsURLLoaderInterceptor::UnbindConsumer() {
+  request_intercepted_callback_.Reset();
+  // No dead client's authority survives detachment.
+  cookie_access_callback_ = base::BindRepeating(
+      [](const net::CanonicalCookie&) { return false; });
+}
+
+void DevToolsURLLoaderInterceptor::ReplayPendingRequests() {
+  CHECK(HasConsumer());
+  auto callback = request_intercepted_callback_;
+  std::vector<std::unique_ptr<InterceptedRequestInfo>> pending;
+  for (const auto& id : pending_order_)
+    pending.push_back(pending_requests_.at(id)->Clone());
+  for (auto& info : pending)
+    callback.Run(std::move(info));
+}
+
+void DevToolsURLLoaderInterceptor::PublishRequest(
+    std::unique_ptr<InterceptedRequestInfo> info) {
+  if (controlled_) {
+    if (!pending_requests_.contains(info->interception_id))
+      pending_order_.push_back(info->interception_id);
+    pending_requests_[info->interception_id] = info->Clone();
+  }
+  if (HasConsumer())
+    request_intercepted_callback_.Run(std::move(info));
+}
+
+bool DevToolsURLLoaderInterceptor::InspectNavigation(const std::string& id) {
+  auto it = pending_requests_.find(id);
+  if (!controlled_ || it == pending_requests_.end() ||
+      !it->second->is_navigation || it->second->response_headers)
+    return false;
+  inspected_navigation_ = id;
+  return true;
+}
+
+void DevToolsURLLoaderInterceptor::RemovePendingRequest(const std::string& id) {
+  if (inspected_navigation_ == id)
+    inspected_navigation_.clear();
+  pending_requests_.erase(id);
+  std::erase(pending_order_, id);
+}
+
+void DevToolsURLLoaderInterceptor::RecordReceipt(FrontcapReceipt receipt) {
