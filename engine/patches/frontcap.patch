+// The renderer answers a presented frame on viz's acknowledgement; the browser
+// records the activation when viz tells it, on another path. A receipt asked
+// after that frame waits for it, so it never names the frame before.
+void PageHandler::FrontcapAnswerPresentedFrame(
+    uint32_t after,
+    base::TimeTicks deadline,
+    std::unique_ptr<GetPresentedFrameCallback> callback) {
+  if (!host_) {
+    callback->sendFailure(Response::ServerError("the frame is gone"));
+    return;
+  }
+  auto* provider =
+      host_->GetRenderWidgetHost()->render_frame_metadata_provider();
+  bool activated = provider->LastActivatedFrameToken() >= after;
+  if (!activated && base::TimeTicks::Now() < deadline) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&PageHandler::FrontcapAnswerPresentedFrame,
+                       weak_factory_.GetWeakPtr(), after, deadline,
+                       std::move(callback)),
+        base::Milliseconds(1));
+    return;
+  }
+  const auto& metadata = provider->LastRenderFrameMetadata();
+  if (!activated || metadata.frontcap_document_token.empty() ||
+      !metadata.local_surface_id || !metadata.local_surface_id->is_valid() ||
+      !provider->LastActivatedFrameToken()) {
+    callback->sendSuccess(false, "", "", "", 0, false);
+    return;
+  }
+  std::string document_token = metadata.frontcap_document_token;
+  bool current_document =
+      document_token == host_->GetDocumentToken().ToString();
+  callback->sendSuccess(true, metadata.local_surface_id->ToString(),
+                        base::NumberToString(provider->LastActivatedFrameToken()),
+                        document_token, metadata.frontcap_paint_time_ms,
+                        current_document);
+}
