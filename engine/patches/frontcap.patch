+protocol::Response InspectorEmulationAgent::frontcapGetWorkers(
+    std::unique_ptr<protocol::Array<protocol::Emulation::FrontcapWorker>>* workers) {
+  auto response = AssertPage();
+  if (!response.IsSuccess()) return response;
+  if (!base::FeatureList::IsEnabled(features::kFrontcapVirtualWorkers))
+    return protocol::Response::ServerError("controlled workers are not enabled");
+  LocalFrame* root = web_local_frame_->GetFrame();
+  std::vector<base::UnguessableToken> documents;
+  for (Frame* frame = root; frame; frame = frame->Tree().TraverseNext(root)) {
+    auto* local = DynamicTo<LocalFrame>(frame);
+    if (local && local->GetProbeSink() == root->GetProbeSink() && local->GetDocument())
+      documents.push_back(local->GetDocument()->Token().value());
+  }
+  *workers = std::make_unique<protocol::Array<protocol::Emulation::FrontcapWorker>>();
+  for (const auto& worker : FrontcapWorkersForDocuments(documents)) {
+    auto entry = protocol::Emulation::FrontcapWorker::create()
+        .setTargetId(String::FromUtf8(worker.token.ToString()))
+        .setCreatorId(String::FromUtf8(worker.creator.ToString()))
+        .setCreatorIsWorker(worker.creator_is_worker)
+        .setSequence(String::Number(worker.sequence))
+        .setScriptUrl(String::FromUtf8(worker.script_url))
+        .setThreadStarted(worker.thread_started)
+        .build();
+    if (worker.synchronous_wait)
+      entry->setSynchronousWaitId(String::Number(worker.synchronous_wait));
+    if (worker.frame_opportunity)
+      entry->setFrameOpportunity(String::Number(worker.frame_opportunity));
+    if (!worker.frame_receiver.empty())
+      entry->setFrameReceiver(String::FromUtf8(worker.frame_receiver));
+    (*workers)->emplace_back(std::move(entry));
+  }
+  return protocol::Response::Success();
+}
