+
+void FrontcapWorkerStarted(const base::UnguessableToken& token) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapVirtualWorkers)) return;
+  auto& states = GetWorkerStates();
+  base::AutoLock lock(states.lock);
+  if (auto it = states.live.find(token); it != states.live.end())
+    it->second.thread_started = true;
+}
+
+void FrontcapWorkerRetired(const base::UnguessableToken& token) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapVirtualWorkers)) return;
+  std::vector<base::OnceCallback<void(bool, bool)>> completions;
+  std::vector<base::OnceCallback<void(bool)>> pause_completions;
+  auto& states = GetWorkerStates();
+  {
+    base::AutoLock lock(states.lock);
+    std::set<base::UnguessableToken> retired{token};
+    bool changed;
+    do {
+      changed = false;
+      for (auto it = states.live.begin(); it != states.live.end();) {
+        if (retired.contains(it->first) ||
+            (it->second.creator_is_worker && retired.contains(it->second.creator))) {
+          retired.insert(it->first);
+          auto endpoint = states.frames.find(it->first);
+          if (endpoint != states.frames.end()) {
+            if (endpoint->second.completion)
+              completions.push_back(std::move(endpoint->second.completion));
+            if (endpoint->second.pause_completion)
+              pause_completions.push_back(std::move(endpoint->second.pause_completion));
+            states.frames.erase(endpoint);
+          }
+          it = states.live.erase(it);
+          changed = true;
+        } else {
+          ++it;
+        }
+      }
+    } while (changed);
+  }
+  // Reply outside the registry lock. Owner loss is not a delivered frame.
+  for (auto& completion : completions)
+    std::move(completion).Run(false, false);
+  for (auto& completion : pause_completions)
+    std::move(completion).Run(false);
+}
+
+void FrontcapRegisterWorkerFrameEndpoint(
+    const base::UnguessableToken& token,
+    scoped_refptr<base::SingleThreadTaskRunner> runner,
+    base::RepeatingCallback<void(uint64_t, base::Time, base::UnguessableToken)> dispatch) {
+  auto& states = GetWorkerStates();
+  base::AutoLock lock(states.lock);
+  if (!states.live.contains(token)) return;
+  CHECK(!states.frames.contains(token));
+  auto& endpoint = states.frames[token];
+  endpoint.runner = std::move(runner);
+  endpoint.dispatch = std::move(dispatch);
+}
+
+void FrontcapWorkerFrameDemand(const base::UnguessableToken& token, bool pending) {
+  auto& states = GetWorkerStates();
+  base::AutoLock lock(states.lock);
+  if (auto it = states.live.find(token); it != states.live.end())
+    it->second.frame_pending = pending;
+}
+
+void FrontcapDispatchWorkerFrame(
+    const base::UnguessableToken& token, uint64_t opportunity,
+    base::Time instant, const base::UnguessableToken& clock,
+    base::OnceCallback<void(bool, bool)> completion) {
+  // The receiver belongs to a process-control sequence, not the worker.
+  auto reply = base::BindPostTask(base::SequencedTaskRunner::GetCurrentDefault(),
+                                 std::move(completion));
+  scoped_refptr<base::SingleThreadTaskRunner> runner;
+  base::RepeatingCallback<void(uint64_t, base::Time, base::UnguessableToken)> dispatch;
+  auto& states = GetWorkerStates();
+  bool no_callbacks = false;
+  {
+    base::AutoLock lock(states.lock);
+    auto worker = states.live.find(token);
+    auto endpoint = states.frames.find(token);
+    if (worker != states.live.end() && endpoint != states.frames.end() &&
+        opportunity > endpoint->second.last_opportunity &&
+        !endpoint->second.completion) {
+      endpoint->second.last_opportunity = opportunity;
+      endpoint->second.instant = instant;
+      endpoint->second.clock = clock;
+      CHECK(!endpoint->second.callback_running);
+      CHECK(!endpoint->second.pause_completion);
+      endpoint->second.paused = false;
+      endpoint->second.deferred.Reset();
+      no_callbacks = !worker->second.frame_pending;
+      if (!no_callbacks) {
+        worker->second.frame_opportunity = opportunity;
+        worker->second.frame_receiver.clear();
+        endpoint->second.completion = std::move(reply);
+        runner = endpoint->second.runner;
+        dispatch = endpoint->second.dispatch;
+      }
+    }
+  }
+  if (!runner) {
+    std::move(reply).Run(no_callbacks, false);
+    return;
+  }
+  if (!runner->PostTask(FROM_HERE,
+                       base::BindOnce(std::move(dispatch), opportunity, instant, clock)))
+    FrontcapCompleteWorkerFrame(token, opportunity, false);
+}
+
+// Replace the old receiver only for the exact paused native operation. Its
+// provider still owns the original BeginFrame and callback cursor. No dispatch
+// closure is invoked here, including for workers that already completed it.
+void FrontcapResumeWorkerFrame(
+    const base::UnguessableToken& token, uint64_t opportunity,
+    base::Time instant, const base::UnguessableToken& clock,
+    const std::string& receiver, base::OnceCallback<void(bool, bool)> completion) {
+  auto reply = base::BindPostTask(base::SequencedTaskRunner::GetCurrentDefault(),
+                                 std::move(completion));
+  base::OnceCallback<void(bool, bool)> former;
+  scoped_refptr<base::SingleThreadTaskRunner> runner;
+  base::OnceClosure deferred;
+  auto& states = GetWorkerStates();
+  {
+    base::AutoLock lock(states.lock);
+    const auto worker = states.live.find(token);
+    const auto found = states.frames.find(token);
+    if (worker != states.live.end() && found != states.frames.end()) {
+      auto& endpoint = found->second;
+      if (worker->second.frame_opportunity == opportunity &&
+          endpoint.last_opportunity == opportunity && endpoint.completion &&
+          endpoint.paused && !endpoint.pause_completion && endpoint.clock == clock &&
+          instant >= endpoint.instant &&
+          (!endpoint.callback_running || worker->second.synchronous_wait)) {
+        worker->second.frame_receiver = receiver;
+        former = std::move(endpoint.completion);
+        endpoint.completion = std::move(reply);
+        endpoint.paused = false;
+        runner = endpoint.runner;
+        deferred = std::move(endpoint.deferred);
+      }
+    }
+  }
+  if (!former) {
+    std::move(reply).Run(false, false);
+    return;
+  }
+  // The old inspector may still exist, but must never finish or render this
+  // operation. It receives refusal outside the registry lock.
+  std::move(former).Run(false, false);
+  if (deferred && !runner->PostTask(FROM_HERE, std::move(deferred)))
+    FrontcapCompleteWorkerFrame(token, opportunity, false);
+}
+
+bool FrontcapWorkerFrameIsCurrent(const base::UnguessableToken& token,
+                                 uint64_t opportunity) {
+  auto& states = GetWorkerStates();
+  base::AutoLock lock(states.lock);
+  auto endpoint = states.frames.find(token);
+  return states.live.contains(token) && endpoint != states.frames.end() &&
+      endpoint->second.last_opportunity == opportunity &&
+      !!endpoint->second.completion;
+}
+
+void FrontcapSetWorkerFramePaused(
+    const base::UnguessableToken& token, uint64_t opportunity, bool paused,
+    base::OnceCallback<void(bool)> completion) {
+  auto reply = base::BindPostTask(base::SequencedTaskRunner::GetCurrentDefault(),
+                                 std::move(completion));
+  scoped_refptr<base::SingleThreadTaskRunner> runner;
+  base::OnceClosure deferred;
+  bool accepted = false;
+  auto& states = GetWorkerStates();
+  {
+    base::AutoLock lock(states.lock);
+    auto worker = states.live.find(token);
+    auto found = states.frames.find(token);
+    if (worker != states.live.end() && found != states.frames.end()) {
+      auto& endpoint = found->second;
+      if (endpoint.last_opportunity == opportunity && !endpoint.pause_completion) {
+        accepted = true;
+        if (endpoint.completion) {
+          endpoint.paused = paused;
+          if (paused && endpoint.callback_running && !worker->second.synchronous_wait) {
+            endpoint.pause_completion = std::move(reply);
+            return;
+          }
+          if (!paused) {
+            runner = endpoint.runner;
+            deferred = std::move(endpoint.deferred);
+          }
+        }
+      }
+    }
+  }
+  if (deferred && !runner->PostTask(FROM_HERE, std::move(deferred))) {
+    FrontcapCompleteWorkerFrame(token, opportunity, false);
+    accepted = false;
+  }
+  std::move(reply).Run(accepted);
+}
+
+bool FrontcapDeferWorkerFrame(const base::UnguessableToken& token,
+                             uint64_t opportunity, base::OnceClosure retry) {
+  auto& states = GetWorkerStates();
+  base::AutoLock lock(states.lock);
+  auto found = states.frames.find(token);
+  if (!states.live.contains(token) || found == states.frames.end() ||
+      found->second.last_opportunity != opportunity || !found->second.completion)
+    return true;
+  if (!found->second.paused) return false;
+  found->second.deferred = std::move(retry);
+  return true;
+}
+
+bool FrontcapBeginWorkerFrameCallback(const base::UnguessableToken& token,
+                                     uint64_t opportunity, base::OnceClosure retry) {
+  auto& states = GetWorkerStates();
+  base::AutoLock lock(states.lock);
+  auto found = states.frames.find(token);
+  if (!states.live.contains(token) || found == states.frames.end() ||
+      found->second.last_opportunity != opportunity || !found->second.completion)
+    return false;
+  auto& endpoint = found->second;
+  if (endpoint.paused) {
+    endpoint.deferred = std::move(retry);
+    return false;
+  }
+  CHECK(!endpoint.callback_running);
+  endpoint.callback_running = true;
+  return true;
+}
+
+void FrontcapEndWorkerFrameCallback(const base::UnguessableToken& token,
+                                   uint64_t opportunity) {
+  base::OnceCallback<void(bool)> reply;
+  auto& states = GetWorkerStates();
+  {
+    base::AutoLock lock(states.lock);
+    auto found = states.frames.find(token);
+    if (found == states.frames.end() || found->second.last_opportunity != opportunity)
+      return;
+    found->second.callback_running = false;
+    reply = std::move(found->second.pause_completion);
+  }
+  if (reply) std::move(reply).Run(true);
+}
+
+void FrontcapCompleteWorkerFrame(const base::UnguessableToken& token,
+                                uint64_t opportunity, bool settled) {
+  base::OnceCallback<void(bool, bool)> completion;
+  base::OnceCallback<void(bool)> pause_completion;
+  bool pending = false;
+  auto& states = GetWorkerStates();
+  {
+    base::AutoLock lock(states.lock);
+    auto endpoint = states.frames.find(token);
+    if (endpoint == states.frames.end() ||
+        endpoint->second.last_opportunity != opportunity) return;
+    completion = std::move(endpoint->second.completion);
+    pause_completion = std::move(endpoint->second.pause_completion);
+    endpoint->second.callback_running = false;
+    endpoint->second.paused = false;
+    endpoint->second.deferred.Reset();
+    if (auto worker = states.live.find(token); worker != states.live.end()) {
+      worker->second.frame_opportunity = 0;
+      pending = worker->second.frame_pending;
+    }
+  }
+  if (pause_completion) std::move(pause_completion).Run(settled);
+  if (completion) std::move(completion).Run(settled, pending);
+}
+
+void FrontcapWorkerWaitChanged(const base::UnguessableToken& token,
+                              uint64_t request) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapVirtualWorkers)) return;
+  auto& states = GetWorkerStates();
+  base::OnceCallback<void(bool)> reply;
+  {
+    base::AutoLock lock(states.lock);
+    if (auto it = states.live.find(token); it != states.live.end()) {
+      it->second.synchronous_wait = request;
+      auto endpoint = states.frames.find(token);
+      if (request && endpoint != states.frames.end() && endpoint->second.paused)
+        reply = std::move(endpoint->second.pause_completion);
+    }
+  }
+  if (reply) std::move(reply).Run(true);
+}
+
+std::vector<FrontcapWorkerState> FrontcapWorkersInProcess() {
+  auto& states = GetWorkerStates();
+  base::AutoLock lock(states.lock);
+  std::vector<FrontcapWorkerState> result;
+  for (const auto& [token, worker] : states.live) result.push_back(worker);
+  return result;
+}
+
+std::vector<FrontcapWorkerState> FrontcapWorkersForDocuments(
+    const std::vector<base::UnguessableToken>& documents) {
+  auto& states = GetWorkerStates();
+  base::AutoLock lock(states.lock);
+  std::set<base::UnguessableToken> roots(documents.begin(), documents.end());
+  std::set<base::UnguessableToken> included;
+  std::vector<FrontcapWorkerState> result;
+  bool changed;
+  do {
+    changed = false;
+    for (const auto& [token, worker] : states.live) {
+      if (!included.contains(token) &&
+          (worker.creator_is_worker ? included.contains(worker.creator)
+                                    : roots.contains(worker.creator))) {
+        result.push_back(worker);
+        included.insert(token);
+        changed = true;
+      }
+    }
+  } while (changed);
+  return result;
+}
