+  auto& self = Instance();
+  base::AutoLock auto_lock(self.lock_);
+  if (!suspended) self.FrontcapSharedHoldLocked();
+  for (auto it = self.frontcap_blocks_.begin();
+       it != self.frontcap_blocks_.end(); ++it) {
+    if (it->owner == owner) {
+      it->suspended = suspended;
+      if (!suspended && it->blocks == 0 && it->enrollments == 0) {
+        self.frontcap_blocks_.erase(it);
+      }
+      break;
+    }
+  }
+  if (suspended) {
+    self.FrontcapMaybeAdvanceLocked();
+  }
+}
+
+// static
+void ProcessTimeOverrideCoordinator::FrontcapArriveAt(base::Time arrival) {
+  auto& self = Instance();
