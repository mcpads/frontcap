+            if (!owner || owner->snapshot_inventory_error_) {
+              std::move(callback).Run("Local storage restore was interrupted");
+            } else if (!status.ok()) {
+              std::move(callback).Run(status.ToString());
+            } else {
+              std::move(callback).Run(std::nullopt);
+            }
+          }, weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
