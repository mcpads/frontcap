+std::variant<Response, WebContentsImpl*> FrontcapDialogContents(
+    RenderFrameHostImpl* host) {
+  if (!host) {
+    return Response::ServerError("Not attached to a page");
+  }
+  if (host->GetParentOrOuterDocument() ||
+      !host->frame_tree_node()->frame_tree().is_primary()) {
