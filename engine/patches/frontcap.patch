+}
+
+Response FetchHandler::FrontcapPendingRequests(
+    std::unique_ptr<protocol::Array<String>>* request_ids) {
+  if (!controlled_ || !interceptor_)
+    return Response::ServerError("no controlled interception");
+  *request_ids = std::make_unique<protocol::Array<String>>();
+  for (const auto& id : interceptor_->PendingRequests())
+    (*request_ids)->emplace_back(id);
+  return Response::Success();
+}
+
+Response FetchHandler::FrontcapReceipts(
+    std::unique_ptr<protocol::Array<protocol::Fetch::FrontcapReceipt>>*
+        receipts) {
+  if (!controlled_ || !interceptor_)
+    return Response::ServerError("no controlled interception");
+  *receipts = std::make_unique<protocol::Array<protocol::Fetch::FrontcapReceipt>>();
+  for (const auto& r : interceptor_->Receipts()) {
+    std::string outcome;
+    switch (r.outcome) {
+      case FrontcapReceipt::Outcome::kFulfilled:
+        outcome = protocol::Fetch::FrontcapReceipt::OutcomeEnum::Fulfilled;
+        break;
+      case FrontcapReceipt::Outcome::kFailed:
+        outcome = protocol::Fetch::FrontcapReceipt::OutcomeEnum::Failed;
+        break;
+      case FrontcapReceipt::Outcome::kContinued:
+        outcome = protocol::Fetch::FrontcapReceipt::OutcomeEnum::Continued;
+        break;
+      case FrontcapReceipt::Outcome::kCancelled:
+        outcome = protocol::Fetch::FrontcapReceipt::OutcomeEnum::Cancelled;
+        break;
+    }
+    auto receipt = protocol::Fetch::FrontcapReceipt::Create()
+                       .SetRequestId(r.id)
+                       .SetOutcome(outcome)
+                       .Build();
+    if (r.response_code)
+      receipt->SetResponseCode(*r.response_code);
+    if (r.body_sha256)
+      receipt->SetBodySha256(*r.body_sha256);
+    if (r.completed) {
+      receipt->SetCompleted(true);
+      receipt->SetNetError(r.net_error);
+    }
+    (*receipts)->push_back(std::move(receipt));
+  }
+  return Response::Success();
+}
+
+Response FetchHandler::FrontcapForgetReceipts(
+    std::unique_ptr<protocol::Array<protocol::String>> request_ids) {
+  if (!controlled_ || !interceptor_)
+    return Response::ServerError("no controlled interception");
+  interceptor_->ForgetReceipts(*request_ids);
+  return Response::Success();
+}
