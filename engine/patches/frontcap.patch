+          std::move(indexed_db), std::move(caches), std::move(callback));
+  auto* manager = GetQuotaManagerProxy();
+  manager->GetBucketByNameUnsafe(
+      params.storage_key, params.name,
+      base::SequencedTaskRunner::GetCurrentDefault(),
+      base::BindOnce(
+          [](scoped_refptr<storage::QuotaManagerProxy> manager,
+             storage::BucketInitParams params, bool create_if_missing,
+             base::OnceCallback<void(
+                 storage::QuotaErrorOr<storage::BucketInfo>)> bound,
+             storage::QuotaErrorOr<storage::BucketInfo> existing) {
+            if (existing.has_value() ||
+                existing.error() != storage::QuotaError::kNotFound ||
+                !create_if_missing) {
+              std::move(bound).Run(std::move(existing));
+              return;
+            }
+            params.persistent = false;
+            params.durability = blink::mojom::BucketDurability::kRelaxed;
+            // Exact creation refuses a conflicting concurrent creation instead
+            // of mutating its policy or deleting its data.
+            manager->FrontcapRestoreBucket(
+                params, base::SequencedTaskRunner::GetCurrentDefault(),
+                std::move(bound));
+          },
+          base::WrapRefCounted(manager), params, create_if_missing,
+          std::move(bound)));
+}
