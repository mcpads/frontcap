+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_LOADER_FRONTCAP_DOCUMENT_ADMISSION_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_LOADER_FRONTCAP_DOCUMENT_ADMISSION_H_
+
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/wtf/allocator/allocator.h"
+
+namespace blink {
+
+class DocumentLoader;
+class LocalFrame;
+
+// frontcap engine patch 51: under controlled virtual time, committed document
+// bodies are admitted one at a time, in the order their navigations started
+// (a navigation the browser started is placed when it commits). A body is
+// admitted only while progress is granted, once the current instant has no
+// counted load, no ready task (tasks posted at this instant behind the loading
+// pause's fences included, as for a frame) and no admitted body still
+// arriving; until its navigation has committed, a later document waits. Commit arrival order and
+// grant boundaries, which follow host timing, no longer decide which document
+// parses first or which documents parse within one task.
+class CORE_EXPORT FrontcapDocumentAdmission {
+  STATIC_ONLY(FrontcapDocumentAdmission);
+
+ public:
+  // A navigation of `frame` started in this renderer; it takes its place now.
+  static void NavigationStarted(LocalFrame& frame);
+  // Freezes a committing loader and queues its body. False when admission is
+  // not controlled (virtual time is not enabled), and the loader is untouched.
+  static bool WillCommit(LocalFrame& frame, DocumentLoader& loader);
+  // Whether `loader`'s body waits for its turn: it stays frozen whatever else
+  // resumes loading (a dialog resuming its page).
+  static bool Awaits(const DocumentLoader& loader);
+  // A navigation ended, a body finished or a hold changed: admission may
+  // proceed or a pending entry may be gone.
+  static void Changed();
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_LOADER_FRONTCAP_DOCUMENT_ADMISSION_H_
