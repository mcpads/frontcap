+#include "base/atomicops.h"
+#include "base/logging.h"
 #include "net/cookies/cookie_store.h"
 
 #include <utility>
@@ -11,6 +13,45 @@
 
 namespace net {
 
+bool CookieStore::SetFrontcapClock(
+    const std::string& owner, base::ReadOnlySharedMemoryRegion region) {
+  if (owner.empty() || !region.IsValid() ||
+      region.GetSize() != sizeof(base::subtle::Atomic64))
+    return false;
+  if (frontcap_clock_region_.IsValid()) {
+    if (owner != frontcap_clock_owner_) return false;
+    if (region.GetGUID() == frontcap_clock_region_.GetGUID()) return true;
+  }
+  auto mapping = region.Map();
+  if (!mapping.IsValid()) return false;
+  if (frontcap_clock_mapping_.IsValid()) {
+    const auto* previous = static_cast<const base::subtle::Atomic64*>(
+        frontcap_clock_mapping_.memory());
+    const auto* incoming = static_cast<const base::subtle::Atomic64*>(mapping.memory());
+    // Transfer only at the same committed epoch. Never reseed or choose a
+    // renderer's requested future budget as the cookie store's current time.
+    const auto previous_us = base::subtle::Acquire_Load(previous);
+    const auto incoming_us = base::subtle::Acquire_Load(incoming);
+    if (previous_us != incoming_us) {
+      LOG(ERROR) << "frontcap cookie clock transfer epoch mismatch: "
+                 << previous_us << " -> " << incoming_us;
+      return false;
+    }
+  }
+  frontcap_clock_owner_ = owner;
+  frontcap_clock_region_ = std::move(region);
+  frontcap_clock_mapping_ = std::move(mapping);
+  return true;
+}
+
+base::Time CookieStore::CookieTimeNow() const {
+  if (!frontcap_clock_mapping_.IsValid()) return base::Time::Now();
+  const auto* value = static_cast<const base::subtle::Atomic64*>(
+      frontcap_clock_mapping_.memory());
+  return base::Time::UnixEpoch() +
+         base::Microseconds(base::subtle::Acquire_Load(value));
+}
+
 CookieStore::CookieStore() = default;
 
 CookieStore::~CookieStore() = default;
