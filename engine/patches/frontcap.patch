+        mojom::blink::IDBTransactionMode::ReadOnly,
+        mojom::blink::IDBTransactionDurability::Default);
+    for (wtf_size_t i = 0; i < stores_.size(); ++i) {
+      const auto& store = stores_[i];
+      database_->Count(
+          kReadbackTransactionId, store.metadata->id,
+          IDBIndexMetadata::kInvalidId,
+          mojom::blink::IDBKeyRange::New(IDBKey::CreateNone(),
+                                         IDBKey::CreateNone(), false, false),
+          BindOnce(&IDBInitialization::DidCount, WrapWeakPersistent(this), i));
+      for (wtf_size_t j = 0; j < store.records.size(); ++j) {
+        const auto& key = store.records[j].key;
+        database_->Get(
+            kReadbackTransactionId, store.metadata->id,
+            IDBIndexMetadata::kInvalidId,
