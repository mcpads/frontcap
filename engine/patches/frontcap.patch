+// Inspector access to an existing database at a stopped boundary. Reads
+// use `requestDatabase`, `requestData` and `getMetadata`; keyed writes commit
+// through the same inspector-owned connection. The
+// standard reads wait for `IDBRequest` events the page's IndexedDB queue
+// delivers, which waits behind a stopped instant; these talk to the database
+// service through the inspector's own connection (engine patch 42), so no page
+// task runs and virtual time does not move. A missing database is refused at its
+// upgrade, which is aborted: the open creates nothing.
+class StoppedDatabaseRequest final : public GarbageCollected<StoppedDatabaseRequest>,
+                          public ExecutionContextLifecycleObserver,
+                          public mojom::blink::IDBFactoryClient,
+                          public mojom::blink::IDBDatabaseCallbacks,
+                          public mojom::blink::IDBDatabaseGetAllResultSink {
+ public:
+  struct Data {
+    String store;
+    std::optional<String> index;
+    mojom::blink::IDBKeyRangePtr range;
+    int skip;
+    int page;
+  };
+
+  StoppedDatabaseRequest(ExecutionContext* context,
+              InspectorIndexedDBAgent* agent,
+              const String& name)
+      : ExecutionContextLifecycleObserver(context),
+        agent_(agent),
+        name_(name),
+        factory_client_(this, context),
+        database_callbacks_(this, context),
+        database_(context),
+        transaction_(context),
+        version_change_(context),
+        sink_(this, context) {}
+
+  void ForDatabase(
+      std::unique_ptr<protocol::IndexedDB::Backend::RequestDatabaseCallback> c) {
+    database_callback_ = std::move(c);
+  }
+  void ForData(
+      Data data,
+      std::unique_ptr<protocol::IndexedDB::Backend::RequestDataCallback> c) {
+    data_ = std::move(data);
+    data_callback_ = std::move(c);
+  }
+  void ForMetadata(
+      const String& store,
+      std::unique_ptr<protocol::IndexedDB::Backend::GetMetadataCallback> c) {
+    metadata_store_ = store;
+    metadata_callback_ = std::move(c);
+  }
+  void ForWrite(
+      const String& store,
+      std::unique_ptr<IDBKey> key,
+      std::optional<String> value,
+      std::unique_ptr<protocol::IndexedDB::Backend::FrontcapWriteRecordCallback> c) {
+    metadata_store_ = store;
+    write_key_ = std::move(key);
+    write_value_ = std::move(value);
+    write_callback_ = std::move(c);
+  }
+  void SetCompletion(base::OnceClosure completion) {
+    completion_ = std::move(completion);
+  }
+
+  void Start(protocol::Response response, IDBFactory* factory) {
+    if (!Pending()) {
+      return;
+    }
+    if (!response.IsSuccess()) {
+      Fail(response);
+      return;
+    }
+    factory->ConnectForDevTools(
+        BindOnce(&StoppedDatabaseRequest::Connected, WrapWeakPersistent(this)));
+  }
+  void StartWithInspectorFactory(mojom::blink::IDBFactory* factory) {
+    Connected(factory);
+  }
+  void Cancel() { Fail(protocol::Response::ServerError(kInterrupted)); }
+
+  void ContextDestroyed() override { Cancel(); }
+  void Trace(Visitor* visitor) const override {
+    visitor->Trace(agent_);
+    visitor->Trace(factory_client_);
+    visitor->Trace(database_callbacks_);
+    visitor->Trace(database_);
+    visitor->Trace(transaction_);
+    visitor->Trace(version_change_);
+    visitor->Trace(sink_);
+    ExecutionContextLifecycleObserver::Trace(visitor);
+  }
+
+  // IDBFactoryClient.
+  void Error(mojom::blink::IDBException, const String& message) override {
+    if (message == String(kFrontcapUnfinishedVersionChange)) {
+      Fail(protocol::Response::ServerError(message.Utf8()));
+      return;
+    }
+    Fail(protocol::Response::ServerError("Could not open database: " +
+                                         message.Utf8()));
+  }
+  void Blocked(int64_t) override {
+    Fail(protocol::Response::ServerError(
+        "Could not open database: a version change is pending."));
+  }
+  void UpgradeNeeded(
+      mojo::PendingAssociatedRemote<mojom::blink::IDBDatabase> remote,
+      int64_t,
+      mojom::blink::IDBDataLoss,
+      const String&,
+      const IDBDatabaseMetadata&) override {
+    database_.Bind(std::move(remote), Runner());
+    database_->Abort(kOpenTransactionId);
+    Fail(protocol::Response::ServerError("Could not open database: it does not exist."));
+  }
+  void OpenSuccess(
+      mojo::PendingAssociatedRemote<mojom::blink::IDBDatabase> remote,
+      const IDBDatabaseMetadata& metadata) override {
+    if (!Pending()) {
+      return;
+    }
+    if (remote.is_valid()) {
+      database_.Bind(std::move(remote), Runner());
+    }
+    if (!database_.is_bound()) {
+      Cancel();
+      return;
+    }
+    database_.set_disconnect_handler(
+        BindOnce(&StoppedDatabaseRequest::Cancel, WrapWeakPersistent(this)));
+    factory_client_.reset();
+    if (database_callback_) {
+      SendDatabase(metadata);
+      return;
+    }
+    const String& store_name = data_callback_ ? data_.store : metadata_store_;
+    const IDBObjectStoreMetadata* store = nullptr;
+    for (const auto& entry : metadata.object_stores) {
+      if (entry.value->name == store_name) {
+        store = entry.value.get();
+      }
+    }
+    if (!store) {
+      Fail(protocol::Response::ServerError("Could not get object store."));
+      return;
+    }
+    int64_t index_id = IDBIndexMetadata::kInvalidId;
+    if (data_callback_ && data_.index && !data_.index->empty()) {
+      for (const auto& entry : store->indexes) {
+        if (entry.value->name == *data_.index) {
+          index_id = entry.value->id;
+        }
+      }
+      if (index_id == IDBIndexMetadata::kInvalidId) {
+        Fail(protocol::Response::ServerError("Could not get index."));
+        return;
+      }
+      by_index_ = true;
+    }
+    std::unique_ptr<IDBValue> value;
+    Vector<IDBIndexKeys> indexes;
+    if (write_callback_ && write_value_ && !PrepareWrite(*store, value, indexes)) {
+      Fail(protocol::Response::InvalidParams(
+          "Invalid JSON value or inline key differs from the selected key."));
+      return;
+    }
+    database_->CreateTransaction(
+        transaction_.BindNewEndpointAndPassReceiver(Runner()),
+        kReadTransactionId, Vector<int64_t>{store->id},
+        write_callback_ ? mojom::blink::IDBTransactionMode::ReadWrite
+                        : mojom::blink::IDBTransactionMode::ReadOnly,
+        mojom::blink::IDBTransactionDurability::Default);
+    if (write_callback_) {
+      if (write_value_) {
+        transaction_->Put(store->id, std::move(value), IDBKey::Clone(write_key_),
+                          mojom::blink::IDBPutMode::AddOrUpdate,
+                          std::move(indexes),
+                          BindOnce(&StoppedDatabaseRequest::DidWrite,
+                                   WrapWeakPersistent(this)));
+      } else {
+        database_->DeleteRange(
+            kReadTransactionId, store->id,
+            mojom::blink::IDBKeyRange::New(IDBKey::Clone(write_key_),
+                                           IDBKey::Clone(write_key_), false, false),
+            BindOnce(&StoppedDatabaseRequest::DidRemove,
+                     WrapWeakPersistent(this)));
+      }
+      return;
+    }
+    if (metadata_callback_) {
+      database_->Count(
+          kReadTransactionId, store->id, IDBIndexMetadata::kInvalidId,
+          mojom::blink::IDBKeyRange::New(IDBKey::CreateNone(),
+                                         IDBKey::CreateNone(), false, false),
+          BindOnce(&StoppedDatabaseRequest::DidCount, WrapWeakPersistent(this)));
+      database_->GetKeyGeneratorCurrentNumber(
+          kReadTransactionId, store->id,
+          BindOnce(&StoppedDatabaseRequest::DidGetGenerator, WrapWeakPersistent(this)));
+      return;
+    }
+    const uint64_t wanted = static_cast<uint64_t>(data_.skip) +
+                            static_cast<uint64_t>(data_.page) + 1;
+    database_->GetAll(
+        kReadTransactionId, store->id, index_id, std::move(data_.range),
+        mojom::blink::IDBGetAllResultType::Records,
+        static_cast<uint32_t>(std::min<uint64_t>(wanted, 1u << 20)),
+        mojom::blink::IDBCursorDirection::Next,
+        BindOnce(&StoppedDatabaseRequest::DidGetAll, WrapWeakPersistent(this)));
+  }
+  void DeleteSuccess(int64_t) override { Cancel(); }
+
+  // IDBDatabaseCallbacks.
+  void ForcedClose() override { Cancel(); }
+  void VersionChange(int64_t, int64_t) override {
+    // Never hold up the application's upgrade.
+    Fail(protocol::Response::ServerError(
+        "The database changed version during the operation."));
+  }
+  void Abort(int64_t,
+             mojom::blink::IDBException,
+             const String& message) override {
+    if (message == String(kFrontcapUnfinishedWrite) ||
+        message == String(kFrontcapUnfinishedTransaction)) {
+      Fail(protocol::Response::ServerError(message.Utf8()));
+      return;
+    }
+    Cancel();
+  }
+  void Complete(int64_t id) override {
+    if (write_callback_ && id == kReadTransactionId && commit_sent_) {
+      auto callback = std::move(write_callback_);
+      callback->sendSuccess();
+      Close();
+    }
+  }
+
+  // IDBDatabaseGetAllResultSink.
+  void ReceiveResults(Vector<mojom::blink::IDBRecordPtr> records,
+                      bool done) override {
+    for (auto& record : records) {
+      records_.push_back(std::move(record));
+    }
+    if (done) {
+      sink_.reset();
+      SendData();
+    }
+  }
+  void OnError(mojom::blink::IDBErrorPtr error) override {
+    Fail(protocol::Response::ServerError("Could not read records: " +
+                                         error->error_message.Utf8()));
+  }
+
+ private:
+  static constexpr int64_t kOpenTransactionId = 1;
+  static constexpr int64_t kReadTransactionId = 2;
+  static constexpr char kInterrupted[] = "The IndexedDB operation was interrupted.";
+
+  bool Pending() const {
+    return database_callback_ || data_callback_ || metadata_callback_ || write_callback_;
+  }
+  scoped_refptr<base::SingleThreadTaskRunner> Runner() {
+    return GetExecutionContext()->GetTaskRunner(TaskType::kInternalInspector);
+  }
+
+  bool PrepareWrite(const IDBObjectStoreMetadata& store,
+                    std::unique_ptr<IDBValue>& output,
+                    Vector<IDBIndexKeys>& indexes) {
+    // A fresh realm prevents page prototypes/getters from influencing JSON or
+    // index key extraction. No page microtasks are run.
+    auto* context = GetExecutionContext();
+    auto* isolate = context->GetIsolate();
+    v8::HandleScope handles(isolate);
+    auto* world = DOMWrapperWorld::Create(
+        isolate, DOMWrapperWorld::WorldType::kInspectorIsolated);
+    if (!world) return false;
+    auto realm = v8::Context::New(isolate);
+    auto* state = MakeGarbageCollected<ScriptStateImpl>(realm, world, *context);
+    base::ScopedClosureRunner dispose(BindOnce(
+        [](ScriptState* state, DOMWrapperWorld* world) {
+          state->DisposePerContextData();
+          state->DissociateContext();
+          world->Dispose();
+        }, WrapPersistent(state), WrapPersistent(world)));
+    ScriptState::Scope scope(state);
+    v8::MicrotasksScope no_microtasks(isolate, realm->GetMicrotaskQueue(),
+                                      v8::MicrotasksScope::kDoNotRunMicrotasks);
+    v8::TryCatch catcher(isolate);
+    v8::Local<v8::Value> value;
+    if (!v8::JSON::Parse(realm, V8String(isolate, *write_value_)).ToLocal(&value))
+      return false;
+    ExceptionState exception(isolate);
+    if (!store.key_path.IsNull()) {
+      auto key = CreateIDBKeyFromValueAndKeyPath(
+          isolate, value, store.key_path, exception);
+      if (exception.HadException() || !key || !key->IsValid() ||
+          !key->IsEqual(write_key_.get())) return false;
+    }
+    for (const auto& entry : store.indexes) {
+      indexes.push_back(IDBIndexKeys{
+          .id = entry.key,
+          .keys = GenerateIndexKeysForValue(isolate, store, *entry.value,
+                                            ScriptValue(isolate, value))});
+    }
+    SerializedScriptValue::SerializeOptions options;
+    options.for_storage = SerializedScriptValue::kForStorage;
+    auto serialized = SerializedScriptValue::Serialize(isolate, value, options, exception);
+    if (exception.HadException()) return false;
+    output = std::make_unique<IDBValue>();
+    Vector<uint8_t> wire;
+    wire.append_range(serialized->GetWireData());
+    output->SetData(std::move(wire));
+    return true;
+  }
+  void DidWrite(mojom::blink::IDBTransactionPutResultPtr result) {
+    if (!write_callback_) return;
+    if (result->is_error_result()) {
+      database_->Abort(kReadTransactionId);
+      Fail(protocol::Response::ServerError(
+          "IndexedDB write failed: " + result->get_error_result()->error_message.Utf8()));
+      return;
+    }
+    if (!result->get_key()->IsValid() ||
+        !result->get_key()->IsEqual(write_key_.get())) {
+      database_->Abort(kReadTransactionId);
+      Fail(protocol::Response::ServerError("IndexedDB write returned another key."));
+      return;
+    }
+    DidRemove(true);
+  }
+  void DidRemove(bool success) {
+    if (!write_callback_) return;
+    if (!success) {
+      database_->Abort(kReadTransactionId);
+      Fail(protocol::Response::ServerError("IndexedDB record deletion failed."));
+      return;
+    }
+    commit_sent_ = true;
+    transaction_->Commit(0);
+  }
+
+  void Connected(mojom::blink::IDBFactory* factory) {
+    if (!Pending()) {
+      return;
+    }
+    if (!factory) {
+      Fail(protocol::Response::ServerError(
+          "IndexedDB storage permission denied."));
+      return;
+    }
+    auto client = factory_client_.BindNewEndpointAndPassRemote(Runner());
+    auto callbacks = database_callbacks_.BindNewEndpointAndPassRemote(Runner());
+    factory_client_.set_disconnect_handler(
+        BindOnce(&StoppedDatabaseRequest::Cancel, WrapWeakPersistent(this)));
+    factory->Open(std::move(client), std::move(callbacks), name_,
+                  IDBDatabaseMetadata::kNoVersion,
+                  version_change_.BindNewEndpointAndPassReceiver(Runner()),
+                  kOpenTransactionId, kFrontcapStoppedReadPriority, false);
+  }
+
+  void SendDatabase(const IDBDatabaseMetadata& metadata) {
+    auto object_stores =
+        std::make_unique<protocol::Array<protocol::IndexedDB::ObjectStore>>();
+    for (const auto& store_entry : metadata.object_stores) {
+      const IDBObjectStoreMetadata& store = *store_entry.value;
+      auto indexes = std::make_unique<
+          protocol::Array<protocol::IndexedDB::ObjectStoreIndex>>();
+      for (const auto& index_entry : store.indexes) {
+        const IDBIndexMetadata& index = *index_entry.value;
+        indexes->emplace_back(ObjectStoreIndex::create()
+                                  .setName(index.name)
+                                  .setKeyPath(KeyPathFromIDBKeyPath(index.key_path))
+                                  .setUnique(index.unique)
+                                  .setMultiEntry(index.multi_entry)
+                                  .build());
+      }
+      object_stores->emplace_back(
+          ObjectStore::create()
+              .setName(store.name)
+              .setKeyPath(KeyPathFromIDBKeyPath(store.key_path))
+              .setAutoIncrement(store.auto_increment)
+              .setIndexes(std::move(indexes))
+              .build());
+    }
+    auto callback = std::move(database_callback_);
+    callback->sendSuccess(DatabaseWithObjectStores::create()
+                              .setName(metadata.name)
+                              .setVersion(metadata.version)
+                              .setObjectStores(std::move(object_stores))
+                              .build());
+    Close();
+  }
+
+  void DidCount(bool success, uint32_t count) {
+    if (!metadata_callback_) {
+      return;
+    }
+    if (!success) {
+      Fail(protocol::Response::ServerError("Could not count entries."));
+      return;
+    }
+    count_ = count;
+    MaybeSendMetadata();
+  }
+  void DidGetGenerator(int64_t value, mojom::blink::IDBErrorPtr error) {
+    if (!metadata_callback_) {
+      return;
+    }
+    if (error) {
+      Fail(protocol::Response::ServerError("Could not read the key generator."));
+      return;
+    }
+    generator_ = value;
+    MaybeSendMetadata();
+  }
+  void MaybeSendMetadata() {
+    if (!count_ || !generator_) {
+      return;
+    }
+    auto callback = std::move(metadata_callback_);
+    callback->sendSuccess(*count_, *generator_);
+    Close();
+  }
+
+  void DidGetAll(
+      Vector<mojom::blink::IDBRecordPtr> records,
+      mojo::PendingAssociatedReceiver<mojom::blink::IDBDatabaseGetAllResultSink>
+          receiver) {
+    if (!data_callback_) {
+      return;
+    }
+    for (auto& record : records) {
+      records_.push_back(std::move(record));
+    }
+    if (receiver.is_valid()) {
+      sink_.Bind(std::move(receiver), Runner());
+      return;
+    }
+    SendData();
+  }
+  // Records as the standard read wraps them: the session's remote objects in
+  // the document's main world, made without running page script.
+  void SendData() {
+    if (!data_callback_) {
+      return;
+    }
+    ScriptState* script_state = ToScriptState(GetExecutionContext());
+    if (!agent_ || !script_state || !script_state->ContextIsValid()) {
+      Fail(protocol::Response::ServerError(kSessionDetachedDuringOperation));
+      return;
+    }
+    V8SessionHolder v8_session = agent_->V8Session();
+    if (!v8_session) {
+      Fail(protocol::Response::ServerError(kSessionDetachedDuringOperation));
+      return;
+    }
+    ScriptState::Scope scope(script_state);
+    v8::Isolate* isolate = script_state->GetIsolate();
+    v8::Local<v8::Context> context = script_state->GetContext();
+    v8::MicrotasksScope no_microtasks(isolate, context->GetMicrotaskQueue(),
+                                      v8::MicrotasksScope::kDoNotRunMicrotasks);
+    v8_inspector::StringView group = ToV8InspectorStringView(kIndexedDBObjectGroup);
+    auto entries = std::make_unique<protocol::Array<DataEntry>>();
+    const wtf_size_t skip = static_cast<wtf_size_t>(std::max(data_.skip, 0));
+    const wtf_size_t page = static_cast<wtf_size_t>(std::max(data_.page, 0));
+    for (wtf_size_t i = skip; i < records_.size() && i < skip + page; ++i) {
+      auto& record = records_[i];
+      if (!record->return_value || !record->primary_key ||
+          !*record->primary_key) {
+        continue;
+      }
+      std::unique_ptr<IDBValue> value =
+          IDBValue::ConvertReturnValue(record->return_value);
+      if (IDBValueUnwrapper::IsWrapped(value.get())) {
+        Fail(protocol::Response::ServerError(
+            "A record is held outside the database (a large value)."));
+        return;
+      }
+      value->SetIsolate(isolate);
+      const IDBKey* primary = record->primary_key->get();
+      const IDBKey* key = by_index_ && record->index_key && *record->index_key
+                              ? record->index_key->get()
+                              : primary;
+      entries->emplace_back(
+          DataEntry::create()
+              .setKey(v8_session->wrapObject(context, key->ToV8(script_state),
+                                             group, true))
+              .setPrimaryKey(v8_session->wrapObject(
+                  context, primary->ToV8(script_state), group, true))
+              .setValue(v8_session->wrapObject(
+                  context, DeserializeIDBValue(script_state, value.get()), group,
+                  true))
+              .build());
+    }
+    const bool has_more = records_.size() > skip + page;
+    auto callback = std::move(data_callback_);
+    callback->sendSuccess(std::move(entries), has_more);
+    Close();
+  }
+
+  // Resetting the connection closes it, so the page's upgrades are not held.
+  void Close() {
+    factory_client_.reset();
+    database_callbacks_.reset();
+    transaction_.reset();
+    version_change_.reset();
+    sink_.reset();
+    database_.reset();
+    if (completion_) {
+      std::move(completion_).Run();
+    }
+  }
+  void Fail(protocol::Response response) {
+    if (database_callback_) {
+      std::move(database_callback_)->sendFailure(response);
+    }
+    if (data_callback_) {
+      std::move(data_callback_)->sendFailure(response);
+    }
+    if (metadata_callback_) {
+      std::move(metadata_callback_)->sendFailure(response);
+    }
+    if (write_callback_) {
+      auto callback = std::move(write_callback_);
+      callback->sendFailure(response);
+    }
+    Close();
+  }
+
+  WeakMember<InspectorIndexedDBAgent> agent_;
+  String name_;
+  Data data_;
+  String metadata_store_;
+  std::unique_ptr<IDBKey> write_key_;
+  std::optional<String> write_value_;
+  std::unique_ptr<protocol::IndexedDB::Backend::FrontcapWriteRecordCallback> write_callback_;
+  bool commit_sent_ = false;
+  bool by_index_ = false;
+  std::unique_ptr<protocol::IndexedDB::Backend::RequestDatabaseCallback>
+      database_callback_;
+  std::unique_ptr<protocol::IndexedDB::Backend::RequestDataCallback>
+      data_callback_;
+  std::unique_ptr<protocol::IndexedDB::Backend::GetMetadataCallback>
+      metadata_callback_;
+  base::OnceClosure completion_;
+  HeapMojoAssociatedReceiver<mojom::blink::IDBFactoryClient, StoppedDatabaseRequest>
+      factory_client_;
+  HeapMojoAssociatedReceiver<mojom::blink::IDBDatabaseCallbacks, StoppedDatabaseRequest>
+      database_callbacks_;
+  HeapMojoAssociatedRemote<mojom::blink::IDBDatabase> database_;
+  HeapMojoAssociatedRemote<mojom::blink::IDBTransaction> transaction_;
+  HeapMojoAssociatedRemote<mojom::blink::IDBTransaction> version_change_;
+  HeapMojoAssociatedReceiver<mojom::blink::IDBDatabaseGetAllResultSink,
+                             StoppedDatabaseRequest>
+      sink_;
+  Vector<mojom::blink::IDBRecordPtr> records_;
+  std::optional<uint32_t> count_;
+  std::optional<int64_t> generator_;
+};
+
+bool InspectorIndexedDBAgent::UsesStoppedAccess() const {
+  return base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen) &&
+         !worker_global_scope_;
+}
+
+void InspectorIndexedDBAgent::StartStoppedRequest(
+    std::unique_ptr<protocol::Storage::StorageBucket> storage_bucket,
+    ExecutionContext* context,
+    StoppedDatabaseRequest* request) {
+  FrontcapStorageScope* scope = nullptr;
+  if (storage_bucket && inspected_frames_->Root()) {
+    std::optional<String> bucket_name;
+    if (storage_bucket->hasName()) {
+      bucket_name = storage_bucket->getName("");
+    }
+    scope = FrontcapStorageScopes::From(*inspected_frames_->Root()->DomWindow())
+                .Find(storage_bucket->getStorageKey(), bucket_name);
+  }
+  stopped_requests_.insert(request);
+  request->SetCompletion(BindOnce(
+      [](InspectorIndexedDBAgent* agent, StoppedDatabaseRequest* request) {
+        if (agent) {
+          agent->stopped_requests_.erase(request);
+        }
+      },
+      WrapWeakPersistent(this), WrapWeakPersistent(request)));
+  if (scope) {
+    request->StartWithInspectorFactory(
+        scope->indexed_db.is_bound() ? scope->indexed_db.get() : nullptr);
+    return;
+  }
+  ExecutableWithIdbFactory::Start(
+      context, std::move(storage_bucket),
+      BindOnce(&StoppedDatabaseRequest::Start, WrapWeakPersistent(request)));
+}
+
+void InspectorIndexedDBAgent::frontcapWriteRecord(
+    std::unique_ptr<protocol::Storage::StorageBucket> storage_bucket,
+    const String& database_name, const String& object_store_name,
+    std::unique_ptr<protocol::IndexedDB::Key> key, bool remove,
+    std::optional<String> value_json,
+    std::unique_ptr<FrontcapWriteRecordCallback> callback) {
+  if (!UsesStoppedAccess()) {
+    callback->sendFailure(protocol::Response::ServerError(
+        "Native IndexedDB writes require a frontcap frame."));
+    return;
+  }
+  if (database_name.length() > 1024 || object_store_name.length() > 1024 ||
+      remove == value_json.has_value() ||
+      (value_json && value_json->length() > 2 * 1024 * 1024) ||
+      !IDBInitialization::ValidRecordKey(key.get())) {
+    callback->sendFailure(protocol::Response::InvalidParams("Invalid record write."));
+    return;
+  }
+  auto resolved = ResolveExecutionContext(inspected_frames_.Get(), nullptr,
+      std::nullopt, std::nullopt, storage_bucket);
+  // Explicit previously bound storage scopes may belong to another origin.
+  if (storage_bucket && inspected_frames_->Root()) {
+    auto* root = inspected_frames_->Root()->DomWindow();
+    std::optional<String> bucket;
+    if (storage_bucket->hasName()) bucket = storage_bucket->getName("");
+    if (FrontcapStorageScopes::From(*root).Find(storage_bucket->getStorageKey(), bucket))
+      resolved = root;
+  }
+  if (!resolved.has_value()) {
+    callback->sendFailure(resolved.error());
+    return;
+  }
+  auto* request = MakeGarbageCollected<StoppedDatabaseRequest>(
+      resolved.value(), this, database_name);
+  request->ForWrite(object_store_name, IdbKeyFromInspectorObject(key.get()),
