+      Finish(protocol::Response::ServerError(
+          "IndexedDB storage permission denied."));
+      return;
+    }
+    auto client = factory_client_.BindNewEndpointAndPassRemote(Runner());
+    auto callbacks = database_callbacks_.BindNewEndpointAndPassRemote(Runner());
+    auto transaction = transaction_.BindNewEndpointAndPassReceiver(Runner());
+    factory_client_.set_disconnect_handler(
+        BindOnce(&IDBInitialization::Cancel, WrapWeakPersistent(this)));
+    database_callbacks_.set_disconnect_handler(
+        BindOnce(&IDBInitialization::Cancel, WrapWeakPersistent(this)));
+    factory->Open(std::move(client), std::move(callbacks), name_, version_,
+                  std::move(transaction), kTransactionId, 0, false);
+  }
+  void DidPut(wtf_size_t store_index,
+              wtf_size_t record_index,
+              mojom::blink::IDBTransactionPutResultPtr result) {
+    if (!callback_ || !failure_.empty()) {
+      return;
+    }
+    if (result->is_error_result()) {
+      failure_ = result->get_error_result()->error_message;
+      if (failure_.empty()) {
+        failure_ = "Record insertion failed.";
+      }
+      database_->Abort(kTransactionId);
+      return;
+    }
+    auto& record = stores_[store_index].records[record_index];
+    if (!result->get_key()->IsValid() ||
+        result->get_key()->GetType() == mojom::IDBKeyType::None ||
+        (record.key->GetType() != mojom::IDBKeyType::None &&
+         !record.key->IsEqual(result->get_key().get()))) {
+      failure_ = "Backend returned an unexpected primary key.";
+      database_->Abort(kTransactionId);
+      return;
+    }
+    record.key = std::move(result->get_key());
+    --pending_puts_;
+    MaybeCommit();
+  }
+  void MaybeCommit() {
+    if (!pending_puts_ && failure_.empty() && !commit_sent_) {
+      commit_sent_ = true;
+      transaction_->Commit(0);
+    }
+  }
+  bool SchemaMatches(const IDBDatabaseMetadata& actual) const {
+    if (actual.name != name_ || actual.version != version_ ||
+        actual.object_stores.size() != stores_.size()) {
+      return false;
+    }
+    for (const auto& store : stores_) {
+      const auto& expected = *store.metadata;
+      auto found = actual.object_stores.find(expected.id);
+      if (found == actual.object_stores.end()) {
+        return false;
+      }
+      const auto& observed = *found->value;
+      if (observed.name != expected.name ||
+          !(observed.key_path == expected.key_path) ||
+          observed.auto_increment != expected.auto_increment ||
+          observed.indexes.size() != expected.indexes.size()) {
+        return false;
+      }
+      for (const auto& index : expected.indexes) {
+        auto observed_index = observed.indexes.find(index.key);
+        if (observed_index == observed.indexes.end()) {
+          return false;
+        }
+        const auto& a = *observed_index->value;
+        const auto& e = *index.value;
+        if (a.name != e.name || !(a.key_path == e.key_path) ||
+            a.unique != e.unique || a.multi_entry != e.multi_entry) {
+          return false;
+        }
+      }
+    }
+    return true;
+  }
+  void ReadbackFailed() {
+    Finish(protocol::Response::ServerError(
+        "IndexedDB initialization committed but native readback failed. Do not "
+        "reapply initialization."));
