+
+void InspectorEmulationAgent::FrontcapRunOwnedWorkerFrames(
+    std::unique_ptr<RunMainFrameCallback> callback,
+    int deferrals, uint64_t opportunity, const String& receiver) {
+  virtual_time_controller_->FrontcapServeFrameWork(true);
+  web_local_frame_->GetFrame()->GetLocalFrameHostRemote().FrontcapOwnedWorkerFrames(
+      true, (base::Time::Now() - base::Time::UnixEpoch()).InMicroseconds(), opportunity, std::nullopt, receiver,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          BindOnce([](WeakPersistent<InspectorEmulationAgent> agent,
+                      std::unique_ptr<RunMainFrameCallback> callback,
+                      int deferrals, uint64_t epoch, bool accepted, bool pending) {
+            if (!agent || agent->frontcap_frame_epoch_ != epoch) {
+              callback->sendFailure(protocol::Response::ServerError(
+                  "Worker frame owner was retired"));
+              return;
+            }
+            agent->virtual_time_controller_->FrontcapServeFrameWork(false);
+            if (!accepted) {
+              callback->sendFailure(protocol::Response::ServerError(
+                  "Owned worker frame did not settle"));
+              return;
+            }
+            agent->FrontcapRunMainFrameWhenIdle(std::move(callback), deferrals,
+                                               true, pending);
+          }, WrapWeakPersistent(this), std::move(callback), deferrals,
+          frontcap_frame_epoch_), false, false));
+}
+
+void InspectorEmulationAgent::FrontcapDrawMainFrame(
+    std::unique_ptr<RunMainFrameCallback> callback, bool cut_off,
+    bool worker_wanted) {
+  WebFrameWidgetImpl* widget =
+      web_local_frame_ ? web_local_frame_->LocalRootFrameWidget() : nullptr;
+  if (!widget) {
+    callback->sendFailure(protocol::Response::ServerError("No frame widget"));
+    return;
+  }
+  // Answered on this thread; destroyed on it too, wherever cc drops it.
+  widget->FrontcapRunOneMainFrame(base::BindPostTask(
+      web_local_frame_->GetTaskRunner(TaskType::kInternalInspector),
+      BindOnce(
+          [](WeakPersistent<InspectorEmulationAgent> agent,
+             std::unique_ptr<RunMainFrameCallback> callback, bool cut_off, bool worker_wanted,
+             bool rendered, bool presented, uint32_t presented_frame,
+             std::optional<base::TimeTicks> next_image) {
+            // How long until a page or worker task can ask the page for a frame.
+            std::optional<double> next_wake_up;
+            if (agent) {
+              std::optional<base::TimeDelta> delay =
+                  agent->virtual_time_controller_->FrontcapDelayToNextWakeUp();
+              // frontcap engine patch 10: or until an animated image's next
+              // frame is due (this thread's clock is the page's).
+              if (next_image) {
+                base::TimeDelta until = std::max(
+                    base::TimeDelta(), *next_image - base::TimeTicks::Now());
+                delay = delay ? std::min(*delay, until) : until;
+              }
+              if (delay)
+                next_wake_up = delay->InMillisecondsF();
+            }
+            if (worker_wanted) next_wake_up = 0.0;
+            callback->sendSuccess(
+                rendered, presented, next_wake_up,
+                cut_off ? std::optional<bool>(true) : std::nullopt,
+                presented_frame ? std::optional<String>(String::Number(presented_frame))
+                                : std::nullopt);
+          },
+          WrapWeakPersistent(this), std::move(callback), cut_off, worker_wanted)));
 }
 
