+Response StorageHandler::FrontcapGetOriginSite(
+    const std::string& origin_string,
+    std::string* site) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen)) {
+    return Response::ServerError("frontcap storage control is disabled");
+  }
+  const GURL parsed(origin_string);
+  const url::Origin origin = url::Origin::Create(parsed);
+  if (!parsed.SchemeIsHTTPOrHTTPS() || origin.opaque() ||
+      origin.Serialize() != origin_string) {
+    return Response::InvalidParams("Expected a canonical HTTP(S) origin");
+  }
+  *site = net::SchemefulSite(origin).Serialize();
+  return Response::Success();
+}
+
+Response StorageHandler::FrontcapGrantStorageScope(
+    const std::string& origin,
+    std::optional<std::string> top_level_site,
+    std::optional<bool> has_cross_site_ancestor,
+    std::optional<std::string> bucket_name,
+    std::optional<bool> create_if_missing,
+    std::string* serialized_storage_key,
+    std::string* scope_token) {
+  auto response = FrontcapResolveStorageKey(origin, top_level_site,
+                                            has_cross_site_ancestor, serialized_storage_key);
+  if (!response.IsSuccess()) {
+    return response;
+  }
+  if (bucket_name && !IsValidBucketName(*bucket_name)) {
+    return Response::InvalidParams("Invalid storage bucket name");
+  }
+  const auto client = frame_host_->GetBucketClientInfo();
+  if (frontcap_scope_client_ != client || !frontcap_scope_lifetime_) {
+    frontcap_scope_lifetime_ = std::make_shared<int>(0);
+    frontcap_scope_client_ = client;
+  }
+  const auto key = blink::StorageKey::Deserialize(*serialized_storage_key);
+  CHECK(key);
+  auto token = static_cast<StoragePartitionImpl*>(storage_partition_.get())
+                   ->GetBucketManager()
+                   ->GrantFrontcapScope({*key, std::move(bucket_name), client,
+                                         frontcap_scope_lifetime_,
+                                         create_if_missing.value_or(true)},
+                                        base::PassKey<StorageHandler>());
+  if (!token) {
+    return Response::ServerError("Storage scope grant unavailable or capacity exhausted");
+  }
+  *scope_token = *token;
+  return Response::Success();
+}
+
+Response StorageHandler::FrontcapResolveStorageKey(
+    const std::string& origin_string,
+    std::optional<std::string> top_level_site_string,
+    std::optional<bool> has_cross_site_ancestor,
+    std::string* serialized_storage_key) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen)) {
+    return Response::ServerError("frontcap storage control is disabled");
+  }
+  if (!frame_host_ || !storage_partition_) {
+    return Response::ServerError("Expected a live document target");
+  }
+  const GURL origin_url(origin_string);
+  const url::Origin origin = url::Origin::Create(origin_url);
+  if (!origin_url.SchemeIsHTTPOrHTTPS() || origin.opaque() ||
+      origin.Serialize() != origin_string ||
+      !network::IsOriginPotentiallyTrustworthy(origin)) {
+    return Response::InvalidParams("Expected a canonical trustworthy HTTP(S) origin");
+  }
+  const net::SchemefulSite origin_site(origin);
+  net::SchemefulSite top_level_site = origin_site;
+  if (top_level_site_string) {
+    const GURL site_url(*top_level_site_string);
+    top_level_site = net::SchemefulSite(site_url);
+    if (!site_url.SchemeIsHTTPOrHTTPS() || top_level_site.opaque() ||
+        top_level_site.Serialize() != *top_level_site_string) {
+      return Response::InvalidParams("Expected a canonical HTTP(S) top-level site");
+    }
+  }
+  const bool cross_site = has_cross_site_ancestor.value_or(top_level_site != origin_site);
+  if (!cross_site && top_level_site != origin_site) {
+    return Response::InvalidParams("A different top-level site requires a cross-site ancestor");
+  }
+  const auto ancestor = cross_site ? blink::mojom::AncestorChainBit::kCrossSite
+                                 : blink::mojom::AncestorChainBit::kSameSite;
+  const blink::StorageKey key = blink::StorageKey::Create(origin, top_level_site, ancestor);
+  // Never silently seed the first-party store when partitioning is unavailable.
+  if (key.top_level_site() != top_level_site || key.ancestor_chain_bit() != ancestor) {
+    return Response::ServerError("The requested storage partition is unavailable");
+  }
+  *serialized_storage_key = key.Serialize();
+  return Response::Success();
+}
