+  static bool ParseKeyPath(protocol::IndexedDB::KeyPath* input,
+                           IDBKeyPath* output) {
+    const String type = input->getType();
+    if (type == "null" && !input->hasString() && !input->hasArray()) {
+      *output = IDBKeyPath();
+      return true;
+    }
+    if (type == "string" && input->hasString() && !input->hasArray() &&
+        input->getString("").length() <= 1024) {
+      *output = IDBKeyPath(input->getString(""));
+      return output->IsValid();
+    }
+    if (type == "array" && input->hasArray() && !input->hasString() &&
+        input->getArray(nullptr)->size() <= 32) {
+      Vector<String> paths;
+      for (const String& path : *input->getArray(nullptr)) {
+        if (path.length() > 1024) {
+          return false;
+        }
+        paths.push_back(path);
+      }
+      *output = IDBKeyPath(paths);
+      return output->IsValid();
+    }
+    return false;
+  }
+  static bool ValidKey(protocol::IndexedDB::Key* key,
+                       unsigned depth,
+                       size_t* nodes) {
+    if (!key || depth > 32 || ++*nodes > 4096 ||
+        key->hasNumber() + key->hasString() + key->hasDate() +
+                key->hasArray() !=
+            1) {
+      return false;
+    }
+    if (key->getType() == "number") {
+      return key->hasNumber() && std::isfinite(key->getNumber(0));
+    }
+    if (key->getType() == "date") {
+      return key->hasDate() && std::isfinite(key->getDate(0)) &&
+             std::abs(key->getDate(0)) <= 8640000000000000.0 &&
+             std::trunc(key->getDate(0)) == key->getDate(0);
+    }
+    if (key->getType() == "string") {
+      return key->hasString() && key->getString("").length() <= 8192;
+    }
+    if (key->getType() != "array" || !key->hasArray()) {
+      return false;
+    }
+    for (const auto& child : *key->getArray(nullptr)) {
+      if (!ValidKey(child.get(), depth + 1, nodes)) {
+        return false;
+      }
+    }
+    return true;
+  }
+  scoped_refptr<base::SingleThreadTaskRunner> Runner() {
+    return GetExecutionContext()->GetTaskRunner(TaskType::kInternalInspector);
+  }
+  void Open(mojom::blink::IDBFactory* factory) {
+    if (!callback_) {
+      return;
