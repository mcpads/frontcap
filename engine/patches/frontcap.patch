+void InspectorCacheStorageAgent::frontcapBindStorageScope(
+    const String& storage_key, std::optional<String> bucket_name,
+    const String& token, std::unique_ptr<FrontcapBindStorageScopeCallback> callback) {
+  auto* frame = frames_->Root();
+  auto* context = frame ? frame->DomWindow() : nullptr;
+  if (!base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen) ||
+      !context || !context->GetSecurityOrigin()->CanAccessStorageBuckets()) {
+    callback->sendFailure(ProtocolResponse::ServerError("Storage scope requires an admitted document"));
+    return;
+  }
+  auto& registry = FrontcapStorageScopes::From(*context);
+  if (registry.scopes.size() >= 64 || registry.Find(storage_key, bucket_name)) {
+    callback->sendFailure(ProtocolResponse::InvalidParams("Storage scope is already bound or capacity exhausted"));
+    return;
+  }
+  const String owner_key = String::FromUtf8(static_cast<StorageKey>(context->GetStorageKey()).Serialize());
+  auto it = bucket_managers_.find(owner_key);
+  HeapMojoRemote<mojom::blink::BucketManagerHost>* manager;
+  if (it == bucket_managers_.end() || !it->value->Value().is_bound()) {
+    HeapMojoRemote<mojom::blink::BucketManagerHost> remote(context);
+    context->GetBrowserInterfaceBroker().GetInterface(
+        remote.BindNewPipeAndPassReceiver(frame->GetTaskRunner(TaskType::kInternalInspector)));
+    auto inserted = bucket_managers_.Set(owner_key, WrapDisallowNew(std::move(remote)));
+    manager = &inserted.stored_value->value->Value();
+  } else {
+    manager = &it->value->Value();
+  }
+  auto* scope = MakeGarbageCollected<FrontcapStorageScope>(context);
+  auto runner = frame->GetTaskRunner(TaskType::kInternalInspector);
+  manager->get()->BindFrontcapStorage(token,
+      scope->indexed_db.BindNewPipeAndPassReceiver(runner),
+      scope->caches.BindNewPipeAndPassReceiver(runner),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(blink::BindOnce(
+          [](ExecutionContext* context, FrontcapStorageScopes* registry,
+             FrontcapStorageScope* scope, const String& storage_key,
+             std::optional<String> bucket_name,
+             std::unique_ptr<FrontcapBindStorageScopeCallback> callback,
+             bool success, const String& actual_key, const String& actual_bucket) {
+            if (!context || context->IsContextDestroyed() || !success ||
+                storage_key != actual_key ||
+                bucket_name != (actual_bucket.IsNull() ? std::optional<String>() : std::optional<String>(actual_bucket)) ||
+                registry->Find(storage_key, bucket_name)) {
+              scope->Close();
+              callback->sendFailure(ProtocolResponse::ServerError("Storage scope binding failed; do not reuse the capability"));
+              return;
+            }
+            registry->scopes.Set(FrontcapStorageScopes::Key(storage_key, bucket_name), scope);
+            callback->sendSuccess();
+          }, WrapWeakPersistent(context), WrapPersistent(&registry), WrapPersistent(scope),
+          storage_key, bucket_name, std::move(callback)), false, String(), String()));
+}
