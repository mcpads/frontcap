+namespace {
+std::unique_ptr<Array<Storage::FrontcapDOMStorageArea>> BuildDOMStorageAreas(
+    std::vector<storage::mojom::DomStorageAreaSnapshotPtr> snapshots) {
+  auto areas = std::make_unique<Array<Storage::FrontcapDOMStorageArea>>();
+  for (auto& snapshot : snapshots) {
+    const auto& key = snapshot->storage_key;
+    auto entries = std::make_unique<Array<Storage::FrontcapDOMStorageEntry>>();
+    for (auto& entry : snapshot->entries) {
+      entries->push_back(Storage::FrontcapDOMStorageEntry::Create()
+          .SetKey(Binary::fromVector(std::move(entry->key)))
+          .SetValue(Binary::fromVector(std::move(entry->value))).Build());
+    }
+    areas->push_back(Storage::FrontcapDOMStorageArea::Create()
+        .SetStorageKey(key.Serialize()).SetOrigin(key.origin().Serialize())
+        .SetTopLevelSite(key.top_level_site().Serialize())
+        .SetHasCrossSiteAncestor(key.ancestor_chain_bit() ==
+                                blink::mojom::AncestorChainBit::kCrossSite)
+        .SetNoncePartition(key.nonce().has_value())
+        .SetFirstParty(key == blink::StorageKey::CreateFirstParty(key.origin()))
+        .SetEntries(std::move(entries)).Build());
+  }
+  return areas;
+}
