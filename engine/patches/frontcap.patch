+QuotaErrorOr<QuotaDatabase::FrontcapRestoredBucket>
+QuotaDatabase::FrontcapRestoreBucket(const BucketInitParams& params,
+                                     int max_bucket_count) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(params.persistent.has_value());
+  CHECK(params.durability.has_value());
+  // Default-bucket readback deliberately normalizes durability to relaxed.
+  // Refuse an unrepresentable exact policy before any database mutation.
+  if (params.name == kDefaultBucketName &&
+      *params.durability != blink::mojom::BucketDurability::kRelaxed) {
+    return base::unexpected(QuotaError::kUnknownError);
+  }
+  sqlite_error_code_ = 0;
+  auto found = GetBucket(params.storage_key, params.name);
+  if (found.has_value()) {
+    if (found->expiration != params.expiration ||
+        found->quota != params.quota ||
+        found->persistent != *params.persistent ||
+        found->durability != *params.durability) {
+      return base::unexpected(QuotaError::kEntryExistsError);
+    }
+    return FrontcapRestoredBucket{std::move(*found), false};
+  }
+  if (found.error() != QuotaError::kNotFound) {
+    return base::unexpected(found.error());
+  }
+  auto created = CreateBucketInternal(params, max_bucket_count);
+  if (!created.has_value()) {
+    created.error().sqlite_error = sqlite_error_code_;
+    return base::unexpected(created.error());
+  }
+  return FrontcapRestoredBucket{std::move(*created), true};
+}
