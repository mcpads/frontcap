+  // Clear native follow-up behavior before invoking application cancellation
+  // handlers. Existing selection/DOM effects are retained, not rolled back.
+  mouse_event_manager_->HandleMouseReleaseEventUpdateStates();
+  mouse_event_manager_->HandleSvgPanIfNeeded(true);
+  capturing_mouse_events_element_ = nullptr;
+  scroll_manager_->StopAutoscroll();
+  scroll_manager_->StopMiddleClickAutoscroll();
+  scroll_manager_->ClearResizeScrollableArea(false);
+  frame_set_being_resized_ = nullptr;
+  frame_->Selection().SetCaretBlinkingSuspended(false);
+  frame_->GetDocument()->UpdateHoverActiveState(
+      false, true, mouse_event_manager_->GetElementUnderMouse());
+  pointer_event_manager_->HandlePointerEvent(
+      WebPointerEvent::CreatePointerCausesUaActionEvent(
+          WebPointerProperties::PointerType::kMouse, base::TimeTicks::Now()),
+      Vector<WebPointerEvent>(), Vector<WebPointerEvent>());
+  // This also calls the local frame client's SetMouseCapture(false), releasing
+  // browser-side widget capture instead of only changing DOM pointer capture.
+  ReleaseMouseCaptureFromLocalRoot();
+  return true;
+}
