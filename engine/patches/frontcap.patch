+protocol::Response InspectorCacheStorageAgent::frontcapReleaseStorageScope(
+    const String& storage_key, std::optional<String> bucket_name) {
+  if (!base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen)) {
+    return ProtocolResponse::ServerError("frontcap storage control is disabled");
+  }
+  if (auto* frame = frames_->Root()) {
+    FrontcapStorageScopes::From(*frame->DomWindow()).Release(storage_key, bucket_name);
+  }
+  return ProtocolResponse::Success();
