+
+// static
+void ProcessTimeOverrideCoordinator::FrontcapUnblock(
+    base::PlatformThreadRef owner) {
+  auto& self = Instance();
+  base::AutoLock auto_lock(self.lock_);
+  for (auto it = self.frontcap_blocks_.begin();
+       it != self.frontcap_blocks_.end(); ++it) {
+    if (it->owner == owner) {
+      DCHECK_GT(it->blocks, 0);
+      if (--it->blocks == 0 && it->enrollments == 0 && !it->suspended) {
+        self.frontcap_blocks_.erase(it);
