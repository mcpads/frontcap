+  for (const auto& key : keys) {
+    auto read = base::BindOnce(
+        [](blink::StorageKey key,
+           base::RepeatingCallback<void(StatusOr<Area>)> complete,
+           StatusOr<SnapshotEntries> entries) {
+          if (!entries.has_value()) {
+            complete.Run(base::unexpected(entries.error()));
+            return;
+          }
+          complete.Run(Area(std::move(key), std::move(*entries)));
+        }, key, complete);
+    auto done = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+        std::move(read), StatusOr<SnapshotEntries>(base::unexpected(
+                             DbStatus::IOError("Session area disappeared"))));
+    scoped_refptr<SessionStorageDataMap> live;
+    auto area = storage_key_areas_.find(key);
+    auto metadata = maps.find(key);
+    if (area != storage_key_areas_.end()) {
+      live = area->second->data_map();
+    } else if (metadata != maps.end() && metadata->second->map_id()) {
+      // A purged area may still share a live, uncommitted map with a clone.
+      live = delegate_->MaybeGetExistingDataMapForId(
+          *metadata->second->map_id());
+    }
+    if (live) {
+      // The guarded callback reports destruction; retaining the map inside its
+      // own pending read callback would create a reference cycle.
+      live->storage_area()->ReadSnapshot(std::move(done));
+    } else if (database && metadata != maps.end()) {
+      database->ReadMapKeyValues(metadata->second->Clone(), std::move(done));
+    } else {
+      std::move(done).Run(base::unexpected(
+          DbStatus::IOError("Session area unavailable")));
+    }
+  }
+}
