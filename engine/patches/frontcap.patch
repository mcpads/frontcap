+        !opportunity || resume_worker_receiver->empty() || resume_worker_receiver->length() > 128 ||
+        !web_local_frame_ || !web_local_frame_->GetFrame() ||
+        !base::FeatureList::IsEnabled(features::kFrontcapVirtualWorkers) ||
+        !base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen)) {
+      callback->sendFailure(protocol::Response::InvalidParams(
+          "Controlled window and positive retained worker opportunity required"));
+      return;
+    }
+    FrontcapRunOwnedWorkerFrames(std::move(callback), 0, opportunity, *resume_worker_receiver);
+    return;
+  }
+  FrontcapRunMainFrameWhenIdle(std::move(callback), 0, false, false);
