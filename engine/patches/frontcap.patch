new file mode 100644
index 0000000..3786bbd
--- /dev/null
+++ b/storage/browser/quota/frontcap_quota_clock.h
@@ -0,0 +1,85 @@
+// Controlled quota time is owned by one storage partition, not the process.
+#ifndef STORAGE_BROWSER_QUOTA_FRONTCAP_QUOTA_CLOCK_H_
+#define STORAGE_BROWSER_QUOTA_FRONTCAP_QUOTA_CLOCK_H_
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/atomicops.h"
+#include "base/component_export.h"
+#include "base/memory/read_only_shared_memory_region.h"
+#include "base/memory/ref_counted.h"
+#include "base/synchronization/lock.h"
+#include "base/time/time.h"
+
+namespace storage {
+
+// Shared by the quota sequence and its database sequence. Mapping replacement
+// is locked; the renderer publishes the actual time with release/acquire loads.
+// A database may outlive its manager and retains this clock independently.
+class COMPONENT_EXPORT(STORAGE_BROWSER) FrontcapQuotaClock
+    : public base::RefCountedThreadSafe<FrontcapQuotaClock> {
+ public:
+  FrontcapQuotaClock();
+  bool Bind(const std::string& owner, base::ReadOnlySharedMemoryRegion region) {
+    if (owner.empty() || !region.IsValid() ||
+        region.GetSize() < sizeof(base::subtle::Atomic64)) {
+      return false;
+    }
+    base::AutoLock lock(lock_);
+    if (region_.IsValid()) {
+      if (owner_ != owner) {
+        return false;
+      }
+      if (region_.GetGUID() == region.GetGUID()) {
+        return true;
+      }
+    }
+    auto mapping = region.Map();
+    if (!mapping.IsValid()) {
+      return false;
+    }
+    const auto incoming = Read(mapping);
+    // A renderer handoff must join at the current instant, never reset time.
+    if (mapping_.IsValid() && Read(mapping_) != incoming) {
+      return false;
+    }
+    if (!mapping_.IsValid()) {
+      started_at_ = incoming;
+    }
+    owner_ = owner;
+    region_ = std::move(region);
+    mapping_ = std::move(mapping);
+    return true;
+  }
+  std::optional<base::Time> Now() const {
+    base::AutoLock lock(lock_);
+    if (!mapping_.IsValid()) {
+      return std::nullopt;
+    }
+    return Read(mapping_);
+  }
+  std::optional<base::Time> StartedAt() const {
+    base::AutoLock lock(lock_);
+    return started_at_;
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<FrontcapQuotaClock>;
+  ~FrontcapQuotaClock();
+  static base::Time Read(const base::ReadOnlySharedMemoryMapping& mapping) {
+    const auto* value =
+        static_cast<const base::subtle::Atomic64*>(mapping.memory());
+    return base::Time::UnixEpoch() +
+           base::Microseconds(base::subtle::Acquire_Load(value));
+  }
+  mutable base::Lock lock_;
+  std::string owner_;
+  base::ReadOnlySharedMemoryRegion region_;
+  base::ReadOnlySharedMemoryMapping mapping_;
+  std::optional<base::Time> started_at_;
+};
+
+}  // namespace storage
+#endif
