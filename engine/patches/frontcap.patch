+
+void StorageAreaImpl::RestoreEmptySnapshot(
+    ValueMap entries, base::OnceCallback<void(DbStatus)> callback) {
+  auto guarded = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      std::move(callback), DbStatus::IOError("Storage restore was interrupted"));
+  if (has_cached_read_) {
+    std::move(guarded).Run(DbStatus::InvalidArgument(
+        "Storage restoration must precede the first cache read"));
+    return;
+  }
+  if (snapshot_load_error_) {
+    std::move(guarded).Run(*snapshot_load_error_);
+    return;
+  }
+  size_t bytes = 0;
+  for (const auto& [key, value] : entries) {
+    // Subtraction checks avoid overflow even for malformed oversized input.
+    if (key.size() > max_size_ - bytes ||
+        value.size() > max_size_ - bytes - key.size()) {
+      std::move(guarded).Run(DbStatus::InvalidArgument(
+          "Storage restoration exceeds the area quota"));
+      return;
+    }
+    bytes += key.size() + value.size();
+  }
+  if (IsMapLoadedAndEmpty()) {
+    map_state_ = MapState::LOADED_KEYS_AND_VALUES;
+  } else if (map_state_ != MapState::LOADED_KEYS_AND_VALUES) {
+    LoadMap(OnLoadCompleteTask(
+        base::BindOnce(&StorageAreaImpl::RestoreEmptySnapshot,
+                       weak_ptr_factory_.GetWeakPtr(), std::move(entries),
+                       std::move(guarded)), AccessMode::ReadWrite));
+    return;
+  }
+  if (!keys_values_map_.empty() || !keys_only_map_.empty()) {
+    std::move(guarded).Run(DbStatus::InvalidArgument(
+        "Storage restoration requires an empty area"));
+    return;
+  }
+  if (database_ && !entries.empty()) {
+    CreateCommitBatchIfNeeded();
+    for (const auto& [key, value] : entries)
+      commit_batch_->changed_keys.insert(key);
+  }
+  keys_values_map_ = std::move(entries);
+  storage_used_ = bytes;
+  memory_used_ = bytes;
+  std::move(guarded).Run(DbStatus::OK());
+}
