+std::string PageHandler::RetainFrontcapStreamReport(
+    RenderFrameHostImpl* frame, int64_t unix_time_us,
+    const std::u16string& payload) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen))
+    return {};
+  auto* contents = static_cast<WebContentsImpl*>(WebContents::FromRenderFrameHost(frame));
+  auto* state = DialogState(contents, true);
+  if (!state) return {};
+  auto id = base::UnguessableToken::Create().ToString();
+  state->stream_reports.push_back({id, frame->devtools_frame_token().ToString(),
+      frame->GetDocumentToken().ToString(), base::NumberToString(unix_time_us),
+      base::UTF16ToUTF8(payload)});
+  return id;
+}
