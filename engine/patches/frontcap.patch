+
+void Proxy::FrontcapQueryMainFrameWanted(
+    base::OnceCallback<void(bool)> done) {
+  std::move(done).Run(false);
+}
+
+void ProxyMain::FrontcapQueryMainFrameWanted(
+    base::OnceCallback<void(bool)> done) {
+  DCHECK(IsMainThread());
+  if (!proxy_impl_) {
+    std::move(done).Run(false);
+    return;
+  }
+  // frontcap engine patch 10: this thread's clock is the page's (virtual).
+  ImplThreadTaskRunner()->PostTask(
+      FROM_HERE, base::BindOnce(&ProxyImpl::FrontcapQueryMainFrameWantedOnImpl,
+                                base::Unretained(proxy_impl_.get()),
+                                std::move(done), base::TimeTicks::Now()));
+}
+
+void ProxyMain::FrontcapUngateMainFrames() {
+  DCHECK(IsMainThread());
+  if (!proxy_impl_)
+    return;
+  ImplThreadTaskRunner()->PostTask(
+      FROM_HERE, base::BindOnce(&ProxyImpl::FrontcapUngateOnImpl,
+                                base::Unretained(proxy_impl_.get())));
+}
+
+void ProxyMain::FrontcapRunOneMainFrame(
+    base::OnceCallback<void(bool, bool, uint32_t, std::optional<base::TimeTicks>)> done) {
+  DCHECK(IsMainThread());
+  if (!proxy_impl_) {
+    std::move(done).Run(false, false, 0u, std::nullopt);
+    return;
+  }
+  // After any main-frame request this thread has posted: the impl thread sees
+  // it before this. This thread's clock is the page's (engine patch 10).
+  ImplThreadTaskRunner()->PostTask(
+      FROM_HERE, base::BindOnce(&ProxyImpl::FrontcapRunOneMainFrameOnImpl,
+                                base::Unretained(proxy_impl_.get()),
+                                std::move(done), base::TimeTicks::Now()));
+}
