+bool ProcessTimeOverrideCoordinator::FrontcapPrepareSharedClock(
+    base::ReadOnlySharedMemoryRegion time, base::UnsafeSharedMemoryRegion control,
+    uint32_t slot, uint64_t participant) {
+  if (!time.IsValid() || !control.IsValid()) return false;
+  auto time_mapping = time.Map();
+  auto control_mapping = control.Map();
+  if (!time_mapping.IsValid() || time_mapping.size() != sizeof(std::atomic<int64_t>) ||
+      !control_mapping.IsValid() || control_mapping.size() != sizeof(frontcap::SharedControl))
+    return false;
+  auto& state = *static_cast<frontcap::SharedControl*>(control_mapping.memory());
+  const auto& guid = time.GetGUID();
+  const frontcap::Scope scope{guid.GetHighForSerialization(), guid.GetLowForSerialization()};
+  // The view is read-only here; only the browser authority can publish time.
+  if (state.scope != scope || slot >= frontcap::kCapacity || !participant ||
+      state.participants[slot].identity.load(std::memory_order_acquire) != participant ||
+      state.failed.load(std::memory_order_acquire)) return false;
+  auto& self = Instance();
+  base::AutoLock lock(self.lock_);
+  if (!self.clock_override_) return false;
+  const auto ticks = self.FrontcapVirtualTicks();
+  const int64_t now = (self.initial_time_ + (ticks - self.initial_ticks_) -
+      base::Time::UnixEpoch()).InMicroseconds();
+  if (static_cast<const std::atomic<int64_t>*>(time_mapping.memory())->load(
+          std::memory_order_acquire) != now) return false;
+  if (self.frontcap_shared_time_mapping_.IsValid()) {
+    return self.frontcap_shared_time_guid_ == guid &&
+        self.frontcap_shared_participant_ == participant && self.frontcap_shared_slot_ == slot;
+  }
+  // Preparation is accepted only on a controlled page's main thread.
+  self.frontcap_main_owner_ = base::PlatformThread::CurrentRef();
+  self.frontcap_shared_time_region_ = std::move(time);
+  self.frontcap_shared_time_guid_ = guid;
+  self.frontcap_shared_participant_ = participant;
+  self.frontcap_shared_slot_ = slot;
+  self.frontcap_shared_time_mapping_ = std::move(time_mapping);
+  self.frontcap_shared_control_mapping_ = std::move(control_mapping);
+  return true;
