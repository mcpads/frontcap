@@ -0,0 +1,70 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_BUCKETS_FRONTCAP_STORAGE_SCOPE_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_BUCKETS_FRONTCAP_STORAGE_SCOPE_H_
+
+#include <optional>
+#include "third_party/blink/public/mojom/cache_storage/cache_storage.mojom-blink.h"
+#include "third_party/blink/public/mojom/indexeddb/indexeddb.mojom-blink.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/platform/heap/collection_support/heap_hash_map.h"
+#include "third_party/blink/renderer/platform/mojo/heap_mojo_remote.h"
+#include "third_party/blink/renderer/platform/supplementable.h"
+#include "third_party/blink/renderer/platform/wtf/text/strcat.h"
+
+namespace blink {
+
+// Native inspector connections only. Neither this object nor its registry is
+// exposed to script; the browser authorizes each pair with a one-use capability.
+class FrontcapStorageScope final : public GarbageCollected<FrontcapStorageScope> {
+ public:
+  explicit FrontcapStorageScope(ExecutionContext* context)
+      : indexed_db(context), caches(context) {}
+  void Close() { indexed_db.reset(); caches.reset(); }
+  void Trace(Visitor* visitor) const {
+    visitor->Trace(indexed_db);
+    visitor->Trace(caches);
+  }
+  HeapMojoRemote<mojom::blink::IDBFactory> indexed_db;
+  HeapMojoRemote<mojom::blink::CacheStorage> caches;
+};
+
+class FrontcapStorageScopes final : public GarbageCollected<FrontcapStorageScopes>,
+                                   public Supplement<ExecutionContext> {
+ public:
+  static constexpr char kSupplementName[] = "FrontcapStorageScopes";
+  explicit FrontcapStorageScopes(ExecutionContext& context)
+      : Supplement<ExecutionContext>(context) {}
+  static FrontcapStorageScopes& From(ExecutionContext& context) {
+    auto* result = Supplement<ExecutionContext>::From<FrontcapStorageScopes>(context);
+    if (!result) {
+      result = MakeGarbageCollected<FrontcapStorageScopes>(context);
+      Supplement<ExecutionContext>::ProvideTo(context, result);
+    }
+    return *result;
+  }
+  static String Key(const String& key, const std::optional<String>& bucket) {
+    return StrCat({key, "|", bucket.value_or("")});
+  }
+  FrontcapStorageScope* Find(const String& key, const std::optional<String>& bucket) const {
+    auto it = scopes.find(Key(key, bucket));
+    return it == scopes.end() ? nullptr : it->value.Get();
+  }
+  void Release(const String& key, const std::optional<String>& bucket) {
+    const String identity = Key(key, bucket);
+    auto it = scopes.find(identity);
+    if (it != scopes.end()) {
+      it->value->Close();
+      scopes.erase(it);
+    }
+  }
+  void Trace(Visitor* visitor) const override {
+    visitor->Trace(scopes);
+    Supplement<ExecutionContext>::Trace(visitor);
+  }
+  HeapHashMap<String, Member<FrontcapStorageScope>> scopes;
+};
+
+}  // namespace blink
+#endif
