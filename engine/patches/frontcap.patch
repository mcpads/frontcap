+      database_callbacks_;
+  HeapMojoAssociatedRemote<mojom::blink::IDBDatabase> database_;
+  HeapMojoAssociatedRemote<mojom::blink::IDBTransaction> transaction_;
+  String failure_;
+  size_t pending_puts_ = 0;
+  size_t pending_reads_ = 0;
+  bool reading_ = false;
+  bool read_commit_sent_ = false;
+  bool upgrading_ = false;
+  bool commit_sent_ = false;
+  bool committed_ = false;
