+namespace {
+// frontcap engine patch 12.
+BASE_FEATURE(kFrontcapFramesAfterWorkers, base::FEATURE_DISABLED_BY_DEFAULT);
+}  // namespace
+
+// A frame comes after the tasks of this instant (engine patch 6), the tasks due now on the threads joined
+// to this one's virtual time among them: a dedicated worker's timer at the frame's tick posts to the page
+// before the frame, however its thread was scheduled, and what it posts after virtual time paused at this
+// instant is let past the pause's fences (with every other task posted since the pause: they are this
+// instant's). The other threads are read first: an idle one seen with nothing due has already posted what
+// its last task posts (it asks for time after its task), so moving the fences then lets that in. A thread
+// stalled (idle while its own fetch is pending, or in a synchronous load) is not waited for. While only
+// another thread has work, this one sleeps between checks. Native atomic waits
+// release their vote until notification or their virtual deadline; computing
+// workers retain theirs, without a host-time cutoff.
+bool InspectorEmulationAgent::FrontcapWaitsForWork(int deferrals,
+                                                   bool* cut_off) {
+  constexpr int kMaxDeferrals = 1000;
+  *cut_off = false;
+  if (!base::FeatureList::IsEnabled(kFrontcapFramesAfterWorkers)) {
+    return deferrals < kMaxDeferrals &&
+           virtual_time_controller_->FrontcapTaskCanRunNow();
+  }
+  const bool others_due = virtual_time_controller_->FrontcapOtherThreadsDue();
+  virtual_time_controller_->FrontcapAdmitTasksOfThisInstant();
+  if (deferrals < kMaxDeferrals &&
+      virtual_time_controller_->FrontcapTaskCanRunNow()) {
+    return true;
+  }
+  if (others_due) {
+    base::PlatformThread::Sleep(base::Milliseconds(1));
+    return true;
+  }
+  return false;
+}
+
+void InspectorEmulationAgent::FrontcapQueryWantedWhenIdle(
+    std::unique_ptr<IsMainFrameWantedCallback> callback,
+    int deferrals) {
+  constexpr int kMaxDeferrals = 1000;
+  if (deferrals < kMaxDeferrals &&
+      virtual_time_controller_->FrontcapTaskCanRunNow()) {
+    virtual_time_controller_->FrontcapPostAfterReadyTasks(
+        BindOnce(&InspectorEmulationAgent::FrontcapQueryWantedWhenIdle,
+                 WrapWeakPersistent(this), std::move(callback),
+                 deferrals + 1));
+    return;
+  }
+  // frontcap engine patch 12: work of this instant a frame would run first (behind the pause's fences, or
+  // due on another thread) may ask for one: wanted, without running it here.
+  if (base::FeatureList::IsEnabled(kFrontcapFramesAfterWorkers) &&
+      (virtual_time_controller_->FrontcapHasTasksOfThisInstant() ||
+       virtual_time_controller_->FrontcapOtherThreadsDue())) {
+    callback->sendSuccess(true);
+    return;
+  }
+  WebFrameWidgetImpl* widget =
+      web_local_frame_ ? web_local_frame_->LocalRootFrameWidget() : nullptr;
+  if (!widget) {
+    callback->sendFailure(protocol::Response::ServerError("No frame widget"));
+    return;
+  }
+  auto answer = BindOnce(
+      [](WeakPersistent<InspectorEmulationAgent> agent,
+         std::unique_ptr<IsMainFrameWantedCallback> callback,
+         bool accepted, bool worker_wanted) {
+        if (!agent || !accepted || !agent->web_local_frame_ ||
+            !agent->web_local_frame_->LocalRootFrameWidget()) {
+          callback->sendFailure(protocol::Response::ServerError(
+              "Owned worker frame demand is unavailable"));
+          return;
+        }
+        agent->web_local_frame_->LocalRootFrameWidget()->FrontcapQueryMainFrameWanted(
+            base::BindPostTask(
+                agent->web_local_frame_->GetTaskRunner(TaskType::kInternalInspector),
+                BindOnce([](std::unique_ptr<IsMainFrameWantedCallback> callback,
+                            bool worker_wanted, bool wanted) {
+                  callback->sendSuccess(wanted || worker_wanted);
+                }, std::move(callback), worker_wanted)));
+      }, WrapWeakPersistent(this), std::move(callback));
+  if (base::FeatureList::IsEnabled(features::kFrontcapVirtualWorkers) &&
+      base::FeatureList::IsEnabled(features::kFrontcapFramesWhileFrozen)) {
+    web_local_frame_->GetFrame()->GetLocalFrameHostRemote().FrontcapOwnedWorkerFrames(
+        false, (base::Time::Now() - base::Time::UnixEpoch()).InMicroseconds(), 0, std::nullopt, String(""),
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(answer), false, false));
+  } else {
+    std::move(answer).Run(true, false);
+  }
+}
+
+// The frame renders after the tasks of this instant: this command arrives on a queue ahead of the page's,
+// so while any task can run it goes behind them (at the lowest priority), up to a bound for a page that
+// keeps posting.
+void InspectorEmulationAgent::FrontcapRunMainFrameWhenIdle(
+    std::unique_ptr<RunMainFrameCallback> callback,
+    int deferrals, bool workers_dispatched, bool worker_wanted) {
+  bool cut_off = false;
+  if (FrontcapWaitsForWork(deferrals, &cut_off)) {
+    virtual_time_controller_->FrontcapPostAfterReadyTasks(
+        BindOnce(&InspectorEmulationAgent::FrontcapRunMainFrameWhenIdle,
+                 WrapWeakPersistent(this), std::move(callback),
+                 std::min(deferrals + 1, 1000), workers_dispatched, worker_wanted));
+    return;
+  }
+  if (base::FeatureList::IsEnabled(kFrontcapFramesAfterWorkers) &&
+      virtual_time_controller_->FrontcapHasPendingResources()) {
+    // Wait for counted resource loads, then recheck ready work. Generic pausers
+    // such as WorkerStart can depend on a script frontcap will deliver at a
+    // future instant; they must not prevent this instant from rendering.
