+Response FetchHandler::FrontcapInspectNavigation(const String& request_id) {
+  if (!controlled_ || !interceptor_ ||
+      !interceptor_->InspectNavigation(request_id))
+    return Response::InvalidParams("request is not a retained navigation pause");
