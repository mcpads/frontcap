+void SessionStorageImpl::GetSnapshot(
+    const std::vector<std::string>& namespace_ids,
+    GetSnapshotCallback callback) {
+  ReadSnapshot(namespace_ids, base::BindOnce(
+      [](GetSnapshotCallback callback, StatusOr<Snapshot> snapshot) {
+        if (!snapshot.has_value()) {
+          std::move(callback).Run(mojom::SessionStorageSnapshotResult::NewError(
+              snapshot.error().ToString()));
+          return;
+        }
+        std::vector<mojom::SessionStorageNamespaceSnapshotPtr> namespaces;
+        for (const auto& [id, values_by_key] : *snapshot) {
+          std::vector<mojom::DomStorageAreaSnapshotPtr> areas;
+          for (const auto& [key, values] : values_by_key) {
+            std::vector<blink::mojom::KeyValuePtr> entries;
+            for (const auto& [name, value] : values)
+              entries.push_back(blink::mojom::KeyValue::New(name, value));
+            areas.push_back(mojom::DomStorageAreaSnapshot::New(key, std::move(entries)));
+          }
+          namespaces.push_back(mojom::SessionStorageNamespaceSnapshot::New(
+              id, std::move(areas)));
+        }
+        std::move(callback).Run(
+            mojom::SessionStorageSnapshotResult::NewNamespaces(std::move(namespaces)));
+      }, std::move(callback)));
+}
+
+void SessionStorageImpl::ReadSnapshot(
+    const std::vector<std::string>& namespace_ids,
+    SnapshotCallback callback) {
+  if (namespace_ids.empty()) {
+    std::move(callback).Run(Snapshot());
+    return;
+  }
+  auto guarded = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      std::move(callback), StatusOr<Snapshot>(base::unexpected(
+                               DbStatus::IOError("Session snapshot interrupted"))));
+  RunWhenConnected(base::BindOnce(&SessionStorageImpl::ReadSnapshotConnected,
+                                  weak_ptr_factory_.GetWeakPtr(), namespace_ids,
+                                  std::move(guarded)));
+}
+
+void SessionStorageImpl::ReadSnapshotConnected(
+    std::vector<std::string> namespace_ids,
+    SnapshotCallback callback) {
+  if (snapshot_inventory_error_) {
+    std::move(callback).Run(base::unexpected(*snapshot_inventory_error_));
+    return;
+  }
+  if (!database_) {
+    std::move(callback).Run(base::unexpected(
+        DbStatus::IOError("Session storage inventory unavailable")));
+    return;
+  }
+  std::set<std::string> seen;
+  for (const auto& id : namespace_ids) {
+    if (!seen.insert(id).second) {
+      std::move(callback).Run(base::unexpected(
+          DbStatus::InvalidArgument("Duplicate session namespace")));
+      return;
+    }
+    if (!namespaces_.contains(id)) {
+      std::move(callback).Run(base::unexpected(
+          DbStatus::NotFound("Requested session namespace is absent")));
+      return;
+    }
+  }
+  using Namespace = std::pair<std::string, SessionStorageNamespaceImpl::Snapshot>;
+  auto complete = base::BarrierCallback<StatusOr<Namespace>>(
+      namespace_ids.size(), base::BindOnce(
+          [](base::WeakPtr<SessionStorageImpl> self, SnapshotCallback callback,
+             std::vector<StatusOr<Namespace>> namespaces) {
+            if (!self) {
+              std::move(callback).Run(base::unexpected(
+                  DbStatus::IOError("Session storage disconnected")));
+              return;
+            }
+            if (self->snapshot_inventory_error_) {
+              std::move(callback).Run(base::unexpected(*self->snapshot_inventory_error_));
+              return;
+            }
+            Snapshot snapshot;
+            for (auto& ns : namespaces) {
+              if (!ns.has_value()) {
+                std::move(callback).Run(base::unexpected(ns.error()));
+                return;
+              }
+              snapshot.emplace(std::move(ns->first), std::move(ns->second));
+            }
+            std::move(callback).Run(std::move(snapshot));
+          }, weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+  const auto& metadata = metadata_.namespace_storage_key_map();
+  const SessionStorageNamespaceImpl::SnapshotMaps empty;
+  for (const auto& id : namespace_ids) {
+    auto read = base::BindOnce(
+        [](std::string id,
+           base::RepeatingCallback<void(StatusOr<Namespace>)> complete,
+           StatusOr<SessionStorageNamespaceImpl::Snapshot> snapshot) {
+          if (!snapshot.has_value()) {
+            complete.Run(base::unexpected(snapshot.error()));
+            return;
+          }
+          complete.Run(Namespace(std::move(id), std::move(*snapshot)));
+        }, id, complete);
+    auto entry = metadata.find(id);
+    namespaces_.at(id)->ReadSnapshot(database_.get(), std::move(read),
+        entry == metadata.end() ? empty : entry->second);
+  }
+}
