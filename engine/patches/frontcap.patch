+void StorageHandler::FrontcapReadDOMStorage(
+    std::unique_ptr<FrontcapReadDOMStorageCallback> callback) {
+  if (!base::FeatureList::IsEnabled(blink::features::kFrontcapFramesWhileFrozen) ||
+      !frame_host_ || !storage_partition_) {
+    callback->sendFailure(Response::ServerError("Expected a controlled document target"));
+    return;
+  }
+  // Every write the partition's renderers issued reaches the storage service
+  // first, those of renderers that have since left included.
+  static_cast<StoragePartitionImpl*>(storage_partition_.get())
+      ->FrontcapWaitForDomStorageWrites(base::BindOnce(
+          [](base::WeakPtr<StorageHandler> owner, GlobalRenderFrameHostId frame_id,
+             std::string document,
+             std::unique_ptr<FrontcapReadDOMStorageCallback> callback,
+             std::optional<std::string> error) {
+            if (error) {
+              callback->sendFailure(Response::ServerError(*error));
+              return;
+            }
+            if (!owner || !owner->frame_host_ || !owner->storage_partition_ ||
+                owner->frame_host_->GetGlobalId() != frame_id ||
+                owner->frame_host_->GetDocumentToken().ToString() != document) {
+              callback->sendFailure(Response::ServerError("Storage target changed"));
+              return;
+            }
+            owner->FrontcapSnapshotDOMStorage(std::move(callback));
+          },
+          weak_ptr_factory_.GetWeakPtr(), frame_host_->GetGlobalId(),
+          frame_host_->GetDocumentToken().ToString(), std::move(callback)));
+}
+
+void StorageHandler::FrontcapSnapshotDOMStorage(
+    std::unique_ptr<FrontcapReadDOMStorageCallback> callback) {
+  auto* contents = WebContents::FromRenderFrameHost(frame_host_);
+  if (!contents || frame_host_->GetParentOrOuterDocument()) {
+    callback->sendFailure(Response::ServerError("Expected a top-level document target"));
+    return;
+  }
+  auto* context = static_cast<DOMStorageContextWrapper*>(
+      storage_partition_->GetDOMStorageContext());
+  if (!context || !context->HasStorageControls()) {
+    callback->sendFailure(Response::ServerError("DOM storage service is unavailable"));
+    return;
+  }
+  std::optional<std::string> namespace_id;
+  const auto& namespaces = contents->GetController().GetSessionStorageNamespaceMap();
+  auto ns = namespaces.find(storage_partition_->GetConfig());
+  if (ns != namespaces.end())
+    namespace_id = ns->second->id();
+  std::optional<std::string> opener_frame_id;
+  if (auto* opener = contents->GetOpener())
+    opener_frame_id = opener->GetDevToolsFrameToken().ToString();
+  auto captured = std::make_shared<DOMStorageCapture>();
+  auto done = base::BarrierClosure(2, base::BindOnce(
+      [](base::WeakPtr<StorageHandler> owner, GlobalRenderFrameHostId frame_id,
+         std::string document, std::optional<std::string> namespace_id,
+         std::string window_name, std::string url,
+         std::optional<std::string> opener_frame_id,
+         std::shared_ptr<DOMStorageCapture> captured,
+         std::unique_ptr<FrontcapReadDOMStorageCallback> callback) {
+        if (!owner || !owner->frame_host_ || !owner->storage_partition_ ||
+            owner->frame_host_->GetGlobalId() != frame_id ||
+            owner->frame_host_->GetDocumentToken().ToString() != document) {
+          callback->sendFailure(Response::ServerError("Storage target changed"));
+          return;
+        }
+        auto* contents = WebContents::FromRenderFrameHost(owner->frame_host_);
+        std::optional<std::string> current_namespace;
+        std::optional<std::string> current_opener;
+        if (contents) {
+          if (auto* opener = contents->GetOpener())
+            current_opener = opener->GetDevToolsFrameToken().ToString();
+          const auto& namespaces = contents->GetController().GetSessionStorageNamespaceMap();
+          auto ns = namespaces.find(owner->storage_partition_->GetConfig());
+          if (ns != namespaces.end())
+            current_namespace = ns->second->id();
+        }
+        if (!contents || current_namespace != namespace_id ||
+            owner->frame_host_->GetFrameName() != window_name ||
+            owner->frame_host_->GetLastCommittedURL().spec() != url ||
+            current_opener != opener_frame_id ||
+            !captured->local || !captured->session) {
+          callback->sendFailure(Response::ServerError("DOM storage capture was interrupted"));
+          return;
+        }
+        if (captured->local->is_error() || captured->session->is_error()) {
+          callback->sendFailure(Response::ServerError(captured->local->is_error()
+              ? captured->local->get_error() : captured->session->get_error()));
+          return;
+        }
+        auto& sessions = captured->session->get_namespaces();
+        if ((namespace_id && (sessions.size() != 1 || sessions[0]->namespace_id != *namespace_id)) ||
+            (!namespace_id && !sessions.empty())) {
+          callback->sendFailure(Response::ServerError("Session namespace snapshot mismatch"));
+          return;
+        }
+        std::vector<storage::mojom::DomStorageAreaSnapshotPtr> session_areas;
+        if (namespace_id)
+          session_areas = std::move(sessions[0]->areas);
+        callback->sendSuccess(
+            BuildDOMStorageAreas(std::move(captured->local->get_areas())),
+            BuildDOMStorageAreas(std::move(session_areas)), std::move(namespace_id),
+            owner->frame_host_->GetDevToolsFrameToken().ToString(),
+            std::move(window_name), std::move(url), std::move(opener_frame_id));
+      }, weak_ptr_factory_.GetWeakPtr(), frame_host_->GetGlobalId(),
+      frame_host_->GetDocumentToken().ToString(), namespace_id,
+      frame_host_->GetFrameName(), frame_host_->GetLastCommittedURL().spec(),
+      opener_frame_id, captured, std::move(callback)));
+  context->GetLocalStorageControl()->GetSnapshot(
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(base::BindOnce(
+          [](std::shared_ptr<DOMStorageCapture> captured, base::RepeatingClosure done,
+             storage::mojom::LocalStorageSnapshotResultPtr result) {
+            captured->local = std::move(result);
+            done.Run();
+          }, captured, done), storage::mojom::LocalStorageSnapshotResultPtr()));
+  std::vector<std::string> requested;
+  if (namespace_id)
+    requested.push_back(*namespace_id);
+  context->GetSessionStorageControl()->GetSnapshot(requested,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(base::BindOnce(
+          [](std::shared_ptr<DOMStorageCapture> captured, base::RepeatingClosure done,
+             storage::mojom::SessionStorageSnapshotResultPtr result) {
+            captured->session = std::move(result);
+            done.Run();
+          }, captured, done), storage::mojom::SessionStorageSnapshotResultPtr()));
+}
+
+void StorageHandler::FrontcapReadStorageScopes(
+    std::unique_ptr<FrontcapReadStorageScopesCallback> callback) {
+  if (!base::FeatureList::IsEnabled(
+          blink::features::kFrontcapFramesWhileFrozen)) {
+    callback->sendFailure(
+        Response::ServerError("frontcap storage control is disabled"));
+    return;
+  }
+  if (!frame_host_ || !storage_partition_) {
+    callback->sendFailure(
+        Response::ServerError("Expected a live document target"));
+    return;
+  }
+  GetQuotaManagerProxy()->FrontcapGetAllBuckets(
+      base::SingleThreadTaskRunner::GetCurrentDefault(),
+      base::BindOnce(
+          [](base::WeakPtr<StorageHandler> owner,
+             GlobalRenderFrameHostId frame_id,
+             std::unique_ptr<FrontcapReadStorageScopesCallback> callback,
+             storage::QuotaErrorOr<std::set<storage::BucketInfo>> found) {
+            if (!owner || !owner->frame_host_ || !owner->storage_partition_ ||
+                owner->frame_host_->GetGlobalId() != frame_id) {
+              callback->sendFailure(
+                  Response::ServerError("Storage target changed"));
+              return;
+            }
+            if (!found.has_value()) {
+              callback->sendFailure(
+                  Response::ServerError("Storage partition inventory failed"));
+              return;
+            }
+            std::map<std::string, std::vector<const storage::BucketInfo*>>
+                grouped;
+            for (const auto& bucket : *found) {
+              grouped[bucket.storage_key.Serialize()].push_back(&bucket);
+            }
+            auto scopes =
+                std::make_unique<Array<Storage::FrontcapStorageScope>>();
+            for (auto& entry : grouped) {
+              auto key = entry.second.front()->storage_key;
+              scopes->push_back(
+                  BuildFrontcapStorageScope(key, std::move(entry.second)));
+            }
+            callback->sendSuccess(std::move(scopes));
+          },
+          weak_ptr_factory_.GetWeakPtr(), frame_host_->GetGlobalId(),
+          std::move(callback)));
+}
 
+void StorageHandler::FrontcapReadStorageScope(
+    const std::string& serialized_storage_key,
+    std::unique_ptr<FrontcapReadStorageScopeCallback> callback) {
+  if (!base::FeatureList::IsEnabled(
+          blink::features::kFrontcapFramesWhileFrozen)) {
+    callback->sendFailure(
+        Response::ServerError("frontcap storage control is disabled"));
+    return;
+  }
+  if (!frame_host_ || !storage_partition_) {
+    callback->sendFailure(
+        Response::ServerError("Expected a live document target"));
+    return;
+  }
+  auto key = blink::StorageKey::Deserialize(serialized_storage_key);
+  if (!key || key->Serialize() != serialized_storage_key) {
+    callback->sendFailure(
+        Response::InvalidParams("Expected a canonical storage key"));
+    return;
+  }
+  GetQuotaManagerProxy()->GetBucketsForStorageKey(
+      *key, /*delete_expired=*/false,
+      base::SingleThreadTaskRunner::GetCurrentDefault(),
+      base::BindOnce(
+          [](base::WeakPtr<StorageHandler> owner, blink::StorageKey key,
+             std::unique_ptr<FrontcapReadStorageScopeCallback> callback,
+             storage::QuotaErrorOr<std::set<storage::BucketInfo>> found) {
+            if (!owner || !owner->frame_host_ || !owner->storage_partition_) {
+              callback->sendFailure(
+                  Response::ServerError("Storage target disappeared"));
+              return;
+            }
+            if (!found.has_value()) {
+              callback->sendFailure(
+                  Response::ServerError("Storage bucket inventory failed"));
+              return;
+            }
+            std::vector<const storage::BucketInfo*> buckets;
+            for (const auto& bucket : found.value()) {
+              buckets.push_back(&bucket);
+            }
+            auto scope = BuildFrontcapStorageScope(key, std::move(buckets));
+            callback->sendSuccess(std::move(scope));
+          },
+          weak_ptr_factory_.GetWeakPtr(), *key, std::move(callback)));
+}
 
+void StorageHandler::FrontcapRestoreBucket(
+    const std::string& serialized_storage_key,
+    std::unique_ptr<Storage::FrontcapBucket> bucket,
+    std::unique_ptr<FrontcapRestoreBucketCallback> callback) {
+  if (!base::FeatureList::IsEnabled(
+          blink::features::kFrontcapFramesWhileFrozen)) {
+    callback->sendFailure(
+        Response::ServerError("frontcap storage control is disabled"));
+    return;
+  }
+  if (!frame_host_ || !storage_partition_) {
+    callback->sendFailure(
+        Response::ServerError("Expected a live document target"));
+    return;
+  }
+  auto key = blink::StorageKey::Deserialize(serialized_storage_key);
+  if (!key || key->Serialize() != serialized_storage_key) {
+    callback->sendFailure(
+        Response::InvalidParams("Expected a canonical storage key"));
+    return;
+  }
+  auto params = storage::BucketInitParams::ForDefaultBucket(*key);
+  if (bucket->HasName()) {
+    params.name = bucket->GetName("");
+    if (!IsValidBucketName(params.name)) {
+      callback->sendFailure(Response::InvalidParams("Invalid bucket name"));
+      return;
+    }
+  }
+  if (!base::StringToInt64(bucket->GetQuota(), &params.quota) ||
+      params.quota < 0 ||
+      base::NumberToString(params.quota) != bucket->GetQuota()) {
+    callback->sendFailure(
+        Response::InvalidParams("Expected canonical nonnegative quota bytes"));
+    return;
+  }
+  if (bucket->HasExpiration()) {
+    int64_t expiration;
+    const auto text = bucket->GetExpiration("");
+    if (!base::StringToInt64(text, &expiration) || expiration == 0 ||
+        base::NumberToString(expiration) != text) {
+      callback->sendFailure(Response::InvalidParams(
+          "Expected canonical nonzero native expiration"));
+      return;
+    }
+    params.expiration = base::Time::FromInternalValue(expiration);
+  }
+  params.persistent = bucket->GetPersistent();
+  const auto durability = bucket->GetDurability();
+  if (durability == Storage::StorageBucketsDurabilityEnum::Strict) {
+    params.durability = blink::mojom::BucketDurability::kStrict;
+  } else if (durability == Storage::StorageBucketsDurabilityEnum::Relaxed) {
+    params.durability = blink::mojom::BucketDurability::kRelaxed;
+  } else {
+    callback->sendFailure(Response::InvalidParams("Invalid bucket durability"));
+    return;
+  }
+  if (!bucket->HasName() &&
+      *params.durability != blink::mojom::BucketDurability::kRelaxed) {
+    callback->sendFailure(
+        Response::InvalidParams("Default bucket durability must be relaxed"));
+    return;
+  }
+  GetQuotaManagerProxy()->FrontcapRestoreBucket(
+      params, base::SingleThreadTaskRunner::GetCurrentDefault(),
+      base::BindOnce(
+          [](base::WeakPtr<StorageHandler> owner,
+             GlobalRenderFrameHostId frame_id,
+             std::unique_ptr<FrontcapRestoreBucketCallback> callback,
+             storage::QuotaErrorOr<storage::BucketInfo> result) {
+            if (!owner || !owner->frame_host_ || !owner->storage_partition_ ||
+                owner->frame_host_->GetGlobalId() != frame_id) {
+              callback->sendFailure(
+                  Response::ServerError("Storage target changed"));
+              return;
+            }
+            if (!result.has_value()) {
+              callback->sendFailure(Response::ServerError(
+                  result.error() == storage::QuotaError::kEntryExistsError
+                      ? "Existing bucket policy conflicts with saved policy"
+                      : "Storage bucket restoration failed"));
+              return;
+            }
+            callback->sendSuccess();
+          },
+          weak_ptr_factory_.GetWeakPtr(), frame_host_->GetGlobalId(),
+          std::move(callback)));
+}
 
