+void InspectorCacheStorageAgent::frontcapReadEntry(
+    const String& cache_id, const String& request_url,
+    std::unique_ptr<protocol::Array<Header>> headers,
+    std::unique_ptr<FrontcapReadEntryCallback> callback) {
+  auto request = CacheEntryRequest(request_url, *headers);
+  if (!request) {
+    callback->sendFailure(ProtocolResponse::InvalidParams("Invalid native cache request."));
+    return;
+  }
+  auto wrapped = RequestCallbackWrapper<FrontcapReadEntryCallback>::Wrap(std::move(callback));
+  String cache_name;
+  auto storage = GetCacheStorageRemoteForId(cache_id, cache_name, wrapped->GetFailureCallback());
+  if (!storage.has_value()) { wrapped->SendFailure(storage.error()); return; }
+  auto options = mojom::blink::MultiCacheQueryOptions::New();
+  options->query_options = mojom::blink::CacheQueryOptions::New();
+  options->cache_name = cache_name;
+  auto runner = frames_->Root()->GetTaskRunner(TaskType::kInternalInspector);
+  storage.value()->Match(std::move(request), std::move(options), false, false,
+      blink::cache_storage::CreateTraceId(), blink::BindOnce(
+      [](scoped_refptr<RequestCallbackWrapper<FrontcapReadEntryCallback>> wrapped,
+         scoped_refptr<base::SingleThreadTaskRunner> runner,
+         mojom::blink::CacheStorage::MatchResult result) {
+        if (!result.has_value()) {
+          if (CacheEntryAbsent(result.error())) wrapped->SendSuccess(nullptr);
+          else wrapped->SendFailure(ProtocolResponse::ServerError(CacheStorageErrorString(result.error())));
+          return;
+        }
+        auto& value = result.value()->get_response();
+        auto headers = std::make_unique<protocol::Array<Header>>();
+        for (const auto& field : value->headers)
+          headers->emplace_back(Header::create().setName(field.key).setValue(field.value).build());
+        auto urls = std::make_unique<protocol::Array<String>>();
+        for (const auto& url : value->url_list) urls->push_back(url.GetString());
+        auto response = protocol::CacheStorage::FrontcapResponse::create()
+            .setResponseStatus(value->status_code).setResponseStatusText(value->status_text)
+            .setResponseType(ResponseTypeToString(value->response_type))
+            .setResponseHeaders(std::move(headers)).setResponseURLs(std::move(urls))
+            .setBody(protocol::Binary()).setMetadata(ResponseMetadata(*value)).build();
+        if (!value->blob) { wrapped->SendSuccess(std::move(response)); return; }
+        if (value->blob->size() > 4 * 1024 * 1024) {
+          wrapped->SendFailure(ProtocolResponse::ServerError("Cache response body exceeds 4 MiB."));
+          return;
+        }
+        MakeGarbageCollected<CachedResponseFileReaderLoaderClient>(std::move(runner), std::move(value->blob),
+                                                  std::move(response), wrapped);
+      }, wrapped, std::move(runner)));
+}
+
+void InspectorCacheStorageAgent::frontcapDeleteEntry(
+    const String& cache_id, const String& request_url,
+    std::unique_ptr<protocol::Array<Header>> headers,
+    std::unique_ptr<FrontcapDeleteEntryCallback> callback) {
+  auto request = CacheEntryRequest(request_url, *headers);
+  if (!request) {
+    callback->sendFailure(ProtocolResponse::InvalidParams("Invalid native cache request."));
+    return;
+  }
+  auto wrapped = RequestCallbackWrapper<FrontcapDeleteEntryCallback>::Wrap(std::move(callback));
+  String cache_name;
+  auto storage = GetCacheStorageRemoteForId(cache_id, cache_name, wrapped->GetFailureCallback());
+  if (!storage.has_value()) { wrapped->SendFailure(storage.error()); return; }
+  int64_t trace_id = blink::cache_storage::CreateTraceId();
+  storage.value()->OpenExisting(cache_name, trace_id, blink::BindOnce(
+      [](mojom::blink::FetchAPIRequestPtr request, int64_t trace_id,
+         scoped_refptr<RequestCallbackWrapper<FrontcapDeleteEntryCallback>> wrapped,
+         mojom::blink::CacheStorage::OpenExistingResult result) {
+        if (!result.has_value()) {
+          if (CacheEntryAbsent(result.error())) wrapped->SendSuccess();
+          else wrapped->SendFailure(ProtocolResponse::ServerError(CacheStorageErrorString(result.error())));
+          return;
+        }
+        mojo::AssociatedRemote<mojom::blink::CacheStorageCache> remote;
+        remote.Bind(std::move(result.value()));
+        auto* cache = remote.get();
+        remote.set_disconnect_handler(blink::BindOnce(wrapped->GetFailureCallback(),
+            ProtocolResponse::ServerError("Cache delete connection closed; outcome unknown")));
+        auto operation = mojom::blink::BatchOperation::New();
+        operation->operation_type = mojom::blink::OperationType::kDelete;
+        operation->request = std::move(request);
+        operation->match_options = mojom::blink::CacheQueryOptions::New();
+        Vector<mojom::blink::BatchOperationPtr> operations;
+        operations.push_back(std::move(operation));
+        cache->Batch(std::move(operations), trace_id, blink::BindOnce(
+            [](mojo::AssociatedRemote<mojom::blink::CacheStorageCache> remote,
+               scoped_refptr<RequestCallbackWrapper<FrontcapDeleteEntryCallback>> wrapped,
+               mojom::blink::CacheStorageVerboseErrorPtr result) {
+              if (result->value == mojom::blink::CacheStorageError::kSuccess || CacheEntryAbsent(result->value))
+                wrapped->SendSuccess();
+              else wrapped->SendFailure(ProtocolResponse::ServerError(CacheStorageErrorString(result->value)));
+            }, std::move(remote), wrapped));
+      }, std::move(request), trace_id, wrapped));
+}
